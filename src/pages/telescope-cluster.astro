---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Telescope Web Cluster Lab | CUB Astronomical Society"
  description="Interactive 3D Telescope Web Cluster prototype inspired by OpenAI web clusters and the C>U Astronomical Society logo reference."
>
  <div class="relative w-screen h-screen overflow-hidden bg-[#020306]">
    <!-- Top Navigation Bar -->
    <header class="absolute top-0 inset-x-0 z-30 flex items-center justify-between px-6 py-4 border-b border-white/10 bg-black/60 backdrop-blur-xl">
      <div class="flex items-center gap-3">
        <a href="/" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/15 text-xs font-space-mono text-slate-300 hover:text-white transition flex items-center gap-1.5">
          <span>← Back to Portal</span>
        </a>
        <div>
          <span class="font-orbitron text-xs font-bold tracking-wider text-white uppercase block">TELESCOPE CLUSTER LAB</span>
          <span class="font-space-mono text-[9px] text-slate-400 block">OpenAI Cluster Dynamics × C>U Reference Constellation</span>
        </div>
      </div>

      <!-- Mode Switcher Controls -->
      <div class="flex items-center gap-2 bg-white/[0.04] p-1 rounded-xl border border-white/10">
        <button
          type="button"
          id="btn-mode-telescope"
          class="mode-btn active px-3.5 py-1.5 rounded-lg font-space-mono text-xs font-bold transition text-black bg-white shadow-sm"
        >
          🔭 Telescope 3D
        </button>
        <button
          type="button"
          id="btn-mode-dipper"
          class="mode-btn px-3.5 py-1.5 rounded-lg font-space-mono text-xs font-bold transition text-slate-300 hover:text-white"
        >
          ✨ Constellation (Ref)
        </button>
        <button
          type="button"
          id="btn-mode-neural"
          class="mode-btn px-3.5 py-1.5 rounded-lg font-space-mono text-xs font-bold transition text-slate-300 hover:text-white"
        >
          🧠 Neural Web
        </button>
        <button
          type="button"
          id="btn-fire-pulse"
          class="px-3.5 py-1.5 rounded-lg font-space-mono text-xs font-bold transition text-white bg-white/10 hover:bg-white/20 border border-white/20"
        >
          ⚡ Starlight Pulse
        </button>
      </div>

      <div class="hidden md:flex items-center gap-3 font-space-mono text-[11px] text-slate-400">
        <span>Drag to rotate 3D</span>
        <span>•</span>
        <span class="text-white">Hover stars for optics telemetry</span>
      </div>
    </header>

    <!-- Canvas Container -->
    <canvas id="cluster-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing"></canvas>

    <!-- Node Hover Tooltip -->
    <div id="node-tooltip" class="fixed pointer-events-none z-40 bg-black/90 border border-white/30 rounded-lg p-2.5 font-space-mono text-xs text-white shadow-2xl opacity-0 transition-opacity -translate-x-1/2 -translate-y-full">
      <div id="tt-title" class="font-bold text-white font-orbitron">Node</div>
      <div id="tt-desc" class="text-[10px] text-slate-400 mt-0.5">Details</div>
    </div>

    <!-- Bottom Telemetry HUD -->
    <div class="absolute bottom-6 inset-x-6 z-20 flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 pointer-events-none">
      <div class="p-4 rounded-xl bg-black/70 border border-white/10 backdrop-blur-xl font-space-mono text-xs text-slate-300 pointer-events-auto max-w-sm">
        <div class="text-[10px] text-slate-500 uppercase tracking-wider mb-1">Architecture Alignment</div>
        <div class="font-bold text-white font-orbitron text-sm">Constructor University Bremen</div>
        <div class="text-[11px] text-slate-400 mt-1">
          Directly derived from <strong class="text-white font-mono">reference.jpg</strong>. The 7 constellation stars form the optical mount and tube assembly pointing at celestial objects.
        </div>
      </div>

      <div class="p-4 rounded-xl bg-black/70 border border-white/10 backdrop-blur-xl font-space-mono text-xs text-slate-300 pointer-events-auto text-right">
        <div class="text-[10px] text-slate-500 uppercase tracking-wider mb-1">Optics Telemetry</div>
        <div class="font-bold text-white font-orbitron text-sm">Sky-Watcher 8" Dobsonian</div>
        <div class="text-[11px] text-slate-400 mt-1">
          200mm Aperture • 1200mm Focal Length • f/6 Parabolic
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // --- Interactive Web Cluster Engine ---
  const canvas = document.getElementById("cluster-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d");
  const tooltip = document.getElementById("node-tooltip");
  const ttTitle = document.getElementById("tt-title");
  const ttDesc = document.getElementById("tt-desc");

  if (canvas && ctx) {
    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener("resize", () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    const nodeDefinitions = [
      // 1. Aperture Rim - Top Front (Pointer tip in reference: 581, 301)
      { id: 'aperture_top', label: 'Aperture Front Lens', desc: 'Light intake aperture • 200mm (8")',
        posTelescope: [180, -180, 40],
        posDipper: [220, -170, 0],
        posNeural: [160, -150, 60]
      },
      // 2. Aperture Rim - Bottom Front
      { id: 'aperture_bot', label: 'Aperture Baffle', desc: 'Front anti-reflective ring',
        posTelescope: [210, -130, -40],
        posDipper: [160, -100, 20],
        posNeural: [190, -90, -40]
      },
      // 3. Secondary Spider Mount (Pointer mid in reference: 476, 363)
      { id: 'secondary_spider', label: 'Secondary Mirror Spider', desc: '4-vane diffraction spike mount',
        posTelescope: [100, -90, 0],
        posDipper: [90, -90, 0],
        posNeural: [80, -80, 50]
      },
      // 4. Eyepiece & Focuser (Pointer lower in reference: 430, 425)
      { id: 'eyepiece', label: 'Crayford Eyepiece Focuser', desc: 'Dual-speed 2" optical focuser',
        posTelescope: [60, -150, 70],
        posDipper: [40, -20, 30],
        posNeural: [30, -130, 90]
      },
      // 5. Optical Tube Center Ring (Junction in reference: 374, 530)
      { id: 'tube_center', label: 'Tube Ring Pivot', desc: 'Altitude bearing pivot joint',
        posTelescope: [0, 0, 0],
        posDipper: [-20, 60, 0],
        posNeural: [0, 0, 0]
      },
      // 6. Finderscope
      { id: 'finderscope', label: '9x50 Optical Finderscope', desc: 'Acrobat target acquisition guide',
        posTelescope: [40, -60, 80],
        posDipper: [10, -50, 60],
        posNeural: [50, -40, 80]
      },
      // 7. Primary Mirror Cell (reference bowl bottom-right: 378, 625)
      { id: 'primary_cell', label: 'Primary Mirror Cell', desc: 'Parabolic Pyrex mirror cell',
        posTelescope: [-120, 100, -20],
        posDipper: [-10, 150, -20],
        posNeural: [-100, 90, -40]
      },
      // 8. Mirror Base Support (reference bowl bottom-left: 228, 734)
      { id: 'mount_base', label: 'Dobsonian Rocker Base', desc: 'Smooth Teflon azimuth rotation base',
        posTelescope: [-140, 170, 0],
        posDipper: [-160, 230, 0],
        posNeural: [-130, 160, 30]
      },
      // 9. Mount Alt-Bearing (reference bowl top-left: 195, 668)
      { id: 'mount_alt', label: 'Altitude Trunnion', desc: 'Equatorial balanced axis',
        posTelescope: [-60, 120, 30],
        posDipper: [-180, 160, 20],
        posNeural: [-70, 120, 60]
      },
      // 10. Tripod Leg Left
      { id: 'tripod_left', label: 'Stainless Tripod Foot 1', desc: 'Ground vibration dampener',
        posTelescope: [-230, 280, 100],
        posDipper: [-210, 260, 50],
        posNeural: [-200, 240, 80]
      },
      // 11. Tripod Leg Right
      { id: 'tripod_right', label: 'Stainless Tripod Foot 2', desc: 'Ground vibration dampener',
        posTelescope: [-150, 290, -120],
        posDipper: [-120, 250, -60],
        posNeural: [-140, 260, -90]
      },
      // 12. Tripod Leg Center
      { id: 'tripod_center', label: 'Stainless Tripod Foot 3', desc: 'Ground vibration dampener',
        posTelescope: [-60, 270, 50],
        posDipper: [-70, 220, 20],
        posNeural: [-50, 240, 40]
      }
    ];

    const edgeConnections = [
      [0, 1], [0, 2], [1, 2], [2, 4], [2, 5], [4, 5], [0, 5], [1, 5],
      [2, 3], [4, 3], [5, 3],
      [4, 6], [5, 6], [1, 6],
      [6, 7], [6, 8], [7, 8], [4, 8],
      [7, 9], [7, 10], [7, 11], [8, 9], [8, 11]
    ];

    const referenceEdges = [
      [0, 2], [2, 3], [3, 4],
      [4, 6], [6, 7], [7, 8], [8, 4]
    ];

    let currentMode = 'telescope';
    const nodes = nodeDefinitions.map((def, idx) => ({
      ...def,
      x: def.posTelescope[0],
      y: def.posTelescope[1],
      z: def.posTelescope[2],
      targetX: def.posTelescope[0],
      targetY: def.posTelescope[1],
      targetZ: def.posTelescope[2],
      vx: 0,
      vy: 0,
      vz: 0,
      radius: idx === 0 ? 8 : (idx < 5 ? 6 : 5),
      screenX: 0,
      screenY: 0,
      screenScale: 1,
      depthZ: 0,
      isHovered: false,
      pulse: 0
    }));

    function setMode(mode: string) {
      currentMode = mode;
      document.querySelectorAll('.mode-btn').forEach(b => {
        b.classList.remove('active', 'bg-white', 'text-black');
        b.classList.add('text-slate-300');
      });
      const activeBtn = document.getElementById(`btn-mode-${mode}`);
      if (activeBtn) {
        activeBtn.classList.add('active', 'bg-white', 'text-black');
        activeBtn.classList.remove('text-slate-300');
      }

      nodes.forEach(n => {
        let p = n.posTelescope;
        if (mode === 'dipper') p = n.posDipper;
        if (mode === 'neural') p = n.posNeural;
        n.targetX = p[0];
        n.targetY = p[1];
        n.targetZ = p[2];
      });

      window.dispatchEvent(new CustomEvent("cosmic-click"));
    }

    document.getElementById('btn-mode-telescope')?.addEventListener('click', () => setMode('telescope'));
    document.getElementById('btn-mode-dipper')?.addEventListener('click', () => setMode('dipper'));
    document.getElementById('btn-mode-neural')?.addEventListener('click', () => setMode('neural'));

    const activePulses: any[] = [];
    function firePulse() {
      const edges = currentMode === 'dipper' ? referenceEdges : edgeConnections;
      edges.forEach((edge, idx) => {
        setTimeout(() => {
          activePulses.push({
            startIdx: edge[0],
            endIdx: edge[1],
            progress: 0,
            speed: 0.025 + Math.random() * 0.015
          });
        }, idx * 30);
      });
      window.dispatchEvent(new CustomEvent("cosmic-nebula-spawn"));
    }
    document.getElementById('btn-fire-pulse')?.addEventListener('click', firePulse);

    let rotX = 0.15;
    let rotY = -0.3;
    let targetRotX = 0.15;
    let targetRotY = -0.3;
    let isDragging = false;
    let lastMouseX = 0;
    let lastMouseY = 0;
    let mouseX = -1000;
    let mouseY = -1000;

    canvas.addEventListener('mousedown', (e) => {
      isDragging = true;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (isDragging) {
        const dx = e.clientX - lastMouseX;
        const dy = e.clientY - lastMouseY;
        targetRotY += dx * 0.005;
        targetRotX += dy * 0.005;
        lastMouseX = e.clientX;
        lastMouseY = e.clientY;
      }
    });

    function project3D(x: number, y: number, z: number, cx: number, cy: number) {
      const cosY = Math.cos(rotY);
      const sinY = Math.sin(rotY);
      const x1 = x * cosY + z * sinY;
      const z1 = -x * sinY + z * cosY;

      const cosX = Math.cos(rotX);
      const sinX = Math.sin(rotX);
      const y2 = y * cosX - z1 * sinX;
      const z2 = y * sinX + z1 * cosX;

      const cameraDistance = 650;
      const fov = 500;
      const depth = cameraDistance + z2;
      const scale = depth > 0 ? fov / depth : 0;

      return {
        screenX: cx + x1 * scale,
        screenY: cy + y2 * scale,
        scale: scale,
        z: z2
      };
    }

    function render() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      const centerX = width * 0.5;
      const centerY = height * 0.5;

      rotX += (targetRotX - rotX) * 0.08;
      rotY += (targetRotY - rotY) * 0.08;
      if (!isDragging) {
        targetRotY += 0.0008;
      }

      let hoveredNode: any = null;
      nodes.forEach((node, i) => {
        const k = 0.08;
        const damp = 0.82;
        const fx = (node.targetX - node.x) * k;
        const fy = (node.targetY - node.y) * k;
        const fz = (node.targetZ - node.z) * k;

        node.vx = (node.vx + fx) * damp;
        node.vy = (node.vy + fy) * damp;
        node.vz = (node.vz + fz) * damp;

        node.x += node.vx;
        node.y += node.vy;
        node.z += node.vz;

        const proj = project3D(node.x, node.y, node.z, centerX, centerY);
        node.screenX = proj.screenX;
        node.screenY = proj.screenY;
        node.screenScale = proj.scale;
        node.depthZ = proj.z;

        const dx = mouseX - node.screenX;
        const dy = mouseY - node.screenY;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < 100) {
          const push = (1 - dist / 100) * 8;
          node.vx -= (dx / dist) * push * 0.4;
          node.vy -= (dy / dist) * push * 0.4;
        }

        if (dist < node.radius * node.screenScale + 12) {
          if (!node.isHovered) {
            window.dispatchEvent(new CustomEvent("cosmic-hover"));
          }
          node.isHovered = true;
          hoveredNode = node;
        } else {
          node.isHovered = false;
        }

        if (node.pulse > 0) node.pulse -= 0.03;
      });

      if (hoveredNode && tooltip && ttTitle && ttDesc) {
        tooltip.style.opacity = '1';
        tooltip.style.left = `${hoveredNode.screenX}px`;
        tooltip.style.top = `${hoveredNode.screenY - 14}px`;
        ttTitle.textContent = hoveredNode.label;
        ttDesc.textContent = hoveredNode.desc;
      } else if (tooltip) {
        tooltip.style.opacity = '0';
      }

      const edges = currentMode === 'dipper' ? referenceEdges : edgeConnections;

      edges.forEach(([iA, iB]) => {
        const nodeA = nodes[iA];
        const nodeB = nodes[iB];
        if (!nodeA || !nodeB) return;

        const avgScale = (nodeA.screenScale + nodeB.screenScale) * 0.5;
        const alpha = Math.min(0.85, Math.max(0.15, avgScale * 0.7));

        ctx.beginPath();
        ctx.moveTo(nodeA.screenX, nodeA.screenY);
        ctx.lineTo(nodeB.screenX, nodeB.screenY);
        ctx.strokeStyle = `rgba(255, 255, 255, ${alpha * 0.35})`;
        ctx.lineWidth = Math.max(1, 1.4 * avgScale);
        ctx.stroke();
      });

      for (let i = activePulses.length - 1; i >= 0; i--) {
        const p = activePulses[i];
        p.progress += p.speed;

        if (p.progress >= 1) {
          nodes[p.endIdx].pulse = 1;
          activePulses.splice(i, 1);
        } else {
          const nA = nodes[p.startIdx];
          const nB = nodes[p.endIdx];
          const px = nA.screenX + (nB.screenX - nA.screenX) * p.progress;
          const py = nA.screenY + (nB.screenY - nA.screenY) * p.progress;
          const scale = nA.screenScale + (nB.screenScale - nA.screenScale) * p.progress;

          ctx.beginPath();
          ctx.arc(px, py, 3.5 * scale, 0, Math.PI * 2);
          ctx.fillStyle = '#ffffff';
          ctx.shadowColor = '#ffffff';
          ctx.shadowBlur = 12;
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      }

      const sortedNodes = [...nodes].sort((a, b) => a.depthZ - b.depthZ);

      sortedNodes.forEach(node => {
        const r = node.radius * node.screenScale;
        const isHover = node.isHovered;
        const pulseVal = Math.max(0, node.pulse);

        const haloGrad = ctx.createRadialGradient(
          node.screenX, node.screenY, 0,
          node.screenX, node.screenY, r * (isHover ? 3.5 : 2.5) + pulseVal * 10
        );
        haloGrad.addColorStop(0, isHover ? 'rgba(255, 255, 255, 0.8)' : 'rgba(255, 255, 255, 0.25)');
        haloGrad.addColorStop(0.5, 'rgba(255, 255, 255, 0.08)');
        haloGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');

        ctx.beginPath();
        ctx.arc(node.screenX, node.screenY, r * (isHover ? 3.5 : 2.5) + pulseVal * 10, 0, Math.PI * 2);
        ctx.fillStyle = haloGrad;
        ctx.fill();

        ctx.beginPath();
        ctx.arc(node.screenX, node.screenY, r, 0, Math.PI * 2);
        ctx.fillStyle = isHover ? '#ffffff' : '#e2e8f0';
        ctx.fill();

        ctx.beginPath();
        ctx.arc(node.screenX, node.screenY, Math.max(1.5, r * 0.35), 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
      });

      // Beam Emitter
      if (currentMode === 'telescope') {
        const topNode = nodes[0];
        const secNode = nodes[2];
        const dirX = topNode.screenX - secNode.screenX;
        const dirY = topNode.screenY - secNode.screenY;
        const len = Math.sqrt(dirX * dirX + dirY * dirY);

        if (len > 0) {
          const normX = dirX / len;
          const normY = dirY / len;
          const beamLength = 150 * topNode.screenScale;

          const beamGrad = ctx.createLinearGradient(
            topNode.screenX, topNode.screenY,
            topNode.screenX + normX * beamLength,
            topNode.screenY + normY * beamLength
          );
          beamGrad.addColorStop(0, 'rgba(255, 255, 255, 0.5)');
          beamGrad.addColorStop(0.3, 'rgba(220, 235, 255, 0.2)');
          beamGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');

          ctx.beginPath();
          ctx.moveTo(topNode.screenX, topNode.screenY);
          ctx.lineTo(topNode.screenX + normX * beamLength, topNode.screenY + normY * beamLength);
          ctx.strokeStyle = beamGrad;
          ctx.lineWidth = 3 * topNode.screenScale;
          ctx.stroke();
        }
      }

      requestAnimationFrame(render);
    }

    render();
  }
</script>
