---
const targets = [
  {
    name: "Jupiter & Galilean Moons",
    type: "Gas Giant",
    mag: "-2.4 (Ultra Bright)",
    visibility: "Prime Observation",
    bestGear: "Any Telescope or 10x50 Binoculars",
    tip: "Look for 4 pinpoints of light orbiting Jupiter: Io, Europa, Ganymede, and Callisto.",
    icon: "🪐"
  },
  {
    name: "Orion Nebula (M42)",
    type: "Stellar Nursery",
    mag: "+4.0 (Visible to naked eye)",
    visibility: "Winter / Spring Evening",
    bestGear: "Sky-Watcher 8\" Dobsonian",
    tip: "A glowing cosmic cloud 1,344 light years away where new baby stars are actively being born.",
    icon: "✨"
  },
  {
    name: "Saturn's Rings & Titan",
    type: "Ringed Planet",
    mag: "+0.5 (Very Bright)",
    visibility: "Midnight Sky",
    bestGear: "8\" Telescope @ 120x+",
    tip: "The ring division (Cassini Division) and giant moon Titan are clearly visible in our club scope.",
    icon: "🪐"
  },
  {
    name: "Andromeda Galaxy (M31)",
    type: "Spiral Galaxy",
    mag: "+3.4 (Naked eye in dark spots)",
    visibility: "All Night High Sky",
    bestGear: "Widefield Binoculars or Scope",
    tip: "Our nearest spiral neighbor containing 1 trillion stars, 2.5 million light years away.",
    icon: "🌌"
  }
];
---

<section id="sky-watcher" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 reveal">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-xs font-semibold uppercase tracking-wider mb-4">
        Interactive Sky Deck
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold font-display text-white tracking-tight mb-4">
        Tonight's Cosmic Observational Deck
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        Calculate real-time lunar phases, explore high-priority targets above Bremen, and plan your Campus Green viewing session.
      </p>
    </div>

    <!-- Live Telemetry Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
      <!-- Left: Realtime Moon Phase Interactive Card -->
      <div class="lg:col-span-5 card-glow p-8 flex flex-col justify-between reveal relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-48 h-48 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-xs font-mono uppercase tracking-widest text-purple-400">Live Lunar Engine</span>
            <span id="moon-date-badge" class="px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10 text-[11px] font-mono text-slate-300">
              Today
            </span>
          </div>

          <!-- Moon Graphic Simulation -->
          <div class="flex flex-col items-center justify-center my-6">
            <div class="relative w-36 h-36 rounded-full bg-slate-900 border border-white/20 shadow-[0_0_50px_rgba(255,255,255,0.15)] flex items-center justify-center overflow-hidden">
              <!-- Moon texture gradient -->
              <div class="absolute inset-0 bg-gradient-to-tr from-slate-300 via-slate-100 to-slate-400 rounded-full"></div>
              <!-- Shadow mask computed dynamically -->
              <div id="moon-shadow-overlay" class="absolute inset-0 bg-slate-950/85 transition-all duration-700"></div>
              <!-- Crater details overlay -->
              <div class="absolute inset-0 opacity-30 mix-blend-overlay pointer-events-none bg-[radial-gradient(ellipse_at_30%_30%,rgba(0,0,0,0.8)_0%,transparent_50%),radial-gradient(ellipse_at_70%_60%,rgba(0,0,0,0.6)_0%,transparent_40%),radial-gradient(ellipse_at_45%_75%,rgba(0,0,0,0.5)_0%,transparent_30%)]"></div>
            </div>

            <h3 id="moon-phase-name" class="text-2xl font-bold font-display text-white mt-5">
              Calculating...
            </h3>
            <p id="moon-phase-desc" class="text-xs text-slate-400 font-mono mt-1">
              Live calculation based on lunar cycle
            </p>
          </div>

          <!-- Moon stats row -->
          <div class="grid grid-cols-2 gap-3 pt-6 border-t border-white/10">
            <div class="p-3 rounded-xl bg-white/[0.03] border border-white/5 text-center">
              <span class="text-[10px] uppercase font-mono text-slate-400 block mb-0.5">Illumination</span>
              <span id="moon-illumination" class="text-lg font-bold text-white font-mono">--%</span>
            </div>
            <div class="p-3 rounded-xl bg-white/[0.03] border border-white/5 text-center">
              <span class="text-[10px] uppercase font-mono text-slate-400 block mb-0.5">Moon Age</span>
              <span id="moon-age" class="text-lg font-bold text-white font-mono">-- Days</span>
            </div>
          </div>
        </div>

        <div class="mt-6 text-[11px] text-slate-400 text-center">
          Optimal for deep-sky stargazing: <strong class="text-purple-300">New Moon ± 4 days</strong>
        </div>
      </div>

      <!-- Right: Campus Green Stargazing Conditions & Target List -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Weather & Sky Quality Bar -->
        <div class="card-glow p-6 reveal">
          <div class="flex items-center justify-between mb-4">
            <h4 class="text-sm font-bold font-display text-white flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Constructor University Observatory Index
            </h4>
            <span class="text-xs font-mono text-purple-300">Bremen Campus</span>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5">
              <div class="text-[10px] font-mono uppercase text-slate-400">Sky Quality</div>
              <div class="text-sm font-bold text-white mt-1">Bortle 5</div>
              <div class="text-[10px] text-emerald-400 mt-0.5">Clear views</div>
            </div>
            <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5">
              <div class="text-[10px] font-mono uppercase text-slate-400">Atmosphere</div>
              <div class="text-sm font-bold text-white mt-1">Stable Seeing</div>
              <div class="text-[10px] text-blue-400 mt-0.5">Planets crisp</div>
            </div>
            <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5">
              <div class="text-[10px] font-mono uppercase text-slate-400">Horizon</div>
              <div class="text-sm font-bold text-white mt-1">360° Open</div>
              <div class="text-[10px] text-purple-400 mt-0.5">Campus Green</div>
            </div>
          </div>
        </div>

        <!-- Tonight's Prime Targets List -->
        <div class="space-y-3">
          <div class="flex items-center justify-between px-1">
            <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Selected Celestial Targets</span>
            <span class="text-xs text-purple-400 font-medium">Auto-calibrated for Bremen Lat 53°N</span>
          </div>

          {targets.map((tgt) => (
            <div class="card-glow p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 group hover:border-purple-500/40 transition">
              <div class="flex items-start gap-3">
                <span class="text-2xl p-2 rounded-xl bg-white/[0.03] border border-white/5 shrink-0 group-hover:scale-110 transition">
                  {tgt.icon}
                </span>
                <div>
                  <div class="flex items-center gap-2">
                    <h5 class="text-sm font-bold text-white group-hover:text-purple-300 transition">{tgt.name}</h5>
                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20 font-mono">
                      {tgt.type}
                    </span>
                  </div>
                  <p class="text-xs text-slate-400 mt-1 leading-relaxed">{tgt.tip}</p>
                </div>
              </div>

              <div class="sm:text-right shrink-0 border-t sm:border-t-0 border-white/5 pt-2 sm:pt-0">
                <span class="text-[11px] font-mono text-emerald-400 block">{tgt.visibility}</span>
                <span class="text-[10px] text-slate-400 block mt-0.5">{tgt.bestGear}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Lunar Engine Script -->
<script>
  function calculateMoonPhase() {
    const now = new Date();
    // Known new moon reference: Jan 11, 2024
    const refNewMoon = new Date("2024-01-11T11:57:00Z");
    const synodicMonth = 29.53058867; // average length of a lunar cycle in days
    
    const diffMs = now.getTime() - refNewMoon.getTime();
    const diffDays = diffMs / (1000 * 60 * 60 * 24);
    const cyclePosition = (diffDays % synodicMonth + synodicMonth) % synodicMonth;
    const illumination = Math.round(((1 - Math.cos((cyclePosition / synodicMonth) * 2 * Math.PI)) / 2) * 100);

    let phaseName = "";
    let shadowStyle = "";

    if (cyclePosition < 1.84) {
      phaseName = "New Moon 🌑";
      shadowStyle = "clip-path: inset(0 0 0 0);";
    } else if (cyclePosition < 5.53) {
      phaseName = "Waxing Crescent 🌒";
      shadowStyle = `clip-path: polygon(0 0, 50% 0, 50% 100%, 0 100%);`;
    } else if (cyclePosition < 9.22) {
      phaseName = "First Quarter 🌓";
      shadowStyle = "clip-path: polygon(0 0, 50% 0, 50% 100%, 0 100%);";
    } else if (cyclePosition < 12.91) {
      phaseName = "Waxing Gibbous 🌔";
      shadowStyle = "clip-path: polygon(0 0, 20% 0, 20% 100%, 0 100%);";
    } else if (cyclePosition < 16.61) {
      phaseName = "Full Moon 🌕";
      shadowStyle = "opacity: 0;";
    } else if (cyclePosition < 20.30) {
      phaseName = "Waning Gibbous 🌖";
      shadowStyle = "clip-path: polygon(80% 0, 100% 0, 100% 100%, 80% 100%);";
    } else if (cyclePosition < 23.99) {
      phaseName = "Last Quarter 🌗";
      shadowStyle = "clip-path: polygon(50% 0, 100% 0, 100% 100%, 50% 100%);";
    } else if (cyclePosition < 27.68) {
      phaseName = "Waning Crescent 🌘";
      shadowStyle = "clip-path: polygon(50% 0, 100% 0, 100% 100%, 50% 100%);";
    } else {
      phaseName = "New Moon 🌑";
      shadowStyle = "clip-path: inset(0 0 0 0);";
    }

    const nameEl = document.getElementById("moon-phase-name");
    const illumEl = document.getElementById("moon-illumination");
    const ageEl = document.getElementById("moon-age");
    const overlayEl = document.getElementById("moon-shadow-overlay");
    const dateBadgeEl = document.getElementById("moon-date-badge");

    if (nameEl) nameEl.textContent = phaseName;
    if (illumEl) illumEl.textContent = illumination + "%";
    if (ageEl) ageEl.textContent = cyclePosition.toFixed(1) + " d";
    if (overlayEl && shadowStyle) overlayEl.setAttribute("style", shadowStyle);
    if (dateBadgeEl) {
      dateBadgeEl.textContent = now.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
    }
  }

  calculateMoonPhase();
</script>
