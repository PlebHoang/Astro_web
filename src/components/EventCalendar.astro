---
const events = [
  {
    title: "Campus Green Stargazing: Saturn Rings & Lunar Craters",
    tag: "Stargazing",
    date: "Every Clear Friday / Saturday",
    time: "20:30 - 23:30 CET",
    location: "Campus Green (near South Hall lawn)",
    details: "Our flagship weekend outdoor session. We set up the 8\" Dobsonian telescope, track planetary targets, and share hot tea. Weather confirmation posted 3 hours prior on Instagram.",
    badgeColor: "bg-purple-500/10 text-purple-300 border-purple-500/30"
  },
  {
    title: "Cosmic Cinema: 'Interstellar' & Kip Thorne Astrophysics",
    tag: "Indoor Cinema",
    date: "Thursday, 20:00 CET",
    time: "20:00 - 23:00 CET",
    location: "Student Activity Center (SAC) Lounge",
    details: "Popcorn, drinks, and a full screening followed by an engaging discussion on black hole physics, event horizons, and gravitational lensing.",
    badgeColor: "bg-blue-500/10 text-blue-300 border-blue-500/30"
  },
  {
    title: "Hands-on Astrophotography & Stacking Workshop",
    tag: "Workshop",
    date: "Wednesday, 18:00 CET",
    time: "18:00 - 19:45 CET",
    location: "Research III Seminar Room + Lawn",
    details: "Learn how to use manual focus, long exposure, and free software (Siril) to capture colorful nebulae with your phone or camera.",
    badgeColor: "bg-pink-500/10 text-pink-300 border-pink-500/30"
  }
];
---

<section id="events" class="py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Matching University Layout Section 3) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 reveal">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-white/[0.04] border border-white/10 text-[10px] font-space-mono text-purple-300 uppercase tracking-widest mb-3">
          Calendar
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold font-orbitron text-white tracking-tight gravitational-warp-target">
          Club Events: Save the date!
        </h2>
      </div>
      <p class="mt-3 md:mt-0 text-slate-400 text-xs sm:text-sm max-w-md font-inter">
        Upcoming society activities open to all Constructor University students, faculty, and guests.
      </p>
    </div>

    <!-- Weather Call Rule Card -->
    <div class="mb-8 p-4 rounded-xl bg-white/[0.02] border border-white/10 backdrop-blur-md flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 reveal">
      <div class="flex items-center gap-3">
        <span class="text-xl">📡</span>
        <div class="text-xs">
          <strong class="text-white font-space-mono">Weather Protocols:</strong>
          <span class="text-slate-300 ml-1">Outdoor Campus Green sessions depend on clear skies. Confirmations are posted 3 hours before sunset on <a href="https://www.instagram.com/astronomy.cub/" target="_blank" rel="noopener noreferrer" class="text-purple-300 underline font-semibold">@astronomy.cub</a>.</span>
        </div>
      </div>
      <a
        href="https://www.instagram.com/astronomy.cub/"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3.5 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/15 text-white font-space-mono text-xs shrink-0 transition"
      >
        Check Live Stories
      </a>
    </div>

    <!-- Events Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {events.map((ev, idx) => (
        <div class={`space-card p-6 flex flex-col justify-between reveal reveal-delay-${idx + 1}`}>
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-space-mono border ${ev.badgeColor}`}>
                {ev.tag}
              </span>
              <span class="text-[10px] font-space-mono text-slate-400">
                {ev.time}
              </span>
            </div>

            <h3 class="text-base font-bold font-orbitron text-white mb-2 leading-snug">
              {ev.title}
            </h3>

            <div class="text-[11px] font-space-mono text-slate-400 space-y-1 mb-4 pb-3 border-b border-white/5">
              <div class="text-slate-300">📅 {ev.date}</div>
              <div class="text-slate-400">📍 {ev.location}</div>
            </div>

            <p class="text-xs text-slate-300 font-inter leading-relaxed mb-6">
              {ev.details}
            </p>
          </div>

          <div class="pt-3 border-t border-white/10 flex items-center justify-between">
            <span class="text-[10px] font-space-mono text-emerald-400">Free for Students</span>
            <a
              href="https://www.instagram.com/astronomy.cub/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-bold font-orbitron text-purple-300 hover:text-white transition"
            >
              RSVP →
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
