---
const galleryItems = [
  {
    title: "Orion's Great Nebula (M42)",
    subtitle: "Stacked 45x 30s exposures through 8\" reflector",
    category: "deep-sky",
    tag: "Deep Sky",
    color: "from-purple-600 via-pink-600 to-indigo-900",
    icon: "🌌",
    author: "CUB Astro Soc Astrophotography Unit"
  },
  {
    title: "Lunar Terminator Craters (Tycho & Clavius)",
    subtitle: "High-resolution smartphone eyepiece capture",
    category: "solar-system",
    tag: "Solar System",
    color: "from-slate-700 via-slate-800 to-slate-950",
    icon: "🌔",
    author: "Campus Green Public Session"
  },
  {
    title: "Campus Green Star Trails",
    subtitle: "300 continuous exposures facing Polaris",
    category: "campus",
    tag: "Campus Night",
    color: "from-indigo-900 via-purple-900 to-slate-900",
    icon: "✨",
    author: "Constructor University Campus"
  },
  {
    title: "Jupiter, Great Red Spot & 4 Galilean Moons",
    subtitle: "Planetary video frame stacking at 200x",
    category: "solar-system",
    tag: "Planetary",
    color: "from-amber-700 via-orange-800 to-slate-900",
    icon: "🪐",
    author: "Observatory Team"
  },
  {
    title: "Pleiades The Seven Sisters (M45)",
    subtitle: "Blue reflection nebula surrounding young hot stars",
    category: "deep-sky",
    tag: "Deep Sky",
    color: "from-blue-600 via-cyan-700 to-indigo-950",
    icon: "⭐",
    author: "Teufelsmoor Dark Sky Expedition"
  },
  {
    title: "Midnight Telescope Circle on Campus Green",
    subtitle: "Students gathered around the Dobsonian with warm tea",
    category: "campus",
    tag: "Community",
    color: "from-purple-950 via-indigo-950 to-pink-950",
    icon: "🔭",
    author: "@astronomy.cub"
  }
];
---

<section id="gallery" class="py-24 relative overflow-hidden bg-gradient-to-b from-transparent via-purple-950/20 to-transparent">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 reveal">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-pink-500/10 border border-pink-500/20 text-pink-300 text-xs font-semibold uppercase tracking-wider mb-4">
        Cosmic Showcase
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold font-display text-white tracking-tight mb-4">
        Astrophotography & Moments
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        Glimpses into the universe and campus nights captured by Constructor University students and society members.
      </p>
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {galleryItems.map((item, idx) => (
        <div
          class={`gallery-item card-glow group cursor-pointer overflow-hidden reveal reveal-delay-${(idx % 3) + 1} flex flex-col justify-between`}
          data-title={item.title}
          data-subtitle={item.subtitle}
          data-author={item.author}
          data-tag={item.tag}
          data-icon={item.icon}
        >
          <!-- Cosmic Graphic Canvas Banner -->
          <div class={`h-52 w-full bg-gradient-to-br ${item.color} relative flex items-center justify-center overflow-hidden transition-transform duration-500 group-hover:scale-105`}>
            <!-- Star particle backdrop effect -->
            <div class="absolute inset-0 opacity-40 bg-[radial-gradient(circle_at_20%_30%,white_1px,transparent_1px),radial-gradient(circle_at_80%_70%,white_1.5px,transparent_1.5px),radial-gradient(circle_at_50%_50%,white_1px,transparent_1px)] bg-[size:40px_40px]"></div>
            
            <!-- Center Icon / Art element -->
            <span class="text-6xl drop-shadow-[0_0_25px_rgba(255,255,255,0.4)] transition-transform duration-500 group-hover:scale-125">
              {item.icon}
            </span>

            <!-- Category Pill -->
            <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-black/40 backdrop-blur-md border border-white/10 text-[11px] font-mono text-white">
              {item.tag}
            </span>

            <!-- Zoom Indicator -->
            <div class="absolute bottom-4 right-4 w-8 h-8 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white opacity-0 group-hover:opacity-100 transition duration-300">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"></path>
              </svg>
            </div>
          </div>

          <!-- Caption info -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-white font-display group-hover:text-purple-300 transition mb-1.5">
                {item.title}
              </h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                {item.subtitle}
              </p>
            </div>

            <div class="pt-4 mt-4 border-t border-white/5 flex items-center justify-between text-[11px] text-slate-400 font-mono">
              <span>{item.author}</span>
              <span class="text-purple-400 group-hover:underline">View details</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Instagram Feeds Banner -->
    <div class="card-glow p-8 sm:p-10 text-center max-w-4xl mx-auto relative overflow-hidden reveal">
      <div class="absolute inset-0 bg-gradient-to-r from-purple-600/10 via-pink-600/10 to-indigo-600/10 pointer-events-none"></div>

      <div class="relative z-10">
        <h3 class="text-2xl sm:text-3xl font-bold font-display text-white mb-3">
          Follow Our Instagram Feeds
        </h3>
        <p class="text-sm text-slate-300 max-w-xl mx-auto mb-8">
          We post live stargazing stories, footage through our telescopes, meeting announcements, and student submissions.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="https://www.instagram.com/astronomy.cub/"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-full bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-semibold text-xs sm:text-sm shadow-lg shadow-pink-900/30 transition flex items-center gap-2 hover:scale-105"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>@astronomy.cub (Active)</span>
          </a>

          <a
            href="https://www.instagram.com/cubastrosoc/"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-slate-200 hover:text-white font-semibold text-xs sm:text-sm transition flex items-center gap-2 hover:scale-105"
          >
            <svg class="w-4 h-4 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>@cubastrosoc (Society Archives)</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Lightbox Modal -->
  <div id="gallery-lightbox" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-xl hidden items-center justify-center p-4">
    <div class="relative max-w-2xl w-full card-glow p-8 bg-[#090520] border-purple-500/30">
      <button
        type="button"
        id="lightbox-close"
        class="absolute top-4 right-4 p-2 text-slate-400 hover:text-white bg-white/5 hover:bg-white/10 rounded-full transition"
        aria-label="Close modal"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <div class="text-center py-6">
        <div id="lightbox-icon" class="text-7xl mb-4">✨</div>
        <span id="lightbox-tag" class="px-3 py-1 rounded-full bg-purple-500/20 text-purple-300 text-xs font-mono border border-purple-500/30 inline-block mb-3">Tag</span>
        <h3 id="lightbox-title" class="text-2xl font-bold font-display text-white mb-2">Title</h3>
        <p id="lightbox-subtitle" class="text-sm text-slate-300 max-w-md mx-auto mb-4">Subtitle</p>
        <p id="lightbox-author" class="text-xs text-slate-400 font-mono">Author</p>
      </div>
    </div>
  </div>
</section>

<!-- Lightbox Script -->
<script>
  const items = document.querySelectorAll(".gallery-item");
  const lightbox = document.getElementById("gallery-lightbox");
  const closeBtn = document.getElementById("lightbox-close");
  const lTitle = document.getElementById("lightbox-title");
  const lSub = document.getElementById("lightbox-subtitle");
  const lAuthor = document.getElementById("lightbox-author");
  const lTag = document.getElementById("lightbox-tag");
  const lIcon = document.getElementById("lightbox-icon");

  items.forEach((item) => {
    item.addEventListener("click", () => {
      const title = item.getAttribute("data-title");
      const subtitle = item.getAttribute("data-subtitle");
      const author = item.getAttribute("data-author");
      const tag = item.getAttribute("data-tag");
      const icon = item.getAttribute("data-icon");

      if (lTitle) lTitle.textContent = title || "";
      if (lSub) lSub.textContent = subtitle || "";
      if (lAuthor) lAuthor.textContent = "Observed by: " + (author || "");
      if (lTag) lTag.textContent = tag || "";
      if (lIcon) lIcon.textContent = icon || "✨";

      lightbox?.classList.remove("hidden");
      lightbox?.classList.add("flex");
    });
  });

  closeBtn?.addEventListener("click", () => {
    lightbox?.classList.add("hidden");
    lightbox?.classList.remove("flex");
  });

  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) {
      lightbox?.classList.add("hidden");
      lightbox?.classList.remove("flex");
    }
  });
</script>
