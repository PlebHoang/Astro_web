---
const events = [
  {
    id: 1,
    title: "Campus Green Clear Sky Watch: Jupiter & Moon Craters",
    category: "stargazing",
    date: "Every Clear Friday / Saturday",
    time: "20:30 - 23:30 CET",
    location: "Campus Green (near South Hall)",
    description: "Our primary weekend observation party. We track lunar terminator lines, identify open star clusters, and take turn on the 8\" Dobsonian telescope. Hot tea and blankets provided!",
    badge: "Weather Dependent",
    badgeColor: "bg-purple-500/20 text-purple-300 border-purple-500/30"
  },
  {
    id: 2,
    title: "Cosmic Cinema: Christopher Nolan's 'Interstellar' & Physics Breakdown",
    category: "movie",
    date: "Coming Thursday",
    time: "19:30 - 22:45 CET",
    location: "Student Activity Center (SAC) Lounge",
    description: "Join fellow students for an immersive screening followed by a discussion on black hole physics (Gargantua), gravitational time dilation, and Kip Thorne's astrophysical models.",
    badge: "Indoor Event",
    badgeColor: "bg-blue-500/20 text-blue-300 border-blue-500/30"
  },
  {
    id: 3,
    title: "Deep-Sky Astrophotography & Stacking Masterclass",
    category: "workshop",
    date: "Next Wednesday",
    time: "18:00 - 20:00 CET",
    location: "RLH Seminar Room + Outdoor Lawn",
    description: "Bring your DSLR, mirrorless camera, or even iPhone/Android. Learn manual focus on stars, star-trailing elimination, calibration frames (darks/flats), and free processing software.",
    badge: "Hands-on",
    badgeColor: "bg-pink-500/20 text-pink-300 border-pink-500/30"
  },
  {
    id: 4,
    title: "Daytime Solar Flare & Sunspot Observation",
    category: "stargazing",
    date: "Mid-Term Solar Session",
    time: "13:00 - 15:00 CET",
    location: "Campus Green Central Plaza",
    description: "Equipped with certified optical solar filters, we safely observe active sunspot regions and solar magnetic phenomena during lunchtime breaks between lectures.",
    badge: "Solar Safe",
    badgeColor: "bg-amber-500/20 text-amber-300 border-amber-500/30"
  }
];
---

<section id="events" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 reveal">
      <div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-300 text-xs font-semibold uppercase tracking-wider mb-4">
          Semester Schedule
        </div>
        <h2 class="text-3xl sm:text-5xl font-bold font-display text-white tracking-tight">
          Upcoming Society Gatherings
        </h2>
      </div>

      <!-- Filters -->
      <div class="mt-6 md:mt-0 flex items-center gap-2 bg-white/[0.04] p-1.5 rounded-2xl border border-white/10">
        <button
          type="button"
          class="event-filter-btn active px-4 py-1.5 rounded-xl text-xs font-medium text-white bg-purple-600 shadow-md transition"
          data-filter="all"
        >
          All Events
        </button>
        <button
          type="button"
          class="event-filter-btn px-4 py-1.5 rounded-xl text-xs font-medium text-slate-300 hover:text-white transition"
          data-filter="stargazing"
        >
          🔭 Stargazing
        </button>
        <button
          type="button"
          class="event-filter-btn px-4 py-1.5 rounded-xl text-xs font-medium text-slate-300 hover:text-white transition"
          data-filter="movie"
        >
          🎬 Movies
        </button>
        <button
          type="button"
          class="event-filter-btn px-4 py-1.5 rounded-xl text-xs font-medium text-slate-300 hover:text-white transition"
          data-filter="workshop"
        >
          📸 Workshops
        </button>
      </div>
    </div>

    <!-- Weather Alert Notice -->
    <div class="mb-10 p-4 rounded-2xl bg-gradient-to-r from-purple-950/60 via-indigo-950/40 to-slate-900/60 border border-purple-500/30 backdrop-blur-md flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 reveal">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-purple-500/20 flex items-center justify-center text-purple-300 shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-white">How Weather Calls Work:</h4>
          <p class="text-xs text-slate-300">Stargazing sessions on Campus Green are confirmed 3 hours prior via our Instagram story (<strong>@astronomy.cub</strong>).</p>
        </div>
      </div>
      <a
        href="https://www.instagram.com/astronomy.cub/"
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 text-xs font-semibold text-white bg-purple-600 hover:bg-purple-500 rounded-xl transition shrink-0"
      >
        Follow for Live Calls
      </a>
    </div>

    <!-- Event Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="events-grid">
      {events.map((ev, idx) => (
        <div
          class={`event-card card-glow p-8 flex flex-col justify-between reveal reveal-delay-${(idx % 2) + 1} transition-all duration-300`}
          data-category={ev.category}
        >
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class={`px-3 py-1 rounded-full text-xs font-mono border ${ev.badgeColor}`}>
                {ev.badge}
              </span>
              <span class="text-xs font-mono text-purple-300 font-semibold">
                {ev.time}
              </span>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold font-display text-white mb-3">
              {ev.title}
            </h3>

            <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-slate-400 mb-4 pb-4 border-b border-white/5">
              <span class="flex items-center gap-1.5 text-slate-300">
                <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                {ev.date}
              </span>
              <span class="flex items-center gap-1.5 text-slate-300">
                <svg class="w-4 h-4 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                {ev.location}
              </span>
            </div>

            <p class="text-slate-300 text-sm leading-relaxed mb-6">
              {ev.description}
            </p>
          </div>

          <div class="pt-4 border-t border-white/10 flex items-center justify-between">
            <span class="text-[11px] text-emerald-400 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Free Admission for All Students
            </span>

            <a
              href="https://www.instagram.com/astronomy.cub/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-1.5 text-xs font-semibold text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-purple-500/40 rounded-xl transition"
            >
              RSVP via Story →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Filter Script -->
<script>
  const filterBtns = document.querySelectorAll(".event-filter-btn");
  const eventCards = document.querySelectorAll(".event-card");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => {
        b.classList.remove("active", "bg-purple-600", "text-white", "shadow-md");
        b.classList.add("text-slate-300");
      });
      btn.classList.add("active", "bg-purple-600", "text-white", "shadow-md");
      btn.classList.remove("text-slate-300");

      const filter = btn.getAttribute("data-filter");

      eventCards.forEach((card) => {
        const cat = card.getAttribute("data-category");
        if (filter === "all" || filter === cat) {
          (card as HTMLElement).style.display = "flex";
        } else {
          (card as HTMLElement).style.display = "none";
        }
      });
    });
  });
</script>
