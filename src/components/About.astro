---
const pillars = [
  {
    icon: `<svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>`,
    title: "Open Telescope Access",
    desc: "We own quality telescopes and bring them to Campus Green. Anyone can observe lunar craters, Saturn's rings, Jupiter's moons, and the Orion Nebula."
  },
  {
    icon: `<svg class="w-6 h-6 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"></path></svg>`,
    title: "Documentaries & Cinema",
    desc: "From BBC's 'The Planets' and Carl Sagan's 'Cosmos' to cinematic sci-fi masterworks, we host cozy campus screenings with tea, snacks, and deep discussions."
  },
  {
    icon: `<svg class="w-6 h-6 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>`,
    title: "Astrophotography Lab",
    desc: "Learn how to capture the Milky Way using just your smartphone or long-exposure DSLR cameras attached to motorized tracking mounts."
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>`,
    title: "Zero Experience Needed",
    desc: "You don't need to study Physics, Computer Science, or Engineering. Whether you're exploring black holes for the first time or a seasoned astronomer, you belong."
  }
];

const gear = [
  { name: "Sky-Watcher 8\" Dobsonian Reflector", role: "Deep Sky & Planetary Specialist", specs: "200mm Aperture • 1200mm Focal Length" },
  { name: "Motorized Star Tracker Mount", role: "Long Exposure Astrophotography", specs: "Precision Sidereal Tracking • DSLR Ready" },
  { name: "Solar Observation Safety Filters", role: "Sunspot & Solar Flare Studies", specs: "Baader Solar Safety Film (OD 5.0)" },
  { name: "Widefield Astronomy Binoculars", role: "Constellation Tours & Star Clusters", specs: "10x50 High Contrast BAK-4 Prisms" },
];
---

<section id="about" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 reveal">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-300 text-xs font-semibold uppercase tracking-wider mb-4">
        Our Identity & Mission
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold font-display text-white tracking-tight mb-6">
        A Student Community Gazing Beyond Earth
      </h2>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        The Constructor University Astronomical Society was founded to make space observation and astrophysics exciting, friendly, and accessible right from our campus in Bremen.
      </p>
    </div>

    <!-- Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-20">
      {pillars.map((p, idx) => (
        <div class={`card-glow p-6 reveal reveal-delay-${(idx % 4) + 1} flex flex-col justify-between group`}>
          <div>
            <div class="w-12 h-12 rounded-xl bg-white/[0.04] border border-white/10 flex items-center justify-center mb-5 group-hover:scale-110 group-hover:border-purple-500/40 transition duration-300">
              <Fragment set:html={p.icon} />
            </div>
            <h3 class="text-lg font-bold text-white font-display mb-2.5 group-hover:text-purple-300 transition">
              {p.title}
            </h3>
            <p class="text-sm text-slate-400 leading-relaxed">
              {p.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Equipment & Campus Highlight Split -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch reveal">
      <!-- Left: Story Box -->
      <div class="lg:col-span-6 card-glow p-8 sm:p-10 flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-purple-400 mb-3 block">Constructor University Hub</span>
          <h3 class="text-2xl sm:text-3xl font-bold font-display text-white mb-4">
            Why Campus Green is Our Stargazing Sanctuary
          </h3>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
            Located in Bremen-Nord, Constructor University's Campus Green offers a wide open field away from dense inner-city high-rises. On clear nights, it turns into a magical open-air observatory.
          </p>
          <p class="text-slate-400 text-sm leading-relaxed mb-6">
            We track weather satellites and moon phases. As soon as a clear sky window opens, an alert goes out on our Instagram story (<strong class="text-white">@astronomy.cub</strong>) and our student group chats. Blankets, hot chocolate, and telescopes are unpacked in minutes.
          </p>
        </div>

        <div class="pt-6 border-t border-white/10 flex items-center justify-between">
          <div>
            <div class="text-2xl font-bold font-display text-white">Bremen-Nord</div>
            <div class="text-xs text-slate-400 font-mono">Bortle Class 5 Dark Sky Spot</div>
          </div>
          <a
            href="https://www.instagram.com/astronomy.cub/"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 text-xs font-semibold text-purple-300 bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/30 rounded-xl transition"
          >
            Check Live Stories →
          </a>
        </div>
      </div>

      <!-- Right: Gear Inventory -->
      <div class="lg:col-span-6 card-glow p-8 sm:p-10 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div>
              <span class="text-xs font-mono uppercase tracking-widest text-indigo-400 block mb-1">Club Arsenal</span>
              <h3 class="text-2xl font-bold font-display text-white">Observational Equipment</h3>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-[11px] font-mono">
              Maintained & Ready
            </span>
          </div>

          <div class="space-y-4">
            {gear.map((item) => (
              <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/5 hover:border-purple-500/30 transition flex items-start justify-between gap-4 group">
                <div>
                  <h4 class="text-sm font-semibold text-slate-100 group-hover:text-purple-300 transition">{item.name}</h4>
                  <p class="text-xs text-purple-400/80 font-mono mt-0.5">{item.role}</p>
                </div>
                <span class="text-[11px] text-slate-400 text-right font-mono shrink-0">{item.specs}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs text-slate-400">
          <span>* All equipment is free for active members to learn and operate.</span>
          <a href="#events" class="text-purple-300 hover:text-white transition font-medium">Join Next Demo →</a>
        </div>
      </div>
    </div>
  </div>
</section>
