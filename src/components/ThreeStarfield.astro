---

<div id="three-container" class="fixed inset-0 z-0 pointer-events-auto overflow-hidden bg-black">
  <canvas id="three-canvas" class="w-full h-full block"></canvas>
  
  <!-- Subtle dark vignette overlay -->
  <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_50%_50%,transparent_0%,rgba(0,0,0,0.6)_100%)]"></div>
</div>

<script>
  import * as THREE from "three";

  const container = document.getElementById("three-container");
  const canvas = document.getElementById("three-canvas") as HTMLCanvasElement;

  if (container && canvas) {
    let width = window.innerWidth;
    let height = window.innerHeight;

    // Scene, Camera, Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, width / height, 0.1, 2000);
    camera.position.z = 400;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // --- Starfield Particle System ---
    const starCount = 3500;
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(starCount * 3);
    const colors = new Float32Array(starCount * 3);
    const sizes = new Float32Array(starCount);

    const palette = [
      new THREE.Color("#ffffff"),
      new THREE.Color("#e2e8f0"),
      new THREE.Color("#38bdf8"), // cyan starlight
      new THREE.Color("#c084fc"), // violet starlight
      new THREE.Color("#f472b6"), // rose starlight
    ];

    for (let i = 0; i < starCount; i++) {
      const idx = i * 3;
      // Spherical distribution
      const r = THREE.MathUtils.randFloat(100, 900);
      const theta = THREE.MathUtils.randFloat(0, Math.PI * 2);
      const phi = Math.acos(THREE.MathUtils.randFloatSpread(2));

      positions[idx] = r * Math.sin(phi) * Math.cos(theta);
      positions[idx + 1] = r * Math.sin(phi) * Math.sin(theta);
      positions[idx + 2] = r * Math.cos(phi);

      const color = palette[Math.floor(Math.random() * palette.length)];
      colors[idx] = color.r;
      colors[idx + 1] = color.g;
      colors[idx + 2] = color.b;

      sizes[i] = Math.random() * 2.5 + 0.8;
    }

    geometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute("color", new THREE.BufferAttribute(colors, 3));
    geometry.setAttribute("size", new THREE.BufferAttribute(sizes, 1));

    // Custom circular particle texture
    const particleCanvas = document.createElement("canvas");
    particleCanvas.width = 32;
    particleCanvas.height = 32;
    const pctx = particleCanvas.getContext("2d");
    if (pctx) {
      const gradient = pctx.createRadialGradient(16, 16, 0, 16, 16, 16);
      gradient.addColorStop(0, "rgba(255,255,255,1)");
      gradient.addColorStop(0.3, "rgba(255,255,255,0.8)");
      gradient.addColorStop(0.8, "rgba(255,255,255,0.1)");
      gradient.addColorStop(1, "rgba(255,255,255,0)");
      pctx.fillStyle = gradient;
      pctx.beginPath();
      pctx.arc(16, 16, 16, 0, Math.PI * 2);
      pctx.fill();
    }
    const particleTexture = new THREE.CanvasTexture(particleCanvas);

    const material = new THREE.PointsMaterial({
      size: 3,
      vertexColors: true,
      map: particleTexture,
      transparent: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });

    const starfield = new THREE.Points(geometry, material);
    scene.add(starfield);

    // --- Nebula Explosions Pool ---
    interface NebulaExplosion {
      points: THREE.Points;
      velocities: Float32Array;
      birth: number;
      duration: number;
    }
    const explosions: NebulaExplosion[] = [];

    function spawnNebula(x: number, y: number) {
      // Map screen coords to 3D world coords
      const vec = new THREE.Vector3(
        (x / width) * 2 - 1,
        -(y / height) * 2 + 1,
        0.5
      );
      vec.unproject(camera);
      vec.sub(camera.position).normalize();
      const distance = 280;
      const targetPos = camera.position.clone().add(vec.multiplyScalar(distance));

      const particleCount = 200;
      const nebGeo = new THREE.BufferGeometry();
      const nebPos = new Float32Array(particleCount * 3);
      const nebCol = new Float32Array(particleCount * 3);
      const velocities = new Float32Array(particleCount * 3);

      const explosionColors = [
        new THREE.Color("#38bdf8"),
        new THREE.Color("#a855f7"),
        new THREE.Color("#ec4899"),
        new THREE.Color("#fbbf24"),
        new THREE.Color("#ffffff"),
      ];

      for (let i = 0; i < particleCount; i++) {
        const i3 = i * 3;
        nebPos[i3] = targetPos.x;
        nebPos[i3 + 1] = targetPos.y;
        nebPos[i3 + 2] = targetPos.z;

        const speed = Math.random() * 2.2 + 0.5;
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(Math.random() * 2 - 1);

        velocities[i3] = speed * Math.sin(phi) * Math.cos(theta);
        velocities[i3 + 1] = speed * Math.sin(phi) * Math.sin(theta);
        velocities[i3 + 2] = speed * Math.cos(phi);

        const col = explosionColors[Math.floor(Math.random() * explosionColors.length)];
        nebCol[i3] = col.r;
        nebCol[i3 + 1] = col.g;
        nebCol[i3 + 2] = col.b;
      }

      nebGeo.setAttribute("position", new THREE.BufferAttribute(nebPos, 3));
      nebGeo.setAttribute("color", new THREE.BufferAttribute(nebCol, 3));

      const nebMat = new THREE.PointsMaterial({
        size: 5.5,
        vertexColors: true,
        map: particleTexture,
        transparent: true,
        opacity: 1,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      });

      const points = new THREE.Points(nebGeo, nebMat);
      scene.add(points);

      explosions.push({
        points,
        velocities,
        birth: performance.now(),
        duration: 1800, // ms
      });

      // Dispatch event for audio feedback
      window.dispatchEvent(new CustomEvent("cosmic-nebula-spawn"));
    }

    // --- Interaction listeners ---
    let targetRotationX = 0;
    let targetRotationY = 0;
    let isDragging = false;
    let previousMouseX = 0;
    let previousMouseY = 0;

    window.addEventListener("pointerdown", (e) => {
      // Don't trigger if clicked on an interactive UI element (button, link, input)
      const target = e.target as HTMLElement;
      if (target.closest("button, a, input, textarea, select")) {
        return;
      }
      isDragging = true;
      previousMouseX = e.clientX;
      previousMouseY = e.clientY;
      spawnNebula(e.clientX, e.clientY);
    });

    window.addEventListener("pointermove", (e) => {
      if (isDragging) {
        const deltaX = e.clientX - previousMouseX;
        const deltaY = e.clientY - previousMouseY;
        targetRotationY += deltaX * 0.003;
        targetRotationX += deltaY * 0.003;
        previousMouseX = e.clientX;
        previousMouseY = e.clientY;
      } else {
        // Subtle mouse parallax
        const normX = (e.clientX / width - 0.5) * 2;
        const normY = (e.clientY / height - 0.5) * 2;
        targetRotationY = normX * 0.25;
        targetRotationX = normY * 0.25;
      }
    });

    window.addEventListener("pointerup", () => {
      isDragging = false;
    });

    // Window resize
    window.addEventListener("resize", () => {
      width = window.innerWidth;
      height = window.innerHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    });

    // Expose trigger globally so buttons can trigger nebula bursts
    (window as any).triggerNebulaBurst = (x?: number, y?: number) => {
      spawnNebula(x ?? width / 2, y ?? height / 2);
    };

    // --- Render Loop ---
    let lastTime = performance.now();

    function animate() {
      requestAnimationFrame(animate);
      const now = performance.now();
      const delta = (now - lastTime) / 1000;
      lastTime = now;

      // Smooth camera/starfield rotation
      starfield.rotation.y += (targetRotationY - starfield.rotation.y) * 0.05 + 0.0003;
      starfield.rotation.x += (targetRotationX - starfield.rotation.x) * 0.05;

      // Update nebula explosions
      for (let i = explosions.length - 1; i >= 0; i--) {
        const exp = explosions[i];
        const age = now - exp.birth;
        const progress = age / exp.duration;

        if (progress >= 1) {
          scene.remove(exp.points);
          exp.points.geometry.dispose();
          (exp.points.material as THREE.Material).dispose();
          explosions.splice(i, 1);
        } else {
          const positions = exp.points.geometry.attributes.position.array as Float32Array;
          for (let j = 0; j < exp.velocities.length; j += 3) {
            positions[j] += exp.velocities[j];
            positions[j + 1] += exp.velocities[j + 1];
            positions[j + 2] += exp.velocities[j + 2];
            // slight drag
            exp.velocities[j] *= 0.98;
            exp.velocities[j + 1] *= 0.98;
            exp.velocities[j + 2] *= 0.98;
          }
          exp.points.geometry.attributes.position.needsUpdate = true;
          (exp.points.material as THREE.PointsMaterial).opacity = (1 - progress) * 0.9;
        }
      }

      renderer.render(scene, camera);
    }

    animate();
  }
</script>
