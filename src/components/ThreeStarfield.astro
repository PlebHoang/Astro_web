---
---

<div id="three-container" class="fixed inset-0 z-0 pointer-events-auto overflow-hidden bg-black">
  <canvas id="three-canvas" class="w-full h-full block"></canvas>
  <!-- Deep space vignette -->
  <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(0,0,0,0.8)_100%)]"></div>
</div>

<script>
  import * as THREE from "three";

  const container = document.getElementById("three-container");
  const canvas = document.getElementById("three-canvas") as HTMLCanvasElement;

  if (container && canvas) {
    let width = window.innerWidth;
    let height = window.innerHeight;

    // Scene with Exponential Fog for true depth
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x000000, 0.0012);

    const camera = new THREE.PerspectiveCamera(65, width / height, 0.1, 3000);
    camera.position.z = 450;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Particle texture
    const particleCanvas = document.createElement("canvas");
    particleCanvas.width = 32;
    particleCanvas.height = 32;
    const pctx = particleCanvas.getContext("2d");
    if (pctx) {
      const grad = pctx.createRadialGradient(16, 16, 0, 16, 16, 16);
      grad.addColorStop(0, "rgba(255, 255, 255, 1)");
      grad.addColorStop(0.25, "rgba(240, 245, 255, 0.85)");
      grad.addColorStop(0.65, "rgba(200, 220, 255, 0.15)");
      grad.addColorStop(1, "rgba(0, 0, 0, 0)");
      pctx.fillStyle = grad;
      pctx.beginPath();
      pctx.arc(16, 16, 16, 0, Math.PI * 2);
      pctx.fill();
    }
    const starTexture = new THREE.CanvasTexture(particleCanvas);

    // --- Multi-Layer Depth Starfield ---
    // Layer 1: Deep Field Distant Stars
    const createStarLayer = (count: number, minR: number, maxR: number, size: number, opacity: number) => {
      const geo = new THREE.BufferGeometry();
      const pos = new Float32Array(count * 3);
      const col = new Float32Array(count * 3);

      for (let i = 0; i < count; i++) {
        const i3 = i * 3;
        const radius = THREE.MathUtils.randFloat(minR, maxR);
        const theta = THREE.MathUtils.randFloat(0, Math.PI * 2);
        const phi = Math.acos(THREE.MathUtils.randFloatSpread(2));

        pos[i3] = radius * Math.sin(phi) * Math.cos(theta);
        pos[i3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
        pos[i3 + 2] = radius * Math.cos(phi);

        // Monochromatic starlight temperatures (silver-white to subtle ice-blue)
        const shade = Math.random() > 0.8 ? 0.95 : 1.0;
        col[i3] = shade;
        col[i3 + 1] = shade;
        col[i3 + 2] = 1.0;
      }

      geo.setAttribute("position", new THREE.BufferAttribute(pos, 3));
      geo.setAttribute("color", new THREE.BufferAttribute(col, 3));

      const mat = new THREE.PointsMaterial({
        size,
        vertexColors: true,
        map: starTexture,
        transparent: true,
        opacity,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      });

      const points = new THREE.Points(geo, mat);
      scene.add(points);
      return points;
    };

    const deepLayer = createStarLayer(2500, 700, 1800, 2.0, 0.45);
    const midLayer = createStarLayer(1800, 300, 700, 3.2, 0.85);
    const nearLayer = createStarLayer(350, 50, 300, 5.0, 0.95);

    // --- Dynamic Supernova Particle Burst Pool ---
    interface StarBurst {
      points: THREE.Points;
      velocities: Float32Array;
      birth: number;
      duration: number;
    }
    const bursts: StarBurst[] = [];

    function spawnStarlightBurst(x: number, y: number) {
      const vec = new THREE.Vector3(
        (x / width) * 2 - 1,
        -(y / height) * 2 + 1,
        0.5
      );
      vec.unproject(camera);
      vec.sub(camera.position).normalize();
      const targetPos = camera.position.clone().add(vec.multiplyScalar(220));

      const pCount = 180;
      const bGeo = new THREE.BufferGeometry();
      const bPos = new Float32Array(pCount * 3);
      const bVel = new Float32Array(pCount * 3);

      for (let i = 0; i < pCount; i++) {
        const i3 = i * 3;
        bPos[i3] = targetPos.x;
        bPos[i3 + 1] = targetPos.y;
        bPos[i3 + 2] = targetPos.z;

        const speed = Math.random() * 2.8 + 0.6;
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(Math.random() * 2 - 1);

        bVel[i3] = speed * Math.sin(phi) * Math.cos(theta);
        bVel[i3 + 1] = speed * Math.sin(phi) * Math.sin(theta);
        bVel[i3 + 2] = speed * Math.cos(phi);
      }

      bGeo.setAttribute("position", new THREE.BufferAttribute(bPos, 3));

      const bMat = new THREE.PointsMaterial({
        size: 4.5,
        color: new THREE.Color(0xffffff),
        map: starTexture,
        transparent: true,
        opacity: 1,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      });

      const burstPoints = new THREE.Points(bGeo, bMat);
      scene.add(burstPoints);

      bursts.push({
        points: burstPoints,
        velocities: bVel,
        birth: performance.now(),
        duration: 1500,
      });

      window.dispatchEvent(new CustomEvent("cosmic-nebula-spawn"));
    }

    // --- Interaction & Scroll Depth Parallax ---
    let targetRotX = 0;
    let targetRotY = 0;
    let scrollY = window.scrollY;
    let targetCameraZ = 450;
    let isDragging = false;
    let prevX = 0;
    let prevY = 0;

    window.addEventListener("scroll", () => {
      scrollY = window.scrollY;
      // Fly camera forward as user navigates down the page
      targetCameraZ = 450 - (scrollY * 0.15);
    });

    window.addEventListener("pointerdown", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("button, a, input, textarea, select")) return;
      isDragging = true;
      prevX = e.clientX;
      prevY = e.clientY;
      spawnStarlightBurst(e.clientX, e.clientY);
    });

    window.addEventListener("pointermove", (e) => {
      if (isDragging) {
        const dx = e.clientX - prevX;
        const dy = e.clientY - prevY;
        targetRotY += dx * 0.0025;
        targetRotX += dy * 0.0025;
        prevX = e.clientX;
        prevY = e.clientY;
      } else {
        const normX = (e.clientX / width - 0.5) * 2;
        const normY = (e.clientY / height - 0.5) * 2;
        targetRotY = normX * 0.2;
        targetRotX = normY * 0.2;
      }
    });

    window.addEventListener("pointerup", () => {
      isDragging = false;
    });

    window.addEventListener("resize", () => {
      width = window.innerWidth;
      height = window.innerHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    });

    (window as any).triggerNebulaBurst = (x?: number, y?: number) => {
      spawnStarlightBurst(x ?? width / 2, y ?? height / 2);
    };

    // --- Render Loop ---
    let lastTime = performance.now();

    function animate() {
      requestAnimationFrame(animate);
      const now = performance.now();

      // Smooth camera depth glide
      camera.position.z += (targetCameraZ - camera.position.z) * 0.05;

      // Parallax differential rotation between depth tiers
      nearLayer.rotation.y += (targetRotY * 1.5 - nearLayer.rotation.y) * 0.08 + 0.0006;
      nearLayer.rotation.x += (targetRotX * 1.5 - nearLayer.rotation.x) * 0.08;

      midLayer.rotation.y += (targetRotY - midLayer.rotation.y) * 0.04 + 0.0003;
      midLayer.rotation.x += (targetRotX - midLayer.rotation.x) * 0.04;

      deepLayer.rotation.y += (targetRotY * 0.5 - deepLayer.rotation.y) * 0.02 + 0.0001;
      deepLayer.rotation.x += (targetRotX * 0.5 - deepLayer.rotation.x) * 0.02;

      // Update bursts
      for (let i = bursts.length - 1; i >= 0; i--) {
        const b = bursts[i];
        const age = now - b.birth;
        const progress = age / b.duration;

        if (progress >= 1) {
          scene.remove(b.points);
          b.points.geometry.dispose();
          (b.points.material as THREE.Material).dispose();
          bursts.splice(i, 1);
        } else {
          const positions = b.points.geometry.attributes.position.array as Float32Array;
          for (let j = 0; j < b.velocities.length; j += 3) {
            positions[j] += b.velocities[j];
            positions[j + 1] += b.velocities[j + 1];
            positions[j + 2] += b.velocities[j + 2];
            b.velocities[j] *= 0.96;
            b.velocities[j + 1] *= 0.96;
            b.velocities[j + 2] *= 0.96;
          }
          b.points.geometry.attributes.position.needsUpdate = true;
          (b.points.material as THREE.PointsMaterial).opacity = (1 - progress) * 0.95;
        }
      }

      renderer.render(scene, camera);
    }

    animate();
  }
</script>
