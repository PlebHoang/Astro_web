---
import CockpitHeader from "./cockpit/CockpitHeader.astro";
import EyepieceOverlay from "./cockpit/EyepieceOverlay.astro";
import TelemetryHUD from "./cockpit/TelemetryHUD.astro";

interface Props {
  mode?: 'background' | 'standalone';
}

const { mode = 'standalone' } = Astro.props;
const isBackground = mode === 'background';
---

<div class="telescope-container relative w-full min-h-screen overflow-x-hidden bg-black font-sans select-none" data-mode={mode}>
  <!-- Fullscreen Telescope Canvas -->
  <canvas id="sky-canvas" tabindex="0" class={`fixed inset-0 w-screen h-screen block cursor-grab active:cursor-grabbing z-0 touch-none ${isBackground ? 'pointer-events-none' : 'pointer-events-auto'}`}></canvas>

  <!-- Circular Eyepiece Reticle & Directional Indicator -->
  <EyepieceOverlay isBackground={isBackground} />

  <!-- Telemetry HUD & Popups -->
  <TelemetryHUD />

  <!-- UI Control Deck (PINNED TO PERIMETER EDGES - ZERO CENTER INTERFERENCE) -->
  <div id="cockpit-ui" class={`fixed inset-0 z-30 pointer-events-none flex flex-col justify-between p-2 sm:p-5 transition-opacity duration-500 ${isBackground ? "opacity-0 pointer-events-none hidden" : "opacity-100"}`}>
    <CockpitHeader isBackground={isBackground} />
  </div>

  <!-- Web Content Layer (If Background Mode) -->
  {isBackground ? (
    <div id="web-overlay" class="relative z-40 min-h-screen transition-opacity duration-500 opacity-100 pointer-events-auto">
      <slot />
    </div>
  ) : (
    <slot />
  )}
</div>

<script>
  import type { StarNode, Constellation } from "../data/constellations";
  import { allConstellations } from "../data/constellations";
  import type { MysteryTarget } from "../data/mysteryTargets";
  import { initialMysteryTargets, createAndromedaParticles, createWhirlpoolParticles, m51BaseX, m51BaseY, m51BaseZ } from "../data/mysteryTargets";
  import { draw5PointStar } from "../lib/renderers/canvasHelpers";
  import { renderJupiter, renderSaturn, renderMars } from "../lib/renderers/planets";
  import { renderPillarsOfCreation, renderM42Nebula } from "../lib/renderers/deepSky";
  import { renderAndromeda, renderWhirlpool } from "../lib/renderers/galaxies";
  import { randomizeSectorPositions } from "../lib/renderers/sectorShuffle";
  import { initTouchControls } from "../lib/controls/touchControls";

  const canvas = document.getElementById("sky-canvas") as HTMLCanvasElement;
  const ctx = canvas?.getContext("2d");

  const eyepieceCircle = document.getElementById("eyepiece-circle");
  const highZoomCross = document.getElementById("high-zoom-cross");
  const scopeBtn20x = document.getElementById("scope-btn-20x");
  const scopeBtn150x = document.getElementById("scope-btn-150x");
  const keyCap1 = document.getElementById("key-cap-1");
  const keyCap2 = document.getElementById("key-cap-2");
  const led1 = document.getElementById("led-1");
  const led2 = document.getElementById("led-2");

  const starCard = document.getElementById("star-info-card");
  const sicCloseBtn = document.getElementById("sic-close-btn");
  const targetDirArrow = document.getElementById("target-dir-arrow");
  const targetDirLabel = document.getElementById("target-dir-label");
  const zoomModeToast = document.getElementById("zoom-mode-toast");
  const toastIcon = document.getElementById("toast-icon");
  const toastText = document.getElementById("toast-text");
  const btnSpawnTarget = document.getElementById("btn-spawn-target");

  const hudMissionName = document.getElementById("hud-mission-name");
  const hudMissionHint = document.getElementById("hud-mission-hint");
  const hudLockStatus = document.getElementById("hud-lock-status");
  const hudReticleDist = document.getElementById("hud-reticle-dist");
  const hudCatalogCount = document.getElementById("hud-catalog-count");

  // Prototype HUD elements
  const btnCycleHUD = document.getElementById("btn-cycle-hud");
  const hudCycleLabel = document.getElementById("hud-cycle-label");

  const pillView = document.getElementById("hud-pill-view");
  const pillStatusDot = document.getElementById("pill-status-dot");
  const pillMissionName = document.getElementById("pill-mission-name");
  const pillAlignment = document.getElementById("pill-alignment");
  const pillActionHint = document.getElementById("pill-action-hint");
  const pillCatalog = document.getElementById("pill-catalog");

  const reticleView = document.getElementById("hud-reticle-view");
  const reticleMissionName = document.getElementById("reticle-mission-name");
  const reticleAlignment = document.getElementById("reticle-alignment");
  const reticleActionHint = document.getElementById("reticle-action-hint");
  const reticleCatalog = document.getElementById("reticle-catalog");

  const tickerView = document.getElementById("hud-ticker-view");
  const tickerMissionName = document.getElementById("ticker-mission-name");
  const tickerAlignment = document.getElementById("ticker-alignment");
  const tickerStatusBadge = document.getElementById("ticker-status-badge");
  const tickerCatalog = document.getElementById("ticker-catalog");

  const cardView = document.getElementById("hud-card-view");
  const btnHeaderReturn = document.getElementById("btn-header-return");

  if (canvas && ctx) {
    // Dual-Mode Overlay Controller
    const container = document.querySelector(".telescope-container") as HTMLElement;
    const isBackgroundMode = container?.dataset.mode === "background";
    const webOverlay = document.getElementById("web-overlay");
    const cockpitUI = document.getElementById("cockpit-ui");

    const eyepieceOverlay = document.getElementById("eyepiece-overlay");

    let isStargazeActive = false;

    // HUD Variant Switcher (Pill | Reticle | Ticker | Card)
    type HUDVariant = "pill" | "reticle" | "ticker" | "card";
    const hudVariants: HUDVariant[] = ["pill", "reticle", "ticker", "card"];
    let activeHUDVariant: HUDVariant = "pill";

    function applyHUDVariant(variant: HUDVariant) {
      activeHUDVariant = variant;
      try {
        localStorage.setItem("cub_hud_variant", variant);
      } catch {}

      const showHUD = isStargazeActive || !isBackgroundMode;
      cardView?.classList.toggle("hidden", !showHUD || variant !== "card");
      pillView?.classList.toggle("hidden", !showHUD || variant !== "pill");
      reticleView?.classList.toggle("hidden", !showHUD || variant !== "reticle");
      tickerView?.classList.toggle("hidden", !showHUD || variant !== "ticker");

      const labelMap: Record<HUDVariant, string> = {
        pill: "Pill",
        reticle: "Reticle",
        ticker: "Ticker",
        card: "Card"
      };
      if (hudCycleLabel) hudCycleLabel.textContent = `HUD: ${labelMap[variant]}`;
    }

    function cycleHUDVariant() {
      const idx = (hudVariants.indexOf(activeHUDVariant) + 1) % hudVariants.length;
      applyHUDVariant(hudVariants[idx]);
      const name = hudVariants[idx].toUpperCase();
      showToast(`HUD STYLE: ${name}`, "HUD");
    }

    btnCycleHUD?.addEventListener("click", () => {
      animateKeyH();
      cycleHUDVariant();
    });

    try {
      const saved = localStorage.getItem("cub_hud_variant") as HUDVariant;
      if (saved && hudVariants.includes(saved)) {
        applyHUDVariant(saved);
      } else {
        applyHUDVariant("pill");
      }
    } catch {
      applyHUDVariant("pill");
    }
    const cockpitHeader = cockpitUI?.querySelector("header");

    function setStargazeMode(active: boolean) {
      isStargazeActive = active;
      webOverlay?.classList.toggle("hidden", active);
      if (cockpitUI) {
        cockpitUI.style.opacity = "";
        cockpitUI.classList.toggle("hidden", !active);
        cockpitUI.classList.toggle("opacity-0", !active);
        cockpitUI.classList.toggle("opacity-100", active);
        cockpitUI.classList.add("pointer-events-none");
      }
      if (cockpitHeader) {
        cockpitHeader.classList.add("pointer-events-auto");
        cockpitHeader.classList.remove("pointer-events-none");
      }
      eyepieceOverlay?.classList.toggle("opacity-100", active);
      eyepieceOverlay?.classList.toggle("opacity-0", !active);
      eyepieceCircle?.classList.toggle("opacity-100", active);
      eyepieceCircle?.classList.toggle("opacity-0", !active);
      if (isBackgroundMode) canvas.style.pointerEvents = active ? "auto" : "none";

      if (active) {
        cardView?.classList.toggle("hidden", activeHUDVariant !== "card");
        pillView?.classList.toggle("hidden", activeHUDVariant !== "pill");
        reticleView?.classList.toggle("hidden", activeHUDVariant !== "reticle");
        tickerView?.classList.toggle("hidden", activeHUDVariant !== "ticker");
        if (document.activeElement instanceof HTMLElement) {
          document.activeElement.blur();
        }
        window.focus();
        window.scrollTo(0, 0);
      } else {
        cardView?.classList.add("hidden");
        pillView?.classList.add("hidden");
        reticleView?.classList.add("hidden");
        tickerView?.classList.add("hidden");
        targetDirArrow?.classList.add("opacity-0");
        targetDirArrow?.classList.remove("opacity-100");
        starCard?.classList.add("opacity-0", "pointer-events-none", "translate-y-3");
        starCard?.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
        zoomModeToast?.classList.add("opacity-0", "-translate-y-2", "pointer-events-none");
        zoomModeToast?.classList.remove("opacity-100", "translate-y-0");
      }
    }

    if (isBackgroundMode) {
      setStargazeMode(false);
      btnHeaderReturn?.addEventListener("click", () => setStargazeMode(false));
      window.addEventListener("toggle-stargaze", () => setStargazeMode(!isStargazeActive));
    } else {
      setStargazeMode(true);
    }

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener("resize", () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    let isHighZoom = false;
    let targetZoom = 1.0;
    let currentZoom = 1.0;

    let camYaw = 0;
    let camPitch = 0;
    let targetYaw = 0;
    let targetPitch = 0;

    // MOUNT LIMITS: Constrain telescope movement to ~135° horizontal cone (±67.5° or ±1.18 rad)
    // and ~80° vertical arc (-31.5° to +48.7° or -0.55 rad to +0.85 rad)
    // Keeps hyperspace warp streaks forward-facing and radially cohesive while allowing free panning
    const YAW_LIMIT = 1.18;   // ±1.18 rad (~135° total horizontal observation cone)
    const PITCH_MIN = -0.55;  // ~ -31.5° (downward horizon boundary)
    const PITCH_MAX = 0.85;   // ~ +48.7° (upper sky boundary)

    function clampOrientation() {
      targetYaw = Math.max(-YAW_LIMIT, Math.min(YAW_LIMIT, targetYaw));
      targetPitch = Math.max(PITCH_MIN, Math.min(PITCH_MAX, targetPitch));
    }

    let isDragging = false;
    let prevMouseX = 0;
    let prevMouseY = 0;
    let mouseX = -1000;
    let mouseY = -1000;

    // 1. Background Passing Stars (Star Wars Hyperspace Field: 2,200 radiant streaks)
    const starCount = 2200;
    const backgroundStars: any[] = [];
    for (let i = 0; i < starCount; i++) {
      const rand = Math.random();
      // Authentic Star Wars Hyperspace Palette:
      // ~45% Neon Blue / Electric Cyan, ~40% Deep Cobalt / Plasma Blue, ~15% Pure White
      let streakColor = "#ffffff";
      if (rand < 0.45) {
        streakColor = rand < 0.22 ? "#00f0ff" : (rand < 0.35 ? "#38bdf8" : "#67e8f9");
      } else if (rand < 0.85) {
        streakColor = rand < 0.65 ? "#0284c7" : "#2563eb";
      } else {
        streakColor = "#ffffff";
      }

      backgroundStars.push({
        x: (Math.random() - 0.5) * 3200,
        y: (Math.random() - 0.5) * 3200,
        z: Math.random() * 2600 + 40,
        size: Math.random() * 1.6 + 0.5,
        alpha: Math.random() * 0.75 + 0.25,
        color: streakColor,
        speedMul: Math.random() * 0.6 + 0.7
      });
    }

    let warpSpeed = 0.65;
    let targetWarpSpeed = 0.65;
    let celestialAlpha = 1.0;

    window.addEventListener("cub:hyperspace-warp", () => {
      if (isStargazeActive && isHighZoom) {
        setScopeMode(false);
      }
      targetWarpSpeed = 85;
      const overlay = document.getElementById("web-overlay");
      const cockpit = document.getElementById("cockpit-ui");
      const eyepiece = document.getElementById("eyepiece-circle");
      const reticleOverlay = document.getElementById("eyepiece-overlay");

      // 1. Slowly make the background / web overlay invisible as speed bursts
      if (overlay) {
        overlay.classList.add("animate-warp-shake");
        overlay.style.transition = "opacity 0.65s cubic-bezier(0.4, 0, 0.2, 1)";
        overlay.style.opacity = "0";
      }
      if (cockpit && isStargazeActive) {
        cockpit.style.transition = "opacity 0.5s ease";
        cockpit.style.opacity = "0.2";
      }
      if (eyepiece && isStargazeActive) {
        eyepiece.style.transition = "opacity 0.5s ease";
        eyepiece.style.opacity = "0.15";
      }
      if (reticleOverlay && isStargazeActive) {
        reticleOverlay.style.transition = "opacity 0.5s ease";
        reticleOverlay.style.opacity = "0.15";
      }

      // 2. Decelerate out of hyperspace after peak light streaks and randomize sector coordinates
      setTimeout(() => {
        targetWarpSpeed = 0.65;
        randomizeSectorPositions(allMysteryTargets, whirlpoolParticles, andromedaParticles);
      }, 900);

      // 3. Slowly reappear the background as the ship exits hyperspace
      setTimeout(() => {
        if (overlay) {
          overlay.style.transition = "opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1)";
          overlay.style.opacity = "1";
        }
        if (cockpit && isStargazeActive) {
          cockpit.style.transition = "opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1)";
          cockpit.style.opacity = "1";
        }
        if (eyepiece && isStargazeActive) {
          eyepiece.style.transition = "opacity 0.85s ease";
          eyepiece.style.opacity = "1";
        }
        if (reticleOverlay && isStargazeActive) {
          reticleOverlay.style.transition = "opacity 0.85s ease";
          reticleOverlay.style.opacity = "1";
        }
      }, 1000);

      setTimeout(() => {
        overlay?.classList.remove("animate-warp-shake");
        if (overlay) overlay.style.transition = "";
        if (cockpit) {
          cockpit.style.transition = "";
          cockpit.style.opacity = "";
        }
        if (eyepiece) eyepiece.style.transition = "";
        if (reticleOverlay) reticleOverlay.style.transition = "";
      }, 1950);
    });

    // 2. CONSTELLATIONS & PARTICLES (Imported from modular data modules)
    const andromedaParticles = createAndromedaParticles();
    const whirlpoolParticles = createWhirlpoolParticles();
    const allMysteryTargets: MysteryTarget[] = [...initialMysteryTargets];

    let currentTargetIndex = 0;
    let activeMystery = allMysteryTargets[currentTargetIndex];
    let isTargetCentered = false;

    let toastTimeout: any = null;
    function showToast(text: string, icon = "🔭") {
      if (!zoomModeToast || !toastText) return;
      if (toastTimeout) clearTimeout(toastTimeout);
      if (toastIcon) toastIcon.textContent = icon;
      toastText.textContent = text;
      zoomModeToast.classList.remove("opacity-0", "-translate-y-2");
      zoomModeToast.classList.add("opacity-100", "translate-y-0");
      toastTimeout = setTimeout(() => {
        zoomModeToast?.classList.add("opacity-0", "-translate-y-2");
        zoomModeToast?.classList.remove("opacity-100", "translate-y-0");
      }, 1400);
    }

    function updateMissionHUD() {
      if (!activeMystery) return;
      const baseName = activeMystery.name.toUpperCase();
      const discoveredCount = allMysteryTargets.filter(t => t.discovered).length;
      const catCount = `${discoveredCount}/${allMysteryTargets.length}`;

      // 1. Pill
      if (pillMissionName) pillMissionName.textContent = baseName;
      if (pillCatalog) pillCatalog.textContent = catCount;

      // 2. Reticle
      if (reticleMissionName) reticleMissionName.textContent = baseName;
      if (reticleCatalog) reticleCatalog.textContent = `${catCount} FOUND`;

      // 3. Ticker
      if (tickerMissionName) tickerMissionName.textContent = baseName;
      if (tickerCatalog) tickerCatalog.textContent = `CATALOG: ${catCount}`;

      // 4. Card
      if (hudMissionName) {
        hudMissionName.textContent = activeMystery.discovered 
          ? `Discovered: ${activeMystery.name}` 
          : `Signal [${activeMystery.name.split(' ')[0]}]`;
      }
      if (hudMissionHint) {
        hudMissionHint.textContent = isHighZoom
          ? (isTargetCentered ? "Target Resolved! Examine telemetry card or discover next object." : "Fine-tune pan to keep object in the center crosshairs.")
          : (isTargetCentered ? "🎯 TARGET CENTERED! Switch to 150x High Zoom (Press [2]) to resolve!" : "Press [1] for 20x Finder to locate the beacon. Press [2] for 150x Zoom to resolve!");
      }
      if (hudCatalogCount) hudCatalogCount.textContent = `CATALOG: ${discoveredCount}/${allMysteryTargets.length} FOUND`;
    }



    function animateKey3() {
      const cap = document.getElementById("key-cap-3");
      if (cap) {
        cap.classList.add("scale-75", "translate-y-1", "ring-2", "ring-white");
        setTimeout(() => {
          cap.classList.remove("scale-75", "translate-y-1", "ring-2", "ring-white");
        }, 180);
      }
    }

    function animateKeyH() {
      const cap = document.getElementById("key-cap-h");
      if (cap) {
        cap.classList.add("scale-75", "translate-y-1", "ring-2", "ring-white");
        setTimeout(() => {
          cap.classList.remove("scale-75", "translate-y-1", "ring-2", "ring-white");
        }, 180);
      }
    }

    function spawnRandomAnomaly() {
      const types: MysteryTarget['type'][] = ['pillars_m16', 'planet_jupiter', 'planet_saturn', 'planet_mars', 'nebula_m42', 'galaxy_m51'];
      const pick = types[Math.floor(Math.random() * types.length)];
      const base = allMysteryTargets.find(t => t.type === pick) || allMysteryTargets[0];
      const custom: MysteryTarget = {
        ...base,
        id: 'custom-' + Date.now(),
        name: `Deep-Sky Anomaly [Sector ${Math.floor(Math.random() * 89 + 10)}]`,
        x: (Math.random() - 0.5) * 1400,
        y: (Math.random() - 0.5) * 1100,
        z: Math.random() * 300 + 820,
        discovered: false,
        beaconColor: "#ffffff"
      };
      allMysteryTargets.push(custom);
      activeMystery = custom;
      isTargetCentered = false;
      updateMissionHUD();
      showToast("RANDOM ANOMALY DETECTED", "✦");
    }

    btnSpawnTarget?.addEventListener("click", () => {
      animateKey3();
      spawnRandomAnomaly();
    });

    // 5. SCOPE TOGGLE CONTROLS & ANIMATED KEYS [1] and [2]
    function animateKeyCap(keyNum: 1 | 2) {
      const cap = keyNum === 1 ? keyCap1 : keyCap2;
      if (cap) {
        cap.classList.add("scale-75", "translate-y-1", "ring-2", "ring-white");
        setTimeout(() => {
          cap.classList.remove("scale-75", "translate-y-1", "ring-2", "ring-white");
        }, 180);
      }
    }

    function showZoomModeToast(is150x: boolean) {
      showToast(is150x ? "150x HIGH ZOOM RESOLVED" : "20x WIDE FINDER ENGAGED", is150x ? "150x" : "20x");
    }

    function setScopeMode(highZoom: boolean) {
      isHighZoom = highZoom;
      animateKeyCap(highZoom ? 2 : 1);
      showZoomModeToast(highZoom);

      if (isHighZoom) {
        targetZoom = 3.2;

        // Button 2 (150x) Active High Contrast State
        scopeBtn150x?.classList.add("bg-white", "text-black", "shadow-[0_0_12px_rgba(255,255,255,0.4)]");
        scopeBtn150x?.classList.remove("text-slate-300", "hover:bg-white/5");
        keyCap2?.classList.add("bg-black", "text-white", "border-black");
        keyCap2?.classList.remove("bg-white/15", "border-white/25");
        led2?.classList.add("bg-emerald-400", "shadow-[0_0_6px_#34d399]", "animate-pulse");
        led2?.classList.remove("bg-white/20");

        // Button 1 (20x) Inactive State
        scopeBtn20x?.classList.remove("bg-white", "text-black", "shadow-[0_0_12px_rgba(255,255,255,0.4)]");
        scopeBtn20x?.classList.add("text-slate-300", "hover:bg-white/5");
        keyCap1?.classList.remove("bg-black", "text-white", "border-black");
        keyCap1?.classList.add("bg-white/15", "border-white/25");
        led1?.classList.remove("bg-emerald-400", "shadow-[0_0_6px_#34d399]", "animate-pulse");
        led1?.classList.add("bg-white/20");

        eyepieceCircle?.classList.add("w-[min(70vh,70vw)]", "h-[min(70vh,70vw)]", "border-white/40");
        eyepieceCircle?.classList.remove("w-[min(84vh,84vw)]", "h-[min(84vh,84vw)]", "border-white/20");
        highZoomCross?.classList.remove("opacity-0");
        highZoomCross?.classList.add("opacity-100");
      } else {
        targetZoom = 1.0;

        // Button 1 (20x) Active High Contrast State
        scopeBtn20x?.classList.add("bg-white", "text-black", "shadow-[0_0_12px_rgba(255,255,255,0.4)]");
        scopeBtn20x?.classList.remove("text-slate-300", "hover:bg-white/5");
        keyCap1?.classList.add("bg-black", "text-white", "border-black");
        keyCap1?.classList.remove("bg-white/15", "border-white/25");
        led1?.classList.add("bg-emerald-400", "shadow-[0_0_6px_#34d399]", "animate-pulse");
        led1?.classList.remove("bg-white/20");

        // Button 2 (150x) Inactive State
        scopeBtn150x?.classList.remove("bg-white", "text-black", "shadow-[0_0_12px_rgba(255,255,255,0.4)]");
        scopeBtn150x?.classList.add("text-slate-300", "hover:bg-white/5");
        keyCap2?.classList.remove("bg-black", "text-white", "border-black");
        keyCap2?.classList.add("bg-white/15", "border-white/25");
        led2?.classList.remove("bg-emerald-400", "shadow-[0_0_6px_#34d399]", "animate-pulse");
        led2?.classList.add("bg-white/20");

        eyepieceCircle?.classList.remove("w-[min(70vh,70vw)]", "h-[min(70vh,70vw)]", "border-white/40");
        eyepieceCircle?.classList.add("w-[min(84vh,84vw)]", "h-[min(84vh,84vw)]", "border-white/20");
        highZoomCross?.classList.add("opacity-0");
        highZoomCross?.classList.remove("opacity-100");
      }
      updateMissionHUD();
    }

    function onScope20x(e: Event) {
      e.preventDefault();
      e.stopPropagation();
      setScopeMode(false);
    }

    function onScope150x(e: Event) {
      e.preventDefault();
      e.stopPropagation();
      setScopeMode(true);
    }

    scopeBtn20x?.addEventListener("click", onScope20x);
    scopeBtn150x?.addEventListener("click", onScope150x);

    // KEYBOARD LISTENER: [1] 20x Finder, [2] 150x Zoom, [3] Random Anomaly, [H] Warp / HUD, [WASD/Arrows] Pan, [TAB] Stargaze, [ESC] Exit
    let lastKeyTimestamp = 0;
    function handleScopeKeyDown(e: KeyboardEvent) {
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      if (e.defaultPrevented) return;
      if (e.timeStamp && e.timeStamp === lastKeyTimestamp) return;
      lastKeyTimestamp = e.timeStamp;

      const activeEl = document.activeElement;
      if (activeEl && (activeEl.tagName === "INPUT" || activeEl.tagName === "TEXTAREA" || (activeEl as HTMLElement).isContentEditable)) {
        return;
      }

      if (e.key === "Tab" || e.code === "Tab") {
        if (isBackgroundMode) {
          e.preventDefault();
          setStargazeMode(!isStargazeActive);
          return;
        }
      }

      if ((e.key === "Escape" || e.code === "Escape") && isStargazeActive && isBackgroundMode) {
        e.preventDefault();
        setStargazeMode(false);
        return;
      }

      const isKey1 = e.key === "1" || e.code === "Digit1" || e.code === "Numpad1" || e.keyCode === 49 || e.keyCode === 97;
      const isKey2 = e.key === "2" || e.code === "Digit2" || e.code === "Numpad2" || e.keyCode === 50 || e.keyCode === 98;
      const isKey3 = e.key === "3" || e.code === "Digit3" || e.code === "Numpad3" || e.keyCode === 51 || e.keyCode === 99;
      const isToggle = e.key === "z" || e.key === "Z" || e.code === "KeyZ" || e.code === "KeyY" || e.code === "Space";
      const isKeyH = e.key === "h" || e.key === "H" || e.code === "KeyH" || e.keyCode === 72;
      const isKeyT = e.key === "t" || e.key === "T" || e.code === "KeyT" || e.keyCode === 84;

      if (isKey1) {
        e.preventDefault();
        if (isBackgroundMode && !isStargazeActive) {
          setStargazeMode(true);
        }
        setScopeMode(false);
      } else if (isKey2) {
        e.preventDefault();
        if (isBackgroundMode && !isStargazeActive) {
          setStargazeMode(true);
        }
        setScopeMode(true);
      } else if (isKey3) {
        e.preventDefault();
        if (isBackgroundMode && !isStargazeActive) {
          setStargazeMode(true);
        }
        animateKey3();
        spawnRandomAnomaly();
      } else if (isToggle) {
        e.preventDefault();
        setScopeMode(!isHighZoom);
      } else if (isKeyT) {
        e.preventDefault();
        if (isStargazeActive && isHighZoom) {
          setScopeMode(false);
        }
        const themeBtn = document.getElementById("theme-toggle-btn");
        if (themeBtn) {
          themeBtn.click();
        } else {
          window.dispatchEvent(new CustomEvent("cub:hyperspace-warp"));
        }
      } else if (isKeyH) {
        e.preventDefault();
        animateKeyH();
        cycleHUDVariant();
      } else if (isStargazeActive) {
        const step = isHighZoom ? 0.015 : 0.08;
        const pitchStep = isHighZoom ? 0.012 : 0.06;
        if (e.key === "a" || e.key === "A" || e.key === "ArrowLeft") {
          targetYaw += step;
        } else if (e.key === "d" || e.key === "D" || e.key === "ArrowRight") {
          targetYaw -= step;
        } else if (e.key === "w" || e.key === "W" || e.key === "ArrowUp") {
          targetPitch -= pitchStep;
        } else if (e.key === "s" || e.key === "S" || e.key === "ArrowDown") {
          targetPitch += pitchStep;
        }
        clampOrientation();
      }
    }

    window.addEventListener("keydown", handleScopeKeyDown, { capture: true });
    document.addEventListener("keydown", handleScopeKeyDown, { capture: true });

    // Star card close button
    sicCloseBtn?.addEventListener("click", () => {
      starCard?.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
      starCard?.classList.add("opacity-0", "pointer-events-none", "translate-y-3");
    });

    // Telescope Zoom via Wheel (Active ONLY in Stargaze Mode)
    window.addEventListener("wheel", (e) => {
      if (!isStargazeActive) return;
      if (e.deltaY < 0) {
        targetZoom = Math.min(4.5, targetZoom + 0.15);
      } else {
        targetZoom = Math.max(0.65, targetZoom - 0.15);
      }
    }, { passive: true });

    // Drag to orbit / pan telescope in 3D (Window-level listener for 100% reliable click capture)
    window.addEventListener("mousedown", (e) => {
      if (e.button !== 0) return;
      const target = e.target as HTMLElement | null;
      if (target?.closest("button, a, input, select, textarea, kbd, #star-info-card, [role='button'], header, footer")) {
        return;
      }
      if (isBackgroundMode && !isStargazeActive) {
        return;
      }
      if (document.activeElement instanceof HTMLElement && document.activeElement !== canvas) {
        document.activeElement.blur();
      }
      canvas?.focus();
      isDragging = true;
      prevMouseX = e.clientX;
      prevMouseY = e.clientY;
      document.body.classList.add("cursor-grabbing");
    });

    window.addEventListener("mouseup", () => {
      isDragging = false;
      document.body.classList.remove("cursor-grabbing");
    });

    window.addEventListener("mousemove", (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (isDragging) {
        const dx = e.clientX - prevMouseX;
        const dy = e.clientY - prevMouseY;
        const panSensitivity = isHighZoom ? 0.0008 : 0.0035;
        targetYaw -= dx * panSensitivity;
        targetPitch -= dy * panSensitivity;
        clampOrientation();
        prevMouseX = e.clientX;
        prevMouseY = e.clientY;
      }
    });

    // Mobile Touch Gestures: Single-finger drag, pinch-to-zoom (20x/150x), and double-tap toggle
    initTouchControls(canvas, {
      isStargazeActive: () => isStargazeActive,
      isBackgroundMode: () => isBackgroundMode,
      isHighZoom: () => isHighZoom,
      onPan: (deltaYaw, deltaPitch) => {
        targetYaw += deltaYaw;
        targetPitch += deltaPitch;
        clampOrientation();
      },
      onToggleZoom: (highZoom) => {
        setScopeMode(highZoom);
      }
    });

    // Click to view star / planet data
    window.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest("button, a, input, select, textarea, kbd, #star-info-card, [role='button'], header, footer")) {
        return;
      }
      if (isBackgroundMode && !isStargazeActive) return;

      if (document.activeElement instanceof HTMLElement && document.activeElement !== canvas) {
        document.activeElement.blur();
      }
      canvas?.focus();

      const cx = width * 0.5;
      const cy = height * 0.5;

      // Check all mystery objects
      for (const m of allMysteryTargets) {
        const p = project3D(m.x, m.y, m.z, cx, cy);
        if (p) {
          const d = Math.hypot(e.clientX - p.sx, e.clientY - p.sy);
          if (d < (isHighZoom ? 60 : 36)) {
            showTelemetryCard(m, true);
            return;
          }
        }
      }

      // Check stars
      let foundStar: any = null;
      for (const constel of allConstellations) {
        for (const star of constel.stars) {
          const p = project3D(star.x, star.y, star.z, cx, cy);
          if (!p) continue;
          const dist = Math.hypot(e.clientX - p.sx, e.clientY - p.sy);
          if (dist < 22) {
            foundStar = star;
            break;
          }
        }
        if (foundStar) break;
      }

      if (foundStar) {
        showTelemetryCard(foundStar, false);
      }
    });

    function showTelemetryCard(item: any, isPlanetOrNebula: boolean) {
      const t = document.getElementById("sic-title");
      const b = document.getElementById("sic-bayer");
      const d = document.getElementById("sic-dist");
      const sp = document.getElementById("sic-spec");
      const m = document.getElementById("sic-mag");
      const r = document.getElementById("sic-role");
      const desc = document.getElementById("sic-desc");
      const badge = document.getElementById("sic-badge");

      if (t) t.textContent = item.name;
      if (b) b.textContent = item.bayer;
      if (d) d.textContent = item.dist;
      if (sp) sp.textContent = item.spec;
      if (m) m.textContent = item.mag;
      if (r) r.textContent = item.role;
      if (badge) badge.textContent = item.mission || (isPlanetOrNebula ? "CELESTIAL ANOMALY" : "STAR");

      starCard?.classList.remove("opacity-0", "pointer-events-none", "translate-y-3");
      starCard?.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
    }

    // 6. 3D PROJECTION ENGINE
    function project3D(x: number, y: number, z: number, cx: number, cy: number) {
      const cosY = Math.cos(camYaw);
      const sinY = Math.sin(camYaw);
      const x1 = x * cosY + z * sinY;
      const z1 = -x * sinY + z * cosY;

      const cosP = Math.cos(camPitch);
      const sinP = Math.sin(camPitch);
      const y2 = y * cosP - z1 * sinP;
      const z2 = y * sinP + z1 * cosP;
      // Responsive FOV: 700px on standard desktop (1080p), scaled proportionally on mobile (244px on 375px phone)
      const baseFov = Math.min(700, Math.min(width, height) * 0.65);
      const fov = baseFov * currentZoom;
      const depth = z2;

      if (depth <= 10) return null;
      const scale = fov / depth;

      return {
        sx: cx + x1 * scale,
        sy: cy + y2 * scale,
        scale: scale,
        depth: depth
      };
    }
    // 7. HIGH-ZOOM PROCEDURAL CELESTIAL RENDERERS
    // Modular renderers are imported from src/lib/renderers/planets and src/lib/renderers/deepSky

    // 8. ANIMATION LOOP
    function render() {
      requestAnimationFrame(render);

      camYaw += (targetYaw - camYaw) * 0.08;
      camPitch += (targetPitch - camPitch) * 0.08;
      camYaw = Math.max(-YAW_LIMIT, Math.min(YAW_LIMIT, camYaw));
      camPitch = Math.max(PITCH_MIN, Math.min(PITCH_MAX, camPitch));
      currentZoom += (targetZoom - currentZoom) * 0.08;

      ctx.fillStyle = "#000000";
      ctx.fillRect(0, 0, width, height);

      const cx = width * 0.5;
      const cy = height * 0.5;

      // A. Background Passing Stars (Calm Ambient Drift & Relativistic Hyperspace Jump)
      warpSpeed += (targetWarpSpeed - warpSpeed) * 0.08;
      const isWarpStreak = warpSpeed > 3;

      // Smoothly fade celestial background objects (galaxies, nebulae, constellations) to invisible during warp
      if (warpSpeed > 3) {
        const targetAlpha = Math.max(0, 1 - (warpSpeed - 3) / 18);
        celestialAlpha += (targetAlpha - celestialAlpha) * 0.15;
      } else {
        celestialAlpha += (1.0 - celestialAlpha) * 0.08;
      }

      // Draw subtle radiant hyperspace tunnel core glow at vanishing center when at high warp
      if (warpSpeed > 8) {
        const glowRadius = Math.min(width, height) * 0.5 * Math.min(1, warpSpeed / 65);
        const glowGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, glowRadius);
        const isStarWars = document.documentElement.classList.contains("theme-starwars");
        glowGrad.addColorStop(0, isStarWars ? "rgba(0, 240, 255, 0.45)" : "rgba(255, 255, 255, 0.28)");
        glowGrad.addColorStop(0.35, isStarWars ? "rgba(2, 132, 199, 0.25)" : "rgba(200, 230, 255, 0.12)");
        glowGrad.addColorStop(1, "rgba(0, 0, 0, 0)");
        ctx.fillStyle = glowGrad;
        ctx.fillRect(0, 0, width, height);
      }

      const isStarWarsTheme = document.documentElement.classList.contains("theme-starwars");
      const isMobile = width < 640;
      const starCountToRender = isMobile ? 800 : backgroundStars.length;
      const ambientDim = (isBackgroundMode && !isStargazeActive) ? (isMobile ? 0.6 : 0.8) : 1.0;

      for (let i = 0; i < starCountToRender; i++) {
        const s = backgroundStars[i];
        s.z -= warpSpeed * s.speedMul;

        if (s.z <= 20) {
          s.z = 2600;
          s.x = (Math.random() - 0.5) * 3200;
          s.y = (Math.random() - 0.5) * 3200;
          continue;
        }

        const curr = project3D(s.x, s.y, s.z, cx, cy);
        if (!curr) continue;

        if (isWarpStreak) {
          // Dynamic radiant streak tail: stretches radially away from the vanishing center
          const tailZ = Math.min(2600, s.z + warpSpeed * 4.5);
          const prev = project3D(s.x, s.y, tailZ, cx, cy);
          if (prev) {
            ctx.beginPath();
            ctx.moveTo(prev.sx, prev.sy);
            ctx.lineTo(curr.sx, curr.sy);
            ctx.strokeStyle = isStarWarsTheme ? s.color : `rgba(255, 255, 255, ${Math.min(1, (s.alpha + 0.35) * ambientDim)})`;
            ctx.lineWidth = Math.min(4.2, (1 - s.z / 2600) * 3.2 + 0.8);
            ctx.stroke();
          }
        } else {
          ctx.beginPath();
          const starRadius = Math.max(0.4, (s.size * (isMobile ? 0.75 : 1.0)) * curr.scale);
          ctx.arc(curr.sx, curr.sy, starRadius, 0, Math.PI * 2);
          ctx.fillStyle = isStarWarsTheme ? s.color : `rgba(255, 255, 255, ${s.alpha * ambientDim})`;
          ctx.fill();
        }
      }

      // Celestial objects slowly fade to invisible during hyperspace jump, then gracefully reappear
      if (celestialAlpha > 0.01) {
        ctx.save();
        ctx.globalAlpha = Math.min(1, Math.max(0, celestialAlpha));

        // B. Andromeda Galaxy (M31)
        renderAndromeda(ctx, cx, cy, andromedaParticles, mouseX, mouseY, isHighZoom, project3D);

        // B2. Whirlpool Galaxy (M51 & NGC 5195)
        const m51Target = allMysteryTargets.find(t => t.type === 'galaxy_m51');
        renderWhirlpool(
          ctx,
          cx,
          cy,
          whirlpoolParticles,
          mouseX,
          mouseY,
          isHighZoom,
          project3D,
          m51Target?.x ?? m51BaseX,
          m51Target?.y ?? m51BaseY,
          m51Target?.z ?? m51BaseZ
        );

      // C. Render All Constellations in 3D
      allConstellations.forEach(constel => {
        const projStars = constel.stars.map(s => project3D(s.x, s.y, s.z, cx, cy));

        constel.lines.forEach(([iA, iB]) => {
          const pA = projStars[iA];
          const pB = projStars[iB];
          if (!pA || !pB) return;

          const isPolarisPointer = (constel.name.includes("Ursa Major") && iA === 4 && iB === 7);

          ctx.beginPath();
          ctx.moveTo(pA.sx, pA.sy);
          ctx.lineTo(pB.sx, pB.sy);
          ctx.strokeStyle = isPolarisPointer ? "rgba(255, 255, 255, 0.55)" : "rgba(255, 255, 255, 0.26)";
          ctx.lineWidth = isPolarisPointer ? 1.5 : 1.1;

          if (isPolarisPointer) {
            ctx.setLineDash([5, 6]);
          } else {
            ctx.setLineDash([]);
          }
          ctx.stroke();
          ctx.setLineDash([]);
        });

        projStars.forEach((p, idx) => {
          if (!p) return;
          const s = constel.stars[idx];
          const r = s.size * p.scale;

          const halo = ctx.createRadialGradient(p.sx, p.sy, 0, p.sx, p.sy, r * 3.6);
          halo.addColorStop(0, s.color || "rgba(255, 255, 255, 0.85)");
          halo.addColorStop(0.35, "rgba(255, 255, 255, 0.2)");
          halo.addColorStop(1, "rgba(0, 0, 0, 0)");

          ctx.beginPath();
          ctx.arc(p.sx, p.sy, r * 3.6, 0, Math.PI * 2);
          ctx.fillStyle = halo;
          ctx.fill();

          draw5PointStar(ctx, p.sx, p.sy, r * 1.6, r * 0.75, s.color || "#ffffff");

          if (s.isBinary && isHighZoom) {
            const splitOffset = s.id === 'mizar' ? 24 : 18;
            const compX = p.sx + splitOffset * p.scale;
            const compY = p.sy - splitOffset * 0.75 * p.scale;
            const compColor = s.id === 'albireo' ? "#9ac5ff" : "rgba(240, 245, 255, 0.85)";
            draw5PointStar(ctx, compX, compY, r * 1.0, r * 0.5, compColor);

            ctx.font = '9px "Space Mono", monospace';
            ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
            ctx.fillText(s.id === 'mizar' ? "Alcor (80 UMa)" : "Albireo B (Blue)", compX + 10, compY + 3);
            ctx.fillText(s.id === 'mizar' ? "Mizar A & B (Split)" : "Albireo A (Gold)", p.sx + 12, p.sy + 12);
          } else if (currentZoom > 0.85) {
            ctx.font = '10px "Space Mono", monospace';
            ctx.fillStyle = "rgba(255, 255, 255, 0.8)";
            ctx.fillText(s.name, p.sx + r + 6, p.sy + 3);
          }
        });
      });

      // D. RENDER ALL MYSTERY CELESTIAL OBJECTS (WITH INTENSE PRESENCE)
      allMysteryTargets.forEach(m => {
        const proj = project3D(m.x, m.y, m.z, cx, cy);
        if (!proj) return;

        const isCurrentActive = activeMystery && activeMystery.id === m.id;
        const pulse = (Math.sin(Date.now() * 0.005 + m.x) + 1) * 0.5;

        // IN 20x FINDER MODE: Every mystery object has unmistakable presence
        if (!isHighZoom) {
          // 1. Broad Volumetric Nebular / Atmospheric Cloud
          const auraRadius = (m.type === 'pillars_m16' || m.type === 'nebula_m42' || m.type === 'galaxy_m51') ? 36 : 24;
          const auraGrad = ctx.createRadialGradient(proj.sx, proj.sy, 0, proj.sx, proj.sy, auraRadius);
          auraGrad.addColorStop(0, m.beaconColor);
          auraGrad.addColorStop(0.35, `rgba(255, 255, 255, ${0.35 + pulse * 0.3})`);
          auraGrad.addColorStop(0.7, `rgba(200, 225, 255, ${0.12 + pulse * 0.1})`);
          auraGrad.addColorStop(1, "rgba(0, 0, 0, 0)");

          ctx.beginPath();
          ctx.arc(proj.sx, proj.sy, auraRadius, 0, Math.PI * 2);
          ctx.fillStyle = auraGrad;
          ctx.fill();

          // 2. Optical Diffraction Needle Spikes (4-point cross for celestial objects)
          ctx.strokeStyle = `rgba(255, 255, 255, ${0.4 + pulse * 0.4})`;
          ctx.lineWidth = 1.0;
          const spikeLen = 14 + pulse * 6;
          ctx.beginPath();
          ctx.moveTo(proj.sx - spikeLen, proj.sy);
          ctx.lineTo(proj.sx + spikeLen, proj.sy);
          ctx.moveTo(proj.sx, proj.sy - spikeLen);
          ctx.lineTo(proj.sx, proj.sy + spikeLen);
          ctx.stroke();

          // 3. Central bright nucleus
          ctx.beginPath();
          ctx.arc(proj.sx, proj.sy, (m.discovered ? 4.2 : 3.4) + pulse * 1.2, 0, Math.PI * 2);
          ctx.fillStyle = "#ffffff";
          ctx.fill();

          // 4. Optical targeting bracket & radar sweep ring for active target
          if (isCurrentActive) {
            ctx.strokeStyle = `rgba(255, 255, 255, ${0.6 + pulse * 0.4})`;
            ctx.lineWidth = 1.3;
            const b = 18;
            // 4 corner brackets
            ctx.beginPath();
            ctx.moveTo(proj.sx - b, proj.sy - b + 6); ctx.lineTo(proj.sx - b, proj.sy - b); ctx.lineTo(proj.sx - b + 6, proj.sy - b);
            ctx.moveTo(proj.sx + b - 6, proj.sy - b); ctx.lineTo(proj.sx + b, proj.sy - b); ctx.lineTo(proj.sx + b, proj.sy - b + 6);
            ctx.moveTo(proj.sx - b, proj.sy + b - 6); ctx.lineTo(proj.sx - b, proj.sy + b); ctx.lineTo(proj.sx - b + 6, proj.sy + b);
            ctx.moveTo(proj.sx + b - 6, proj.sy + b); ctx.lineTo(proj.sx + b, proj.sy + b); ctx.lineTo(proj.sx + b, proj.sy + b - 6);
            ctx.stroke();

            // Expanding telemetry radar circle
            const radarR = 12 + (Date.now() % 1600) * 0.015;
            const radarAlpha = Math.max(0, 1 - radarR / 36);
            ctx.beginPath();
            ctx.arc(proj.sx, proj.sy, radarR, 0, Math.PI * 2);
            ctx.strokeStyle = `rgba(255, 255, 255, ${radarAlpha * 0.6})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }

          // 5. Scientific Tag Label
          ctx.font = '10px "Space Mono", monospace';
          ctx.fillStyle = m.discovered ? "rgba(255, 255, 255, 0.95)" : "rgba(255, 255, 255, 0.75)";
          ctx.fillText(
            m.discovered ? m.name : `[Anomaly: ${m.name.split(' ')[0]}]`,
            proj.sx + 24,
            proj.sy + 4
          );
        }
        // IN 150x HIGH ZOOM MODE: Fully resolved procedural rendering
        else {
          if (m.type === 'pillars_m16') {
            renderPillarsOfCreation(ctx, proj.sx, proj.sy, proj.scale);
          } else if (m.type === 'planet_jupiter') {
            renderJupiter(ctx, proj.sx, proj.sy, proj.scale);
          } else if (m.type === 'planet_saturn') {
            renderSaturn(ctx, proj.sx, proj.sy, proj.scale);
          } else if (m.type === 'planet_mars') {
            renderMars(ctx, proj.sx, proj.sy, proj.scale);
          } else if (m.type === 'nebula_m42') {
            renderM42Nebula(ctx, proj.sx, proj.sy, proj.scale);
          } else if (m.type === 'galaxy_m51') {
            // Rendered with 1,200 particle grand design spiral in Section B2
          }

          ctx.font = '11px "Space Mono", monospace';
          ctx.fillStyle = "#ffffff";
          ctx.fillText(m.name, proj.sx + 50, proj.sy + 4);
        }
      });
      ctx.restore();
    }

      // E. Update Reticle Lock & Direction Arrow for Active Hunt Target
      if (activeMystery) {
        const proj = project3D(activeMystery.x, activeMystery.y, activeMystery.z, cx, cy);
        if (proj) {
          const distFromReticle = Math.hypot(proj.sx - cx, proj.sy - cy);
          const alignPercent = Math.max(0, Math.min(100, Math.round(100 - (distFromReticle / (width * 0.4)) * 100)));
          const alignText = `${alignPercent}%`;

          // Update alignment readout across all HUD variants
          if (hudReticleDist) hudReticleDist.textContent = `ALIGNMENT: ${alignText}`;
          if (pillAlignment) pillAlignment.textContent = alignText;
          if (reticleAlignment) reticleAlignment.textContent = `ALIGN ${alignText}`;
          if (tickerAlignment) tickerAlignment.textContent = `ALIGNMENT: ${alignText}`;

          const alignThreshold = isHighZoom ? 65 : 42;
          isTargetCentered = distFromReticle < alignThreshold;

          // Prototype 1 (Pill) feedback
          if (pillStatusDot) {
            pillStatusDot.className = isTargetCentered
              ? "w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399] animate-pulse shrink-0"
              : (distFromReticle < 220 ? "w-2 h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_#22d3ee] animate-pulse shrink-0" : "w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_8px_#fbbf24] animate-pulse shrink-0");
          }
          if (pillActionHint) {
            pillActionHint.textContent = isHighZoom
              ? (isTargetCentered ? "RESOLVED" : "CENTER CROSSHAIR")
              : (isTargetCentered ? "ZOOM 150x" : "LOCATE SIGNAL");
          }

          // Prototype 2 (Reticle HUD) feedback
          if (reticleActionHint) {
            reticleActionHint.textContent = isHighZoom
              ? (isTargetCentered ? "VERIFIED" : "FINE-TUNE")
              : (isTargetCentered ? "ZOOM 150x" : "LOCATE BEACON");
          }

          // Prototype 3 (Ticker) feedback
          if (tickerStatusBadge) {
            tickerStatusBadge.textContent = isTargetCentered ? (isHighZoom ? "VERIFIED" : "LOCKED") : (distFromReticle < 220 ? "IN VIEW" : "SEARCHING");
            tickerStatusBadge.className = isTargetCentered
              ? "px-1.5 py-0.5 rounded bg-white text-black font-bold text-[9px]"
              : "px-1.5 py-0.5 rounded bg-white/10 text-slate-300 text-[9px]";
          }

          // Prototype 0 (Classic Card) feedback
          if (hudLockStatus) {
            if (isTargetCentered) {
              hudLockStatus.textContent = isHighZoom ? "DISCOVERY VERIFIED" : "CENTER LOCKED";
              hudLockStatus.className = "px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-white text-black animate-pulse shadow-sm";
            } else if (distFromReticle < 220) {
              hudLockStatus.textContent = "IN VIEWPORT";
              hudLockStatus.className = "px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-white/20 text-white";
            } else {
              hudLockStatus.textContent = "SEARCHING";
              hudLockStatus.className = "px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-white/10 text-slate-300 border border-white/15";
            }
          }

          // Mark target resolved when centered in 150x High Zoom (no popup message)
          if (isTargetCentered && isHighZoom && !activeMystery.discovered) {
            activeMystery.discovered = true;
            updateMissionHUD();
          }

          // Direction Arrow HUD: only show when in stargaze mode and outside viewport
          if (targetDirArrow) {
            if (isStargazeActive && distFromReticle > width * 0.38) {
              const angle = Math.atan2(proj.sy - cy, proj.sx - cx);
              targetDirArrow.style.transform = `translate(-50%, -50%) rotate(${angle + Math.PI / 2}rad)`;
              targetDirArrow.classList.remove("opacity-0");
              targetDirArrow.classList.add("opacity-100");
              if (targetDirLabel) targetDirLabel.textContent = `ANOMALY: ${Math.round(distFromReticle * 0.1)}°`;
            } else {
              targetDirArrow.classList.add("opacity-0");
              targetDirArrow.classList.remove("opacity-100");
            }
          }
        }
      }
    }

    // Launch render loop
    render();
    updateMissionHUD();
  }
</script>
