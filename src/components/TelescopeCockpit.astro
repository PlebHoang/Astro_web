        if (previewLabel) previewLabel.textContent = "👁️ Overlay: ON";
      } else {
        webPreview?.classList.add("opacity-0", "pointer-events-none");
        if (previewLabel) previewLabel.textContent = "👁️ Overlay: OFF";
      }
    });

    // Star card close button
    sicCloseBtn?.addEventListener("click", () => {
      starCard?.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
      starCard?.classList.add("opacity-0", "pointer-events-none", "translate-y-3");
    });

    // Telescope Zoom via Wheel (Active ONLY in Stargaze Mode)
    window.addEventListener("wheel", (e) => {
      if (!isStargazeActive) return;
      if (e.deltaY < 0) {
        targetZoom = Math.min(4.5, targetZoom + 0.15);
      } else {
        targetZoom = Math.max(0.65, targetZoom - 0.15);
      }
    }, { passive: true });

    // Drag to orbit / pan telescope in 3D
    canvas.addEventListener("mousedown", (e) => {
      isDragging = true;
      prevMouseX = e.clientX;
      prevMouseY = e.clientY;
    });

    window.addEventListener("mouseup", () => isDragging = false);

    window.addEventListener("mousemove", (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (isDragging) {
        const dx = e.clientX - prevMouseX;
        const dy = e.clientY - prevMouseY;
        targetYaw -= dx * 0.0032;
        targetPitch -= dy * 0.0032;
        prevMouseX = e.clientX;
        prevMouseY = e.clientY;
      }
    });

    // Click to view star / planet data
    canvas.addEventListener("click", (e) => {
      const cx = width * 0.5;
      const cy = height * 0.5;

      // Check all mystery objects
      for (const m of allMysteryTargets) {
        const p = project3D(m.x, m.y, m.z, cx, cy);
        if (p) {
          const d = Math.hypot(e.clientX - p.sx, e.clientY - p.sy);
          if (d < (isHighZoom ? 55 : 32)) {
            showTelemetryCard(m, true);
            return;
          }
        }
      }

      // Check stars
      let foundStar: any = null;
      for (const constel of allConstellations) {
        for (const star of constel.stars) {
          const p = project3D(star.x, star.y, star.z, cx, cy);
          if (!p) continue;
          const dist = Math.hypot(e.clientX - p.sx, e.clientY - p.sy);
          if (dist < 22) {
            foundStar = star;
            break;
          }
        }
        if (foundStar) break;
      }

      if (foundStar) {
        showTelemetryCard(foundStar, false);
      }
    });

    function showTelemetryCard(item: any, isPlanetOrNebula: boolean) {
      const t = document.getElementById("sic-title");
      const b = document.getElementById("sic-bayer");
      const d = document.getElementById("sic-dist");
      const sp = document.getElementById("sic-spec");
      const m = document.getElementById("sic-mag");
      const r = document.getElementById("sic-role");
      const desc = document.getElementById("sic-desc");
      const badge = document.getElementById("sic-badge");

      if (t) t.textContent = item.name;
      if (b) b.textContent = item.bayer;
      if (d) d.textContent = item.dist;
      if (sp) sp.textContent = item.spec;
      if (m) m.textContent = item.mag;
      if (r) r.textContent = item.role;
      if (desc) desc.textContent = item.desc;
      if (badge) badge.textContent = isPlanetOrNebula ? "CELESTIAL ANOMALY" : "STAR";

      starCard?.classList.remove("opacity-0", "pointer-events-none", "translate-y-3");
      starCard?.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
    }

    // 6. 3D PROJECTION ENGINE
    function project3D(x: number, y: number, z: number, cx: number, cy: number) {
      const cosY = Math.cos(camYaw);
      const sinY = Math.sin(camYaw);
      const x1 = x * cosY + z * sinY;
      const z1 = -x * sinY + z * cosY;

      const cosP = Math.cos(camPitch);
      const sinP = Math.sin(camPitch);
      const y2 = y * cosP - z1 * sinP;
      const z2 = y * sinP + z1 * cosP;

      const fov = 700 * currentZoom;
      const depth = z2;

      if (depth <= 10) return null;
      const scale = fov / depth;

      return {
        sx: cx + x1 * scale,
        sy: cy + y2 * scale,
        scale: scale,
        depth: depth
      };
    }

    function draw5PointStar(ctx: CanvasRenderingContext2D, cx: number, cy: number, rOut: number, rIn: number, fill: string) {
      let rot = (Math.PI / 2) * 3;
      let x = cx;
      let y = cy;
      const step = Math.PI / 5;

      ctx.beginPath();
      ctx.moveTo(cx, cy - rOut);
      for (let i = 0; i < 5; i++) {
        x = cx + Math.cos(rot) * rOut;
        y = cy + Math.sin(rot) * rOut;
        ctx.lineTo(x, y);
        rot += step;
        x = cx + Math.cos(rot) * rIn;
        y = cy + Math.sin(rot) * rIn;
        ctx.lineTo(x, y);
        rot += step;
      }
      ctx.lineTo(cx, cy - rOut);
      ctx.closePath();
      ctx.fillStyle = fill;
      ctx.fill();
    }

    // 7. HIGH-ZOOM PROCEDURAL CELESTIAL RENDERERS
    function renderPillarsOfCreation(ctx: CanvasRenderingContext2D, cx: number, cy: number, scale: number) {
      const s = Math.max(0.6, scale);
      ctx.save();

      // Ambient background ionization glow (Hydrogen-alpha red-orange & Oxygen-III teal)
      const glowGrad = ctx.createRadialGradient(cx, cy, 10 * s, cx, cy, 120 * s);
      glowGrad.addColorStop(0, "rgba(230, 160, 100, 0.45)");
      glowGrad.addColorStop(0.35, "rgba(180, 100, 70, 0.28)");
      glowGrad.addColorStop(0.7, "rgba(80, 140, 160, 0.15)");
      glowGrad.addColorStop(1, "rgba(0, 0, 0, 0)");

      ctx.beginPath();
      ctx.arc(cx, cy, 120 * s, 0, Math.PI * 2);
      ctx.fillStyle = glowGrad;
      ctx.fill();

      // Left Pillar (Largest Column)
      ctx.beginPath();
      ctx.moveTo(cx - 38 * s, cy + 90 * s);
      ctx.quadraticCurveTo(cx - 42 * s, cy + 20 * s, cx - 32 * s, cy - 30 * s);
      ctx.bezierCurveTo(cx - 30 * s, cy - 65 * s, cx - 18 * s, cy - 75 * s, cx - 10 * s, cy - 65 * s);
      ctx.quadraticCurveTo(cx - 8 * s, cy - 40 * s, cx - 14 * s, cy + 10 * s);
      ctx.quadraticCurveTo(cx - 16 * s, cy + 60 * s, cx - 12 * s, cy + 90 * s);
      ctx.closePath();
      ctx.fillStyle = "#1e130b";
      ctx.fill();
      ctx.strokeStyle = "rgba(240, 185, 125, 0.75)";
      ctx.lineWidth = 1.8 * s;
      ctx.stroke();

      // Center Pillar (Intermediate Column)
      ctx.beginPath();
      ctx.moveTo(cx - 6 * s, cy + 90 * s);
      ctx.quadraticCurveTo(cx - 4 * s, cy + 40 * s, cx + 5 * s, cy - 10 * s);
      ctx.bezierCurveTo(cx + 8 * s, cy - 35 * s, cx + 18 * s, cy - 38 * s, cx + 22 * s, cy - 25 * s);
      ctx.quadraticCurveTo(cx + 20 * s, cy + 10 * s, cx + 18 * s, cy + 90 * s);
      ctx.closePath();
      ctx.fillStyle = "#180f08";
      ctx.fill();
      ctx.strokeStyle = "rgba(240, 185, 125, 0.65)";
      ctx.lineWidth = 1.5 * s;
      ctx.stroke();

      // Right Pillar (Finger / Spire Column)
      ctx.beginPath();
      ctx.moveTo(cx + 26 * s, cy + 90 * s);
      ctx.quadraticCurveTo(cx + 28 * s, cy + 50 * s, cx + 38 * s, cy + 15 * s);
      ctx.bezierCurveTo(cx + 42 * s, cy - 2 * s, cx + 52 * s, cy - 5 * s, cx + 52 * s, cy + 12 * s);
      ctx.quadraticCurveTo(cx + 46 * s, cy + 45 * s, cx + 44 * s, cy + 90 * s);
      ctx.closePath();
      ctx.fillStyle = "#150d07";
      ctx.fill();
      ctx.strokeStyle = "rgba(240, 185, 125, 0.6)";
      ctx.lineWidth = 1.4 * s;
      ctx.stroke();

      // Young massive stars of cluster NGC 6611 sculpting the pillars
      const clusterStars = [
        { x: -18, y: -80, r: 2.2, c: "#ffffff" },
        { x: 15, y: -45, r: 1.8, c: "#d8eeff" },
        { x: 45, y: -15, r: 1.6, c: "#fff2db" },
        { x: -35, y: -10, r: 1.4, c: "#ffffff" },
        { x: 5, y: -85, r: 2.5, c: "#badeff" }
      ];
      clusterStars.forEach(cs => {
        draw5PointStar(ctx, cx + cs.x * s, cy + cs.y * s, cs.r * 2.2 * s, cs.r * 0.9 * s, cs.c);
      });

      ctx.restore();
    }

    function renderJupiter(ctx: CanvasRenderingContext2D, cx: number, cy: number, scale: number) {
      const r = Math.max(28, 48 * scale);

      const grad = ctx.createRadialGradient(cx - r * 0.25, cy - r * 0.25, r * 0.1, cx, cy, r);
      grad.addColorStop(0, "#f3ebdd");
      grad.addColorStop(0.5, "#d7be99");
      grad.addColorStop(0.85, "#a27a52");
      grad.addColorStop(1, "#180e06");

      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.fillStyle = grad;
      ctx.fill();
      ctx.clip();

      const bands = [
        { y: -0.7, h: 0.18, c: "rgba(164, 118, 82, 0.45)" },
        { y: -0.42, h: 0.22, c: "rgba(132, 85, 52, 0.6)" },
        { y: -0.1, h: 0.14, c: "rgba(230, 215, 190, 0.3)" },
        { y: 0.15, h: 0.25, c: "rgba(150, 95, 60, 0.65)" },
        { y: 0.55, h: 0.2, c: "rgba(160, 115, 80, 0.4)" }
      ];

      bands.forEach(b => {
        ctx.fillStyle = b.c;
        ctx.fillRect(cx - r, cy + b.y * r, r * 2, b.h * r);
      });

      const grsX = cx + r * 0.32;
      const grsY = cy + r * 0.26;
      ctx.beginPath();
      ctx.ellipse(grsX, grsY, r * 0.24, r * 0.14, 0.08, 0, Math.PI * 2);
      ctx.fillStyle = "rgba(195, 82, 54, 0.85)";
      ctx.fill();
      ctx.strokeStyle = "rgba(140, 48, 30, 0.6)";
      ctx.lineWidth = 1.5;
      ctx.stroke();

      ctx.restore();

      const moons = [
        { name: "Io", dist: -r * 2.2, size: 2.2, color: "#fff0a0" },
        { name: "Europa", dist: -r * 1.4, size: 1.8, color: "#ffffff" },
        { name: "Ganymede", dist: r * 1.8, size: 2.8, color: "#d8dce2" },
        { name: "Callisto", dist: r * 2.8, size: 2.4, color: "#9ca5b2" }
      ];

      moons.forEach(m => {
        const mx = cx + m.dist;
        const my = cy + m.dist * 0.08;
        ctx.beginPath();
        ctx.arc(mx, my, m.size, 0, Math.PI * 2);
        ctx.fillStyle = m.color;
        ctx.fill();

        ctx.font = '8px "Space Mono", monospace';
        ctx.fillStyle = "rgba(255, 255, 255, 0.65)";
        ctx.fillText(m.name, mx - 8, my + 11);
      });
    }

    function renderSaturn(ctx: CanvasRenderingContext2D, cx: number, cy: number, scale: number) {
      const r = Math.max(22, 38 * scale);
      const ringTilt = 0.28;

      ctx.save();
      ctx.beginPath();
      ctx.ellipse(cx, cy, r * 2.6, r * 0.8, ringTilt, Math.PI, Math.PI * 2);
      ctx.strokeStyle = "rgba(215, 195, 150, 0.55)";
      ctx.lineWidth = r * 0.55;
      ctx.stroke();
      ctx.restore();

      const grad = ctx.createRadialGradient(cx - r * 0.2, cy - r * 0.2, r * 0.1, cx, cy, r);
      grad.addColorStop(0, "#faeec8");
      grad.addColorStop(0.6, "#e4ce98");
      grad.addColorStop(0.9, "#ab925c");
      grad.addColorStop(1, "#181206");

      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.fillStyle = grad;
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      ctx.ellipse(cx, cy, r * 2.6, r * 0.8, ringTilt, 0, Math.PI);
      ctx.strokeStyle = "rgba(230, 210, 165, 0.85)";
      ctx.lineWidth = r * 0.55;
      ctx.stroke();

      ctx.beginPath();
      ctx.ellipse(cx, cy, r * 2.6, r * 0.8, ringTilt, 0, Math.PI);
      ctx.strokeStyle = "rgba(0, 0, 0, 0.9)";
      ctx.lineWidth = 2.5;
      ctx.stroke();
      ctx.restore();

      const titanX = cx + r * 3.4;
      const titanY = cy - r * 0.8;
      ctx.beginPath();
      ctx.arc(titanX, titanY, 2.5, 0, Math.PI * 2);
      ctx.fillStyle = "#ffcc66";
      ctx.fill();
      ctx.font = '8px "Space Mono", monospace';
      ctx.fillStyle = "rgba(255, 255, 255, 0.65)";
      ctx.fillText("Titan", titanX + 5, titanY + 3);
    }

    function renderMars(ctx: CanvasRenderingContext2D, cx: number, cy: number, scale: number) {
      const r = Math.max(18, 32 * scale);

      const grad = ctx.createRadialGradient(cx - r * 0.3, cy - r * 0.3, r * 0.1, cx, cy, r);
      grad.addColorStop(0, "#f08558");
      grad.addColorStop(0.6, "#d15632");
      grad.addColorStop(0.85, "#8a2b16");
      grad.addColorStop(1, "#150604");

      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.fillStyle = grad;
      ctx.fill();
      ctx.clip();

      ctx.beginPath();
      ctx.ellipse(cx + r * 0.15, cy + r * 0.1, r * 0.45, r * 0.32, 0.3, 0, Math.PI * 2);
      ctx.fillStyle = "rgba(65, 30, 20, 0.55)";
      ctx.fill();

      ctx.beginPath();
      ctx.ellipse(cx - r * 0.05, cy - r * 0.78, r * 0.35, r * 0.14, 0, 0, Math.PI * 2);
      ctx.fillStyle = "#ffffff";
      ctx.fill();

      ctx.restore();
    }

    function renderM42Nebula(ctx: CanvasRenderingContext2D, cx: number, cy: number, scale: number) {
      const r = 85 * scale;
      const cloudGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);
      cloudGrad.addColorStop(0, "rgba(180, 240, 255, 0.85)");
      cloudGrad.addColorStop(0.25, "rgba(120, 210, 230, 0.45)");
      cloudGrad.addColorStop(0.55, "rgba(215, 120, 180, 0.2)");
      cloudGrad.addColorStop(1, "rgba(0, 0, 0, 0)");

      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.fillStyle = cloudGrad;
      ctx.fill();

      const trap = [
        { x: -5, y: -4 }, { x: 4, y: -6 }, { x: 5, y: 5 }, { x: -4, y: 4 }
      ];
      trap.forEach(t => {
        draw5PointStar(ctx, cx + t.x * scale, cy + t.y * scale, 3.5 * scale, 1.5 * scale, "#ffffff");
      });
      ctx.font = '8px "Space Mono", monospace';
      ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
      ctx.fillText("Trapezium Cluster", cx + 12 * scale, cy - 8 * scale);
    }

    // 8. ANIMATION LOOP
    function render() {
      requestAnimationFrame(render);

      camYaw += (targetYaw - camYaw) * 0.08;
      camPitch += (targetPitch - camPitch) * 0.08;
      currentZoom += (targetZoom - currentZoom) * 0.08;

      ctx.fillStyle = "#000000";
      ctx.fillRect(0, 0, width, height);

      const cx = width * 0.5;
      const cy = height * 0.5;

      // A. Background Passing Stars (Calm Ambient Cosmic Drift)
      for (let i = 0; i < backgroundStars.length; i++) {
        const s = backgroundStars[i];
        s.z -= 0.65;

        if (s.z <= 20) {
          s.z = 2400;
          s.x = (Math.random() - 0.5) * 2600;
          s.y = (Math.random() - 0.5) * 2600;
        }

        const curr = project3D(s.x, s.y, s.z, cx, cy);
        if (!curr) continue;

        ctx.beginPath();
        ctx.arc(curr.sx, curr.sy, Math.max(0.6, s.size * curr.scale), 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 255, ${s.alpha})`;
        ctx.fill();
      }

      // B. Andromeda Galaxy (M31) with Keplerian Rotation & Mouse Reactivity
      const m31Center = project3D(-620, -80, 950, cx, cy);
      if (m31Center) {
        const mDist = Math.hypot(mouseX - m31Center.sx, mouseY - m31Center.sy);
        const mouseGravFactor = Math.max(0, 1 - mDist / 400);
        const reactiveSpeedBoost = 1 + mouseGravFactor * 3.5;

        const coreRadius = (isHighZoom ? 110 : 70) * m31Center.scale;
        const coreGrad = ctx.createRadialGradient(m31Center.sx, m31Center.sy, 0, m31Center.sx, m31Center.sy, coreRadius);
        coreGrad.addColorStop(0, "rgba(255, 255, 255, 0.85)");
        coreGrad.addColorStop(0.2, "rgba(235, 245, 255, 0.55)");
        coreGrad.addColorStop(0.6, "rgba(180, 210, 255, 0.15)");
        coreGrad.addColorStop(1, "rgba(0, 0, 0, 0)");

        ctx.beginPath();
        ctx.arc(m31Center.sx, m31Center.sy, coreRadius, 0, Math.PI * 2);
        ctx.fillStyle = coreGrad;
        ctx.fill();

        for (let i = 0; i < andromedaParticles.length; i++) {
          const p = andromedaParticles[i];
          p.angle += p.angularSpeed * reactiveSpeedBoost;

          let gx = Math.cos(p.angle) * p.radius * 1.9;
          let gy = Math.sin(p.angle) * p.radius * 0.65;
          let gz = p.thickness;

          if (mouseGravFactor > 0.05) {
            gx += (mouseX - m31Center.sx) * 0.08 * mouseGravFactor;
            gy += (mouseY - m31Center.sy) * 0.08 * mouseGravFactor;
          }

          const cosTX = Math.cos(galaxyTiltX);
          const sinTX = Math.sin(galaxyTiltX);
          const cosTY = Math.cos(galaxyTiltY);
          const sinTY = Math.sin(galaxyTiltY);

          const x3d = p.baseX + (gx * cosTY + gz * sinTY);
          const y3d = p.baseY + (gy * cosTX - (gx * sinTY - gz * cosTY) * sinTX);
          const z3d = p.baseZ + (gy * sinTX + (gx * sinTY - gz * cosTY) * cosTX);

          const proj = project3D(x3d, y3d, z3d, cx, cy);
          if (!proj) continue;

          ctx.beginPath();
          ctx.arc(proj.sx, proj.sy, Math.max(0.7, p.size * proj.scale), 0, Math.PI * 2);
          ctx.fillStyle = p.isCore ? "rgba(255, 255, 255, 0.9)" : `rgba(215, 232, 255, ${p.alpha})`;
          ctx.fill();
        }

        ctx.font = '10px "Space Mono", monospace';
        ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
        ctx.fillText("M31 • Andromeda Galaxy", m31Center.sx + 45 * m31Center.scale, m31Center.sy - 25 * m31Center.scale);
      }

      // B2. Whirlpool Galaxy (M51 & NGC 5195) with Grand Design Spiral Rotation
      const m51Center = project3D(m51BaseX, m51BaseY, m51BaseZ, cx, cy);
      if (m51Center) {
        const mDist51 = Math.hypot(mouseX - m51Center.sx, mouseY - m51Center.sy);
        const mouseFactor51 = Math.max(0, 1 - mDist51 / 400);
        const speedBoost51 = 1 + mouseFactor51 * 3.0;

        // 1. Luminous Main Core (M51 / NGC 5194)
        const coreR51 = (isHighZoom ? 95 : 55) * m51Center.scale;
        const coreGrad51 = ctx.createRadialGradient(m51Center.sx, m51Center.sy, 0, m51Center.sx, m51Center.sy, coreR51);
        coreGrad51.addColorStop(0, "rgba(255, 255, 255, 0.95)");
        coreGrad51.addColorStop(0.22, "rgba(210, 235, 255, 0.65)");
        coreGrad51.addColorStop(0.6, "rgba(130, 175, 245, 0.2)");
        coreGrad51.addColorStop(1, "rgba(0, 0, 0, 0)");
        ctx.beginPath();
        ctx.arc(m51Center.sx, m51Center.sy, coreR51, 0, Math.PI * 2);
        ctx.fillStyle = coreGrad51;
        ctx.fill();

        // 2. Companion Galaxy NGC 5195 Core
        const compProj = project3D(m51BaseX + 68, m51BaseY - 44, m51BaseZ, cx, cy);
        if (compProj) {
          const compR = (isHighZoom ? 45 : 26) * compProj.scale;
          const compGrad = ctx.createRadialGradient(compProj.sx, compProj.sy, 0, compProj.sx, compProj.sy, compR);
          compGrad.addColorStop(0, "rgba(255, 245, 215, 0.9)");
          compGrad.addColorStop(0.35, "rgba(255, 210, 140, 0.45)");
          compGrad.addColorStop(0.7, "rgba(210, 160, 90, 0.12)");
          compGrad.addColorStop(1, "rgba(0, 0, 0, 0)");
          ctx.beginPath();
          ctx.arc(compProj.sx, compProj.sy, compR, 0, Math.PI * 2);
          ctx.fillStyle = compGrad;
          ctx.fill();
        }

        // 3. Render Whirlpool Particles (Spiral arms, starburst knots, and tidal bridge)
        for (let i = 0; i < whirlpoolParticles.length; i++) {
          const p = whirlpoolParticles[i];
          p.angle += p.angularSpeed * speedBoost51;

          let gx = p.isCompanion
            ? p.offsetX + Math.cos(p.angle) * p.radius
            : Math.cos(p.angle) * p.radius + p.offsetX;
          let gy = p.isCompanion
            ? p.offsetY + Math.sin(p.angle) * p.radius * 0.8
            : Math.sin(p.angle) * p.radius + p.offsetY;
          let gz = (Math.sin(p.angle * 2) * 8);

          if (mouseFactor51 > 0.05) {
            gx += (mouseX - m51Center.sx) * 0.06 * mouseFactor51;
            gy += (mouseY - m51Center.sy) * 0.06 * mouseFactor51;
          }

          const tiltX = 18 * (Math.PI / 180);
          const tiltY = 12 * (Math.PI / 180);
          const cosTX = Math.cos(tiltX), sinTX = Math.sin(tiltX);
          const cosTY = Math.cos(tiltY), sinTY = Math.sin(tiltY);

          const x3d = p.baseX + (gx * cosTY + gz * sinTY);
          const y3d = p.baseY + (gy * cosTX - (gx * sinTY - gz * cosTY) * sinTX);
          const z3d = p.baseZ + (gy * sinTX + (gx * sinTY - gz * cosTY) * cosTX);

          const proj = project3D(x3d, y3d, z3d, cx, cy);
          if (!proj) continue;

          ctx.beginPath();
          ctx.arc(proj.sx, proj.sy, Math.max(0.65, p.size * proj.scale), 0, Math.PI * 2);
          ctx.fillStyle = p.color;
          ctx.globalAlpha = p.alpha;
          ctx.fill();
        }
        ctx.globalAlpha = 1.0;

        if (!isHighZoom) {
          ctx.font = '10px "Space Mono", monospace';
          ctx.fillStyle = "rgba(255, 255, 255, 0.8)";
          ctx.fillText("M51 • Whirlpool Galaxy & NGC 5195", m51Center.sx + 40 * m51Center.scale, m51Center.sy - 30 * m51Center.scale);
        }
      }

      // C. Render All Constellations in 3D
      allConstellations.forEach(constel => {
        const projStars = constel.stars.map(s => project3D(s.x, s.y, s.z, cx, cy));

        constel.lines.forEach(([iA, iB]) => {
          const pA = projStars[iA];
          const pB = projStars[iB];
          if (!pA || !pB) return;

          const isPolarisPointer = (constel.name.includes("Ursa Major") && iA === 4 && iB === 7);

          ctx.beginPath();
          ctx.moveTo(pA.sx, pA.sy);
          ctx.lineTo(pB.sx, pB.sy);
          ctx.strokeStyle = isPolarisPointer ? "rgba(255, 255, 255, 0.55)" : "rgba(255, 255, 255, 0.26)";
          ctx.lineWidth = isPolarisPointer ? 1.5 : 1.1;

          if (isPolarisPointer) {
            ctx.setLineDash([5, 6]);
          } else {
            ctx.setLineDash([]);
          }
          ctx.stroke();
          ctx.setLineDash([]);
        });

        projStars.forEach((p, idx) => {
          if (!p) return;
          const s = constel.stars[idx];
          const r = s.size * p.scale;

          const halo = ctx.createRadialGradient(p.sx, p.sy, 0, p.sx, p.sy, r * 3.6);
          halo.addColorStop(0, s.color || "rgba(255, 255, 255, 0.85)");
          halo.addColorStop(0.35, "rgba(255, 255, 255, 0.2)");
          halo.addColorStop(1, "rgba(0, 0, 0, 0)");

          ctx.beginPath();
          ctx.arc(p.sx, p.sy, r * 3.6, 0, Math.PI * 2);
          ctx.fillStyle = halo;
          ctx.fill();

          draw5PointStar(ctx, p.sx, p.sy, r * 1.6, r * 0.75, s.color || "#ffffff");

          if (s.isBinary && isHighZoom) {
            const splitOffset = s.id === 'mizar' ? 24 : 18;
            const compX = p.sx + splitOffset * p.scale;
            const compY = p.sy - splitOffset * 0.75 * p.scale;
            const compColor = s.id === 'albireo' ? "#9ac5ff" : "rgba(240, 245, 255, 0.85)";
            draw5PointStar(ctx, compX, compY, r * 1.0, r * 0.5, compColor);

            ctx.font = '9px "Space Mono", monospace';
            ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
            ctx.fillText(s.id === 'mizar' ? "Alcor (80 UMa)" : "Albireo B (Blue)", compX + 10, compY + 3);
            ctx.fillText(s.id === 'mizar' ? "Mizar A & B (Split)" : "Albireo A (Gold)", p.sx + 12, p.sy + 12);
          } else if (currentZoom > 0.85) {
            ctx.font = '10px "Space Mono", monospace';
            ctx.fillStyle = "rgba(255, 255, 255, 0.8)";
            ctx.fillText(s.name, p.sx + r + 6, p.sy + 3);
          }
        });
      });

      // D. RENDER ALL MYSTERY CELESTIAL OBJECTS (WITH INTENSE PRESENCE)
      allMysteryTargets.forEach(m => {
        const proj = project3D(m.x, m.y, m.z, cx, cy);
        if (!proj) return;

        const isCurrentActive = activeMystery && activeMystery.id === m.id;
        const pulse = (Math.sin(Date.now() * 0.005 + m.x) + 1) * 0.5;

        // IN 20x FINDER MODE: Every mystery object has unmistakable presence
        if (!isHighZoom) {
          // 1. Broad Volumetric Nebular / Atmospheric Cloud
          const auraRadius = (m.type === 'pillars_m16' || m.type === 'nebula_m42' || m.type === 'galaxy_m51') ? 36 : 24;
          const auraGrad = ctx.createRadialGradient(proj.sx, proj.sy, 0, proj.sx, proj.sy, auraRadius);
          auraGrad.addColorStop(0, m.beaconColor);
          auraGrad.addColorStop(0.35, `rgba(255, 255, 255, ${0.35 + pulse * 0.3})`);
          auraGrad.addColorStop(0.7, `rgba(200, 225, 255, ${0.12 + pulse * 0.1})`);
          auraGrad.addColorStop(1, "rgba(0, 0, 0, 0)");

          ctx.beginPath();
          ctx.arc(proj.sx, proj.sy, auraRadius, 0, Math.PI * 2);
          ctx.fillStyle = auraGrad;
          ctx.fill();

          // 2. Optical Diffraction Needle Spikes (4-point cross for celestial objects)
          ctx.strokeStyle = `rgba(255, 255, 255, ${0.4 + pulse * 0.4})`;
          ctx.lineWidth = 1.0;
          const spikeLen = 14 + pulse * 6;
          ctx.beginPath();
          ctx.moveTo(proj.sx - spikeLen, proj.sy);
          ctx.lineTo(proj.sx + spikeLen, proj.sy);
          ctx.moveTo(proj.sx, proj.sy - spikeLen);
          ctx.lineTo(proj.sx, proj.sy + spikeLen);
          ctx.stroke();

          // 3. Central bright nucleus
          ctx.beginPath();
          ctx.arc(proj.sx, proj.sy, (m.discovered ? 4.2 : 3.4) + pulse * 1.2, 0, Math.PI * 2);
          ctx.fillStyle = "#ffffff";
          ctx.fill();

          // 4. Optical targeting bracket & radar sweep ring for active target
          if (isCurrentActive) {
            ctx.strokeStyle = `rgba(255, 255, 255, ${0.6 + pulse * 0.4})`;
            ctx.lineWidth = 1.3;
            const b = 18;
            // 4 corner brackets
            ctx.beginPath();
            ctx.moveTo(proj.sx - b, proj.sy - b + 6); ctx.lineTo(proj.sx - b, proj.sy - b); ctx.lineTo(proj.sx - b + 6, proj.sy - b);
            ctx.moveTo(proj.sx + b - 6, proj.sy - b); ctx.lineTo(proj.sx + b, proj.sy - b); ctx.lineTo(proj.sx + b, proj.sy - b + 6);
            ctx.moveTo(proj.sx - b, proj.sy + b - 6); ctx.lineTo(proj.sx - b, proj.sy + b); ctx.lineTo(proj.sx - b + 6, proj.sy + b);
            ctx.moveTo(proj.sx + b - 6, proj.sy + b); ctx.lineTo(proj.sx + b, proj.sy + b); ctx.lineTo(proj.sx + b, proj.sy + b - 6);
            ctx.stroke();

            // Expanding telemetry radar circle
            const radarR = 12 + (Date.now() % 1600) * 0.015;
            const radarAlpha = Math.max(0, 1 - radarR / 36);
            ctx.beginPath();
            ctx.arc(proj.sx, proj.sy, radarR, 0, Math.PI * 2);
            ctx.strokeStyle = `rgba(255, 255, 255, ${radarAlpha * 0.6})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }

          // 5. Scientific Tag Label
          ctx.font = '10px "Space Mono", monospace';
          ctx.fillStyle = m.discovered ? "rgba(255, 255, 255, 0.95)" : "rgba(255, 255, 255, 0.75)";
          ctx.fillText(
            m.discovered ? m.name : `[Anomaly: ${m.name.split(' ')[0]}]`,
            proj.sx + 24,
            proj.sy + 4
          );
        }
        // IN 150x HIGH ZOOM MODE: Fully resolved procedural rendering
        else {
          if (m.type === 'pillars_m16') {
            renderPillarsOfCreation(ctx, proj.sx, proj.sy, proj.scale);
          } else if (m.type === 'planet_jupiter') {
            renderJupiter(ctx, proj.sx, proj.sy, proj.scale);
          } else if (m.type === 'planet_saturn') {
            renderSaturn(ctx, proj.sx, proj.sy, proj.scale);
          } else if (m.type === 'planet_mars') {
            renderMars(ctx, proj.sx, proj.sy, proj.scale);
          } else if (m.type === 'nebula_m42') {
            renderM42Nebula(ctx, proj.sx, proj.sy, proj.scale);
          } else if (m.type === 'galaxy_m51') {
            // Rendered with 1,200 particle grand design spiral in Section B2
          }

          ctx.font = '11px "Space Mono", monospace';
          ctx.fillStyle = "#ffffff";
          ctx.fillText(m.name, proj.sx + 50, proj.sy + 4);
        }
      });

      // E. Update Reticle Lock & Direction Arrow for Active Hunt Target
      if (activeMystery) {
        const proj = project3D(activeMystery.x, activeMystery.y, activeMystery.z, cx, cy);
        if (proj) {
          const distFromReticle = Math.hypot(proj.sx - cx, proj.sy - cy);
          const alignPercent = Math.max(0, Math.min(100, Math.round(100 - (distFromReticle / (width * 0.4)) * 100)));
          if (hudReticleDist) hudReticleDist.textContent = `ALIGNMENT: ${alignPercent}%`;

          const alignThreshold = isHighZoom ? 65 : 42;
          isTargetCentered = distFromReticle < alignThreshold;

          if (hudLockStatus) {
            if (isTargetCentered) {
              hudLockStatus.textContent = isHighZoom ? "DISCOVERY VERIFIED" : "CENTER LOCKED";
              hudLockStatus.className = "px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-white text-black animate-pulse shadow-sm";
            } else if (distFromReticle < 220) {
              hudLockStatus.textContent = "IN VIEWPORT";
              hudLockStatus.className = "px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-white/20 text-white";
            } else {
              hudLockStatus.textContent = "SEARCHING";
              hudLockStatus.className = "px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-white/10 text-slate-300 border border-white/15";
            }
          }

          // Trigger Discovery Event when centered in 150x High Zoom
          if (isTargetCentered && isHighZoom && !activeMystery.discovered) {
            activeMystery.discovered = true;
            if (discoveryTitle) discoveryTitle.textContent = activeMystery.name.toUpperCase();
            discoveryBanner?.classList.remove("opacity-0", "-translate-y-4", "pointer-events-none");
            discoveryBanner?.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
            showTelemetryCard(activeMystery, true);
            updateMissionHUD();
          }

          // Direction Arrow HUD: hide when in viewport
          if (targetDirArrow) {
            if (distFromReticle > width * 0.38) {
              const angle = Math.atan2(proj.sy - cy, proj.sx - cx);
              targetDirArrow.style.transform = `translate(-50%, -50%) rotate(${angle + Math.PI / 2}rad)`;
              targetDirArrow.classList.remove("opacity-0");
              targetDirArrow.classList.add("opacity-100");
              if (targetDirLabel) targetDirLabel.textContent = `ANOMALY: ${Math.round(distFromReticle * 0.1)}°`;
            } else {
              targetDirArrow.classList.add("opacity-0");
              targetDirArrow.classList.remove("opacity-100");
            }
          }
        }
      }
    }

    // Launch render loop
    render();
    updateMissionHUD();
  }
</script>
