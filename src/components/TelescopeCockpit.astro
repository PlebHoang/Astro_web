---
interface Props {
  mode?: 'background' | 'standalone';
}

const { mode = 'standalone' } = Astro.props;
const isBackground = mode === 'background';
---

<div class="telescope-container relative w-full min-h-screen overflow-x-hidden bg-black font-sans select-none" data-mode={mode}>
  <!-- Floating Mode Switcher Button (Always accessible on Homepage) -->
  {isBackground && (
    <div class="fixed top-3.5 right-4 sm:right-6 z-50 flex items-center gap-2">
      <button
        type="button"
        id="btn-stargaze-toggle"
        class="px-3.5 py-1.5 sm:py-2 rounded-xl bg-black/85 hover:bg-black text-white border border-white/25 hover:border-white shadow-[0_4px_25px_rgba(0,0,0,0.8)] backdrop-blur-xl font-orbitron text-xs font-bold transition flex items-center gap-2 cursor-pointer group hover:scale-105 active:scale-95"
        title="Toggle between Stargaze Cockpit and Website Reading (Hotkey: TAB)"
      >
        <span class="text-sm transition-transform group-hover:rotate-12" id="stargaze-toggle-icon">🔭</span>
        <span id="stargaze-toggle-text">Stargaze Mode</span>
        <kbd class="hidden sm:inline-block text-[9px] font-space-mono bg-white/15 px-1.5 py-0.5 rounded text-slate-300 border border-white/20">TAB</kbd>
      </button>
    </div>
  )}

    <!-- Fullscreen Telescope Canvas -->
    <canvas id="sky-canvas" class="fixed inset-0 w-screen h-screen block cursor-grab active:cursor-grabbing z-0 pointer-events-none"></canvas>

    <!-- Circular Eyepiece Reticle (20x Finder vs 150x High Zoom) -->
    <div class={`eyepiece-overlay fixed inset-0 pointer-events-none z-10 shadow-[inset_0_0_160px_80px_rgba(0,0,0,0.96)] transition-all duration-500 ${isBackground ? 'opacity-0' : 'opacity-100'}`} id="eyepiece-overlay"></div>
    <div class={`eyepiece-circle fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[min(84vh,84vw)] h-[min(84vh,84vw)] rounded-full border border-white/20 shadow-[0_0_0_2500px_rgba(0,0,0,0.72),inset_0_0_60px_rgba(0,0,0,0.92)] pointer-events-none z-10 transition-all duration-500 ${isBackground ? 'opacity-0' : 'opacity-100'}`} id="eyepiece-circle">
      <!-- Reticle Crosshairs & Mil-Dots -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-full h-[1px] bg-gradient-to-r from-transparent via-white/25 to-transparent"></div>
        <div class="h-full w-[1px] bg-gradient-to-b from-transparent via-white/25 to-transparent absolute"></div>
        <div class="w-1/3 h-1/3 rounded-full border border-dashed border-white/20 absolute" id="reticle-inner-ring"></div>
        <div class="w-2/3 h-2/3 rounded-full border border-white/10 absolute" id="reticle-mid-ring"></div>
        <div class="w-16 h-16 rounded-full border border-white/40 absolute opacity-0 transition-opacity duration-300" id="high-zoom-cross">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-2 h-2 rounded-full border border-white/60"></div>
          </div>
        </div>
      </div>
      <!-- Compass Bearings -->
      <span class="absolute top-3 left-1/2 -translate-x-1/2 font-space-mono text-[9px] text-white/50 tracking-widest">N 000°</span>
      <span class="absolute bottom-3 left-1/2 -translate-x-1/2 font-space-mono text-[9px] text-white/50 tracking-widest">S 180°</span>
      <span class="absolute left-3 top-1/2 -translate-y-1/2 font-space-mono text-[9px] text-white/50 tracking-widest">E 090°</span>
      <span class="absolute right-3 top-1/2 -translate-y-1/2 font-space-mono text-[9px] text-white/50 tracking-widest">W 270°</span>
    </div>

    <!-- Directional Target Indicator Arrow (Points to off-screen target in Finder) -->
    <div id="target-dir-arrow" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-52 h-52 pointer-events-none z-20 opacity-0 transition-opacity duration-200">
      <div class="w-full h-full flex items-start justify-center relative">
        <div class="flex flex-col items-center gap-1 -translate-y-7">
          <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-b-[10px] border-b-white animate-bounce"></div>
          <span class="font-space-mono text-[9px] bg-black/85 px-2 py-0.5 rounded border border-white/25 text-white whitespace-nowrap shadow-lg" id="target-dir-label">TARGET</span>
        </div>
      </div>
    </div>

    <!-- Star / Planet / Nebula Information Popup Card -->
    <div id="star-info-card" class="fixed bottom-8 right-8 w-84 bg-black/92 border border-white/25 shadow-[0_20px_50px_rgba(0,0,0,0.9),0_0_30px_rgba(255,255,255,0.12)] rounded-2xl backdrop-blur-2xl p-4.5 z-40 opacity-0 pointer-events-none translate-y-3 transition-all duration-300">
      <div class="flex justify-between items-center pb-2 mb-2.5 border-b border-white/10">
        <div>
          <div class="font-orbitron text-sm font-bold text-white tracking-wide" id="sic-title">Pillars of Creation</div>
          <div class="font-space-mono text-[10px] text-slate-400" id="sic-bayer">M16 • Eagle Nebula</div>
        </div>
        <span class="text-[9px] font-space-mono px-2 py-0.5 rounded bg-white/10 text-slate-300 border border-white/15" id="sic-badge">DEEP-SKY</span>
      </div>
      <div class="grid grid-cols-2 gap-2 font-space-mono text-[10px] mb-2.5">
        <div><span class="text-slate-500 block">DISTANCE</span><strong class="text-slate-200" id="sic-dist">6,500 ly</strong></div>
        <div><span class="text-slate-500 block">SIZE / SPEC</span><strong class="text-slate-200" id="sic-spec">4-5 ly Spire Height</strong></div>
        <div><span class="text-slate-500 block">MAGNITUDE</span><strong class="text-slate-200" id="sic-mag">+6.00</strong></div>
        <div><span class="text-slate-500 block">CLASSIFICATION</span><strong class="text-slate-200" id="sic-role">Elephant Trunk Nursery</strong></div>
      </div>
      <div class="text-[11px] leading-relaxed text-slate-300 font-inter mb-3" id="sic-desc">
        Towering spires of interstellar molecular gas and dust in the Eagle Nebula. In 150x zoom, you can see newborn protostars evaporating gas fingers into space.
      </div>
      <button type="button" id="sic-close-btn" class="w-full py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white font-space-mono text-[10px] uppercase tracking-wider border border-white/15 transition">
        Close Telemetry [✕]
      </button>
    </div>

    <!-- Discovery Unlocked Fanfare Banner -->
    <div id="discovery-banner" class="fixed top-24 left-1/2 -translate-x-1/2 bg-black/95 border border-white/35 shadow-[0_0_40px_rgba(255,255,255,0.25)] rounded-2xl px-6 py-3.5 z-40 opacity-0 pointer-events-none -translate-y-4 transition-all duration-400 flex items-center gap-4">
      <div class="w-10 h-10 rounded-xl bg-white text-black font-orbitron font-black text-lg flex items-center justify-center shrink-0">
        🔭
      </div>
      <div>
        <div class="text-[9px] font-space-mono text-slate-400 uppercase tracking-widest">DISCOVERY CONFIRMED IN 150X HIGH ZOOM</div>
        <div class="font-orbitron font-bold text-sm text-white tracking-wide" id="discovery-title">PILLARS OF CREATION (M16)</div>
      </div>
      <button type="button" id="btn-next-hunt" class="ml-3 px-3 py-1.5 rounded-lg bg-white text-black font-orbitron text-[10px] font-bold uppercase tracking-wider hover:bg-slate-200 transition">
        Next Target →
      </button>
    </div>

    <!-- Optical Mode HUD Toast (Instant Feedback on [1] and [2] switch) -->
    <div id="zoom-mode-toast" class="fixed top-20 left-1/2 -translate-x-1/2 bg-black/95 border border-white/40 shadow-[0_0_25px_rgba(255,255,255,0.3)] rounded-full px-5 py-2 z-40 opacity-0 pointer-events-none -translate-y-2 transition-all duration-200 flex items-center gap-2.5 font-space-mono text-xs font-bold text-white tracking-wider">
      <span id="toast-icon">🔭</span>
      <span id="toast-text">20x FINDER ENGAGED</span>
    </div>

    

    <!-- UI Control Deck (PINNED STRICTLY TO PERIMETER EDGES - ZERO CENTER INTERFERENCE) -->
    <div id="cockpit-ui" class={`fixed inset-0 z-30 pointer-events-none flex flex-col justify-between p-3 sm:p-5 transition-opacity duration-500 ${isBackground ? "opacity-0 pointer-events-none" : "opacity-100"}`}>
      
      <!-- TOP CONTROL DECK: Slim Single-Row Cockpit Header -->
      <header class="flex flex-wrap items-center justify-between gap-3 w-full bg-black/85 px-4 py-2 rounded-2xl border border-white/15 backdrop-blur-2xl pointer-events-auto shadow-2xl">
        <!-- Brand & Main Portal Link -->
        <div class="flex items-center gap-3">
          {isBackground ? (
            <button
              type="button"
              id="btn-cockpit-exit"
              class="px-3 py-1 rounded-lg bg-white/10 hover:bg-white/20 border border-white/20 text-xs font-space-mono text-white transition flex items-center gap-1.5 cursor-pointer"
            >
              <span>← Read Website</span>
            </button>
          ) : (
            <a href="/" class="px-3 py-1 rounded-lg bg-white/5 hover:bg-white/10 border border-white/15 text-xs font-space-mono text-slate-300 hover:text-white transition">
              ← Main Portal
            </a>
          )}
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-orbitron text-xs font-black tracking-wider text-white uppercase">CUB TELESCOPE LAB</span>
              <span class="px-1.5 py-0.2 rounded text-[8px] font-space-mono bg-white/10 text-slate-300 border border-white/15">V3.3</span>
            </div>
          </div>
        </div>

        <!-- Stargazing Controls & High-Contrast Animated Scope Keys [ 1 ] & [ 2 ] -->
        <div class="flex items-center gap-2">
          <!-- Tactile Dual Scope Keys [1] and [2] -->
          <div class="flex items-center bg-[#070707] p-1 rounded-xl border border-white/30 shadow-[0_0_15px_rgba(0,0,0,0.8)]">
            <!-- Key 1: 20x Finder -->
            <button
              type="button"
              id="scope-btn-20x"
              class="scope-key-btn active px-3 py-1.5 rounded-lg font-space-mono text-xs font-bold transition-all duration-150 flex items-center gap-2 bg-white text-black shadow-[0_0_12px_rgba(255,255,255,0.4)] cursor-pointer select-none"
            >
              <kbd id="key-cap-1" class="flex items-center justify-center w-5 h-5 rounded bg-black text-white border border-black font-mono text-[10px] font-black shadow-[0_1.5px_0_rgba(255,255,255,0.3)] transition-all pointer-events-none">
                1
              </kbd>
              <span class="font-orbitron text-[10px] font-bold tracking-wider pointer-events-none">20x FINDER</span>
              <span id="led-1" class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_6px_#34d399] animate-pulse pointer-events-none"></span>
            </button>

            <!-- Key 2: 150x High Zoom -->
            <button
              type="button"
              id="scope-btn-150x"
              class="scope-key-btn px-3 py-1.5 rounded-lg font-space-mono text-xs font-bold transition-all duration-150 flex items-center gap-2 text-slate-300 hover:text-white hover:bg-white/5 cursor-pointer select-none"
            >
              <kbd id="key-cap-2" class="flex items-center justify-center w-5 h-5 rounded bg-white/15 text-white border border-white/25 font-mono text-[10px] font-black shadow-[0_1.5px_0_rgba(255,255,255,0.15)] transition-all pointer-events-none">
                2
              </kbd>
              <span class="font-orbitron text-[10px] font-bold tracking-wider pointer-events-none">150x ZOOM</span>
              <span id="led-2" class="w-2 h-2 rounded-full bg-white/20 transition-all pointer-events-none"></span>
            </button>
          </div>

          <!-- New Anomaly Spawner -->
          <button type="button" id="btn-spawn-target" class="px-3 py-1.5 rounded-xl font-space-mono text-xs font-bold transition text-white bg-white/10 border border-white/20 hover:bg-white/20 flex items-center gap-1.5">
            <span>🎲 New Anomaly</span>
          </button>

          <!-- Toggle Website Overlay -->
          <button type="button" id="btn-toggle-preview" class="px-3 py-1.5 rounded-xl font-space-mono text-xs font-bold transition text-slate-300 hover:text-white border border-white/15 hover:bg-white/10">
            <span id="preview-label">👁️ Overlay: OFF</span>
          </button>
        </div>
      </header>

      <!-- BOTTOM REGION: Telemetry & Finder Mission HUD -->
      <footer class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-3 pointer-events-auto">
        <!-- Stargazing Viewfinder Game Status -->
        <div class="p-3.5 rounded-2xl bg-black/90 border border-white/20 backdrop-blur-2xl font-space-mono text-xs text-slate-300 max-w-md w-full shadow-2xl">
          <div class="flex justify-between items-center mb-1">
            <span class="text-[9px] text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
              FINDER MISSION: HUNT UNRESOLVED ANOMALIES
            </span>
            <span class="text-[9px] text-slate-400" id="hud-catalog-count">CATALOG: 0/6 FOUND</span>
          </div>

          <div class="flex items-center justify-between gap-2 my-1">
            <div class="font-orbitron text-sm font-bold text-white tracking-wide" id="hud-mission-name">
              Signal [Pillars of Creation]
            </div>
            <div id="hud-lock-status" class="px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-white/10 text-slate-300 border border-white/15">
              SEARCHING
            </div>
          </div>

          <div class="text-[10px] text-slate-400 mt-0.5" id="hud-mission-hint">
            Press [1] for 20x Finder to locate the beacon. Press [2] for 150x Zoom to resolve!
          </div>

          <div class="mt-2 pt-2 border-t border-white/10 flex items-center justify-between text-[9px] text-slate-400">
            <span>PRESS [1] / [2] TO SWITCH SCOPE • DRAG TO PAN</span>
            <span id="hud-reticle-dist">ALIGNMENT: 0%</span>
          </div>
        </div>

        <!-- Coordinates & Active Constellation Telemetry (Strictly Bottom Right) -->
        <div class="p-3.5 rounded-2xl bg-black/90 border border-white/20 backdrop-blur-2xl font-space-mono text-xs text-slate-300 text-right shadow-2xl">
          <div id="hud-target-name" class="text-[9px] text-slate-500 uppercase tracking-wider mb-0.5">CURRENT FIELD: NORTHERN CIRCUMPOLAR</div>
          <div id="hud-target-coords" class="font-bold text-white font-orbitron text-xs">RA 11h 03m / DEC +55°11' • 5 CONSTELLATIONS</div>
          <div id="hud-target-desc" class="text-[10px] text-slate-400 mt-0.5">Ursa Major, Cassiopeia, Orion, Cygnus & Deep Sky Curiosities</div>
        </div>
      </footer>
    </div>
  
  <!-- Web Content Layer (If Background Mode) -->
  {isBackground ? (
    <div id="web-overlay" class="relative z-20 min-h-screen transition-opacity duration-500 opacity-100 pointer-events-auto">
      <slot />
    </div>
  ) : (
    <slot />
  )}
</div>

<script>
interface StarNode {
    id: string;
    name: string;
    bayer: string;
    dist: string;
    spec: string;
    mag: string;
    role: string;
    desc: string;
    x: number;
    y: number;
    z: number;
    size: number;
    color?: string;
    isBinary?: boolean;
    isPointer?: boolean;
    isPolaris?: boolean;
  }

  interface Constellation {
    name: string;
    stars: StarNode[];
    lines: [number, number][];
    yaw: number;
    pitch: number;
  }

  interface MysteryTarget {
    id: string;
    name: string;
    bayer: string;
    dist: string;
    spec: string;
    mag: string;
    role: string;
    desc: string;
    x: number;
    y: number;
    z: number;
    type: 'pillars_m16' | 'planet_jupiter' | 'planet_saturn' | 'planet_mars' | 'nebula_m42' | 'galaxy_m51';
    discovered: boolean;
    beaconColor: string;
  }

  const canvas = document.getElementById("sky-canvas") as HTMLCanvasElement;
  const ctx = canvas?.getContext("2d");

  const eyepieceCircle = document.getElementById("eyepiece-circle");
  const highZoomCross = document.getElementById("high-zoom-cross");
  const scopeBtn20x = document.getElementById("scope-btn-20x");
  const scopeBtn150x = document.getElementById("scope-btn-150x");
  const keyCap1 = document.getElementById("key-cap-1");
  const keyCap2 = document.getElementById("key-cap-2");
  const led1 = document.getElementById("led-1");
  const led2 = document.getElementById("led-2");

  const btnTogglePreview = document.getElementById("btn-toggle-preview");
  const previewLabel = document.getElementById("preview-label");
  const webPreview = document.getElementById("web-preview");
  const starCard = document.getElementById("star-info-card");
  const sicCloseBtn = document.getElementById("sic-close-btn");
  const targetDirArrow = document.getElementById("target-dir-arrow");
  const targetDirLabel = document.getElementById("target-dir-label");
  const discoveryBanner = document.getElementById("discovery-banner");
  const discoveryTitle = document.getElementById("discovery-title");
  const zoomModeToast = document.getElementById("zoom-mode-toast");
  const toastIcon = document.getElementById("toast-icon");
  const toastText = document.getElementById("toast-text");
  const btnNextHunt = document.getElementById("btn-next-hunt");
  const btnSpawnTarget = document.getElementById("btn-spawn-target");

  const hudMissionName = document.getElementById("hud-mission-name");
  const hudMissionHint = document.getElementById("hud-mission-hint");
  const hudLockStatus = document.getElementById("hud-lock-status");
  const hudReticleDist = document.getElementById("hud-reticle-dist");
  const hudCatalogCount = document.getElementById("hud-catalog-count");

  if (canvas && ctx) {
    // Dual-Mode Overlay Controller
    const container = document.querySelector(".telescope-container") as HTMLElement;
    const isBackgroundMode = container?.dataset.mode === "background";
    const webOverlay = document.getElementById("web-overlay");
    const cockpitUI = document.getElementById("cockpit-ui");
    const btnStargazeToggle = document.getElementById("btn-stargaze-toggle");
    const btnCockpitExit = document.getElementById("btn-cockpit-exit");
    const toggleIcon = document.getElementById("stargaze-toggle-icon");
    const toggleText = document.getElementById("stargaze-toggle-text");

    const eyepieceOverlay = document.getElementById("eyepiece-overlay");
    const eyepieceCircle = document.getElementById("eyepiece-circle");

    function setStargazeMode(active: boolean) {
      isStargazeActive = active;
      if (active) {
        if (webOverlay) {
          webOverlay.classList.remove("opacity-100", "pointer-events-auto");
          webOverlay.classList.add("opacity-0", "pointer-events-none");
        }
        if (cockpitUI) {
          cockpitUI.classList.remove("opacity-0", "pointer-events-none");
          cockpitUI.classList.add("opacity-100");
        }
        if (eyepieceOverlay) {
          eyepieceOverlay.classList.remove("opacity-0");
          eyepieceOverlay.classList.add("opacity-100");
        }
        if (eyepieceCircle) {
          eyepieceCircle.classList.remove("opacity-0");
          eyepieceCircle.classList.add("opacity-100");
        }
        canvas.style.pointerEvents = "auto";
        if (toggleText) toggleText.textContent = "Return to Site";
        if (toggleIcon) toggleIcon.textContent = "📄";
      } else {
        if (webOverlay) {
          webOverlay.classList.remove("opacity-0", "pointer-events-none");
          webOverlay.classList.add("opacity-100", "pointer-events-auto");
        }
        if (cockpitUI) {
          cockpitUI.classList.remove("opacity-100");
          cockpitUI.classList.add("opacity-0", "pointer-events-none");
        }
        if (eyepieceOverlay && isBackgroundMode) {
          eyepieceOverlay.classList.remove("opacity-100");
          eyepieceOverlay.classList.add("opacity-0");
        }
        if (eyepieceCircle && isBackgroundMode) {
          eyepieceCircle.classList.remove("opacity-100");
          eyepieceCircle.classList.add("opacity-0");
        }
        canvas.style.pointerEvents = "none";
        if (toggleText) toggleText.textContent = "Stargaze Mode";
        if (toggleIcon) toggleIcon.textContent = "🔭";
      }
    }

    if (isBackgroundMode) {
      setStargazeMode(false);
      btnStargazeToggle?.addEventListener("click", () => setStargazeMode(!isStargazeActive));
      btnCockpitExit?.addEventListener("click", () => setStargazeMode(false));
      window.addEventListener("keydown", (e) => {
        if (e.key === "Tab") {
          e.preventDefault();
          setStargazeMode(!isStargazeActive);
        } else if (e.key === "Escape" && isStargazeActive) {
          setStargazeMode(false);
        }
      });
      window.addEventListener("toggle-stargaze", () => setStargazeMode(!isStargazeActive));
    } else {
      setStargazeMode(true);
    }

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener("resize", () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    let isHighZoom = false;
    let isPreviewVisible = false; // Hidden by default for clean astronomy view!
    let targetZoom = 1.0;
    let currentZoom = 1.0;

    let camYaw = 0;
    let camPitch = 0;
    let targetYaw = 0;
    let targetPitch = 0;

    let isDragging = false;
    let prevMouseX = 0;
    let prevMouseY = 0;
    let mouseX = -1000;
    let mouseY = -1000;

    // 1. Background Passing Stars (Star Wars Hyperspace Field)
    const starCount = 1100;
    const backgroundStars: any[] = [];
    for (let i = 0; i < starCount; i++) {
      backgroundStars.push({
        x: (Math.random() - 0.5) * 2600,
        y: (Math.random() - 0.5) * 2600,
        z: Math.random() * 2400 + 40,
        pz: 0,
        size: Math.random() * 1.5 + 0.5,
        alpha: Math.random() * 0.7 + 0.3
      });
    }

    // 2. CONSTELLATIONS DATA
    const ursaMajor: Constellation = {
      name: "Ursa Major (The Big Dipper)",
      yaw: 0,
      pitch: 0,
      stars: [
        { id: 'alkaid', name: "Alkaid", bayer: "η Ursae Majoris", dist: "103 ly", spec: "B3 V Blue Dwarf", mag: "+1.86", role: "Tip of Handle", desc: "Hot blue-white hydrogen-fusing star (17,000 K).", x: 190, y: -160, z: 920, size: 4.2 },
        { id: 'mizar', name: "Mizar & Alcor", bayer: "ζ Ursae Majoris", dist: "83 ly", spec: "A2 V + A1 V Binary", mag: "+2.23", role: "Ancient Vision Test Binary", desc: "Telescopic double! In 150x zoom, Mizar splits into Mizar A/B with Alcor beside it.", x: 110, y: -110, z: 860, size: 4.4, isBinary: true },
        { id: 'alioth', name: "Alioth", bayer: "ε Ursae Majoris", dist: "82.6 ly", spec: "A1p Magnetic Peculiar", mag: "+1.77", role: "Luminosity Leader", desc: "Brightest star in Ursa Major with an intense fluctuating magnetic field.", x: 60, y: -45, z: 850, size: 4.3 },
        { id: 'megrez', name: "Megrez", bayer: "δ Ursae Majoris", dist: "80.5 ly", spec: "A3 V Main Sequence", mag: "+3.31", role: "Bowl-Handle Junction", desc: "The junction star joining the handle to the quadrangle bowl.", x: 10, y: 35, z: 840, size: 3.5 },
        { id: 'dubhe', name: "Dubhe", bayer: "α Ursae Majoris", dist: "123 ly", spec: "K0 III Orange Giant", mag: "+1.79", role: "Polaris Pointer Star", desc: "30x larger than our Sun. Merak & Dubhe line points straight to Polaris.", x: -70, y: 25, z: 980, size: 4.6, isPointer: true },
