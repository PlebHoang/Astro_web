    // KEYBOARD LISTENER: Key [1] for 20x Finder, Key [2] for 150x Zoom, Space/Z to toggle
    function handleScopeKeyDown(e: KeyboardEvent) {
      const isKey1 = e.key === "1" || e.code === "Digit1" || e.code === "Numpad1" || e.keyCode === 49 || e.keyCode === 97;
      const isKey2 = e.key === "2" || e.code === "Digit2" || e.code === "Numpad2" || e.keyCode === 50 || e.keyCode === 98;
      const isToggle = e.code === "Space" || e.key === " " || e.key === "z" || e.key === "Z" || e.code === "KeyZ";

      if (isKey1) {
        e.preventDefault();
        e.stopPropagation();
        setScopeMode(false);
      } else if (isKey2) {
        e.preventDefault();
        e.stopPropagation();
        setScopeMode(true);
      } else if (isToggle) {
        e.preventDefault();
        e.stopPropagation();
        setScopeMode(!isHighZoom);
      }
    }

    window.addEventListener("keydown", handleScopeKeyDown, { capture: true });
    document.addEventListener("keydown", handleScopeKeyDown, { capture: true });

