        currentTargetIndex = (currentTargetIndex + 1) % allMysteryTargets.length;
        activeMystery = allMysteryTargets[currentTargetIndex];
        activeMystery.x = (Math.random() - 0.5) * 1400;
        activeMystery.y = (Math.random() - 0.5) * 1100;
