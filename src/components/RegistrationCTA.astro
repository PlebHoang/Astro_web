---
---

<section id="register" class="py-20 relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-card p-8 sm:p-12 lg:p-16 border-white/20 bg-gradient-to-br from-black via-surface-950 to-[#0c091f] shadow-2xl relative overflow-hidden reveal">
      
      <!-- Subtle cosmic dust highlight -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-2xl mx-auto text-center relative z-10">
        <!-- Sub-header Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-white/[0.04] border border-white/10 text-[10px] font-space-mono text-cyan-300 uppercase tracking-widest mb-4">
          Membership Registration
        </div>

        <!-- Section Title (Matching University Layout Section 4) -->
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-orbitron text-white tracking-tight mb-4 gravitational-warp-target">
          Want to become a member of our club?
        </h2>

        <!-- University Customized Text -->
        <p class="text-base sm:text-lg text-slate-200 font-medium font-inter mb-2">
          What are you waiting for? 🤩
        </p>
        <p class="text-xs sm:text-sm text-slate-400 font-inter leading-relaxed mb-8">
          Request to join and share your motivation with us! We can't wait to get to know you! 🌟
        </p>

        <!-- Interactive Fast Signup Form -->
        <form id="membership-form" class="space-y-3.5 max-w-md mx-auto text-left mb-8">
          <div>
            <label for="student-name" class="block text-[11px] font-space-mono text-slate-300 mb-1">Full Name</label>
            <input
              type="text"
              id="student-name"
              required
              placeholder="e.g., Alex Thorne"
              class="w-full px-4 py-2.5 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-slate-500 text-xs font-inter focus:outline-none focus:border-purple-400 transition"
            />
          </div>

          <div>
            <label for="student-email" class="block text-[11px] font-space-mono text-slate-300 mb-1">Constructor University Email</label>
            <input
              type="email"
              id="student-email"
              required
              placeholder="username@constructor.university"
              class="w-full px-4 py-2.5 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-slate-500 text-xs font-inter focus:outline-none focus:border-purple-400 transition"
            />
          </div>

          <div>
            <label for="student-motivation" class="block text-[11px] font-space-mono text-slate-300 mb-1">What excites you about Astronomy? (Optional)</label>
            <textarea
              id="student-motivation"
              rows="2"
              placeholder="Stargazing, astrophotography, space movies, or simply curious..."
              class="w-full px-4 py-2.5 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-slate-500 text-xs font-inter focus:outline-none focus:border-purple-400 transition resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="register-btn"
            class="w-full py-3 rounded-xl bg-white text-black font-bold font-orbitron text-xs uppercase tracking-wider hover:bg-slate-200 transition shadow-[0_0_30px_rgba(255,255,255,0.3)] hover:scale-[1.02] active:scale-95 flex items-center justify-center gap-2"
          >
            <span>Join us now! 🔔</span>
          </button>
        </form>

        <!-- Success notification box -->
        <div id="form-success-box" class="hidden p-4 rounded-xl bg-emerald-950/40 border border-emerald-500/40 text-left mb-6 max-w-md mx-auto">
          <div class="flex items-center gap-2 text-emerald-300 font-orbitron text-xs font-bold mb-1">
            <span>✓</span> Application Dispatched!
          </div>
          <p class="text-[11px] text-slate-300 font-inter">
            Your membership request has been submitted to the society board. You will receive a confirmation email shortly. In the meantime, don't forget to follow our Instagram for clear-sky alerts!
          </p>
        </div>

        <!-- Social Channels Shortcut -->
        <div class="pt-6 border-t border-white/10 flex flex-wrap items-center justify-center gap-4 text-xs font-space-mono text-slate-400">
          <span>Or connect instantly via:</span>
          <a
            href="https://www.instagram.com/astronomy.cub/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-pink-400 hover:text-pink-300 underline"
          >
            @astronomy.cub
          </a>
          <span>•</span>
          <a
            href="https://www.instagram.com/cubastrosoc/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-purple-400 hover:text-purple-300 underline"
          >
            @cubastrosoc
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById("membership-form") as HTMLFormElement;
  const successBox = document.getElementById("form-success-box");
  const regBtn = document.getElementById("register-btn");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (regBtn) {
      regBtn.innerHTML = "<span>Submitting Application...</span>";
    }

    setTimeout(() => {
      form.classList.add("hidden");
      successBox?.classList.remove("hidden");
      window.dispatchEvent(new CustomEvent("cosmic-nebula-spawn"));
      window.dispatchEvent(new CustomEvent("cosmic-click"));
    }, 600);
  });
</script>
