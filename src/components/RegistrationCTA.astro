---
const POWERAPP_URL = "https://apps.powerapps.com/play/e/default-f78e973e-5c0b-4ab8-bbd7-9887c95a8ebd/a/fbf8e4bd-5b65-4f44-a23e-f7a2ca3cfbc2?tenantId=f78e973e-5c0b-4ab8-bbd7-9887c95a8ebd&sourcetime=1738580797169";
---

<section id="register" class="py-20 relative overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-card p-8 sm:p-12 lg:p-14 border-white/20 bg-black/80 shadow-[0_0_50px_rgba(0,0,0,0.9),0_0_30px_rgba(255,255,255,0.06)] relative overflow-hidden reveal backdrop-blur-xl">
      
      <div class="max-w-2xl mx-auto text-center relative z-10">
        <!-- Sub-header Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-white/[0.04] border border-white/15 text-[10px] font-space-mono text-slate-300 uppercase tracking-widest mb-4">
          <span>🏛️</span>
          <span>Constructor University SSO System</span>
        </div>

        <!-- Section Title -->
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-orbitron text-white tracking-tight mb-4 gravitational-warp-target">
          Want to become a member of our club?
        </h2>

        <p class="text-base sm:text-lg text-slate-200 font-medium font-inter mb-2">
          What are you waiting for? 🤩
        </p>
        <p class="text-xs sm:text-sm text-slate-400 font-inter leading-relaxed mb-8 max-w-lg mx-auto">
          Member registration is integrated directly with Constructor University's Microsoft PowerApps system. Sign in with your university account to join the roster, access telescope equipment, and participate in dark-sky expeditions! 🌟
        </p>

        <!-- Direct Microsoft PowerApp Action Card -->
        <div class="p-6 rounded-2xl bg-white/[0.03] border border-white/15 backdrop-blur-md mb-8 max-w-lg mx-auto">
          <div class="flex items-center justify-center gap-2 mb-3">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399] animate-pulse"></span>
            <span class="text-xs font-orbitron font-bold text-white uppercase tracking-wider">Official Uni Registration Portal</span>
          </div>

          <a
            href={POWERAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            id="btn-powerapp-register"
            class="w-full py-3.5 px-6 rounded-xl bg-white text-black font-bold font-orbitron text-xs sm:text-sm uppercase tracking-wider hover:bg-slate-200 transition shadow-[0_0_30px_rgba(255,255,255,0.3)] hover:scale-[1.02] active:scale-95 flex items-center justify-center gap-2 group cursor-pointer"
          >
            <span>Register on Microsoft PowerApp</span>
            <span class="transition-transform group-hover:translate-x-1 group-hover:-translate-y-0.5 font-bold">↗</span>
          </a>

          <div class="mt-3 text-[10px] font-space-mono text-slate-500">
            Constructor University Tenant: f78e973e-5c0b-4ab8-bbd7-9887c95a8ebd
          </div>
        </div>

        <!-- Social Channels Shortcut -->
        <div class="pt-6 border-t border-white/10 flex flex-wrap items-center justify-center gap-4 text-xs font-space-mono text-slate-400">
          <span>Or connect instantly via:</span>
          <a
            href="https://www.instagram.com/astronomy.cub/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white hover:text-slate-300 underline"
          >
            @astronomy.cub
          </a>
          <span>•</span>
          <a
            href="https://www.instagram.com/cubastrosoc/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white hover:text-slate-300 underline"
          >
            @cubastrosoc
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
