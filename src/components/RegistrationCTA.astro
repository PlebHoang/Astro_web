---
const POWERAPP_URL = "https://apps.powerapps.com/play/e/default-f78e973e-5c0b-4ab8-bbd7-9887c95a8ebd/a/fbf8e4bd-5b65-4f44-a23e-f7a2ca3cfbc2?tenantId=f78e973e-5c0b-4ab8-bbd7-9887c95a8ebd&sourcetime=1738580797169";
---

<section id="register" class="py-20 relative overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-card p-8 sm:p-12 lg:p-14 border-white/20 bg-black/80 shadow-[0_0_50px_rgba(0,0,0,0.9),0_0_30px_rgba(255,255,255,0.06)] relative overflow-hidden reveal backdrop-blur-xl">
      
      <div class="max-w-2xl mx-auto text-center relative z-10">
        <!-- Sub-header Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.06] border border-white/15 text-[10px] font-space-mono text-slate-300 uppercase tracking-widest mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Constructor University Club Portal</span>
        </div>

        <!-- Section Title -->
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black font-orbitron text-white tracking-tight mb-3 gravitational-warp-target">
          Ready to Explore the Cosmos?
        </h2>

        <p class="text-sm sm:text-base text-slate-300 font-inter mb-8 max-w-xl mx-auto">
          Borrow club telescopes, join dark-sky meteor expeditions, and learn deep-sky astrophotography. Completely free for all Constructor students.
        </p>

        <!-- 3 Punchy Value Pillars -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8 max-w-2xl mx-auto text-left">
          <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/10">
            <svg class="w-4 h-4 text-white mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v4m0 12v4M2 12h4m12 0h4"></path>
            </svg>
            <div class="text-xs font-bold font-orbitron text-white">Telescope Access</div>
            <div class="text-[11px] text-slate-400 font-inter mt-0.5">Borrow 8" Dobsonians and camera tracking mounts.</div>
          </div>
          <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/10">
            <svg class="w-4 h-4 text-white mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
            <div class="text-xs font-bold font-orbitron text-white">Dark-Sky Trips</div>
            <div class="text-[11px] text-slate-400 font-inter mt-0.5">Weekend meteor camps with transport covered.</div>
          </div>
          <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/10">
            <svg class="w-4 h-4 text-white mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div class="text-xs font-bold font-orbitron text-white">Zero Fees</div>
            <div class="text-[11px] text-slate-400 font-inter mt-0.5">100% free membership for students and staff.</div>
          </div>
        </div>

        <!-- Direct High-Converting Action Card -->
        <div class="p-6 sm:p-7 rounded-2xl bg-white/[0.04] border border-white/15 backdrop-blur-xl mb-6 max-w-lg mx-auto shadow-2xl">
          <a
            href={POWERAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            id="btn-powerapp-register"
            class="w-full py-4 px-6 rounded-xl bg-white hover:bg-slate-100 text-black font-extrabold font-orbitron text-sm uppercase tracking-wider transition-all duration-200 shadow-[0_0_35px_rgba(255,255,255,0.35)] hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 group cursor-pointer"
          >
            <span>Claim Your Free Club Membership</span>
            <span class="transition-transform duration-200 group-hover:translate-x-1 font-bold">→</span>
          </a>

          <div class="mt-3.5 flex items-center justify-center gap-2 text-[11px] font-space-mono text-emerald-400">
            <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Instant 30-sec sign-in with Constructor Microsoft SSO</span>
          </div>

          <div class="mt-2 text-[10px] font-space-mono text-slate-500">
            Constructor Tenant: f78e973e-5c0b-4ab8-bbd7-9887c95a8ebd • No paperwork
          </div>
        </div>

        <!-- Social Channels Shortcut -->
        <div class="pt-6 border-t border-white/10 flex flex-wrap items-center justify-center gap-4 text-xs font-space-mono text-slate-400">
          <span>Or connect instantly via:</span>
          <a
            href="https://www.instagram.com/astronomy.cub/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white hover:text-slate-300 underline"
          >
            @astronomy.cub
          </a>
          <span>•</span>
          <a
            href="https://www.instagram.com/cubastrosoc/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white hover:text-slate-300 underline"
          >
            @cubastrosoc
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
