---
const tickerItems = [
  { icon: "🔭", text: "Next Session: Campus Green Stargazing when skies clear" },
  { icon: "🪐", text: "Saturn's Rings & Jupiter's Moons visible through club scopes" },
  { icon: "🎬", text: "Upcoming: 'Interstellar' & Astrophysics Discussion Night" },
  { icon: "📍", text: "Constructor University Bremen — Campus Green Meeting Point" },
  { icon: "📸", text: "Astrophotography Workshop: Long-exposure smartphone & DSLR setup" },
  { icon: "✨", text: "Follow @astronomy.cub for real-time sky observation alerts" },
];
---

<div class="w-full bg-gradient-to-r from-purple-950/40 via-indigo-950/30 to-purple-950/40 border-y border-white/5 py-3 overflow-hidden backdrop-blur-md relative">
  <!-- Gradient fade edges -->
  <div class="absolute left-0 top-0 bottom-0 w-16 bg-gradient-to-r from-[#030014] to-transparent z-10 pointer-events-none"></div>
  <div class="absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-[#030014] to-transparent z-10 pointer-events-none"></div>

  <div class="flex whitespace-nowrap animate-marquee gap-8 items-center text-xs sm:text-sm font-medium text-slate-300">
    {tickerItems.concat(tickerItems).map((item, idx) => (
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.03] border border-white/5 hover:border-purple-500/30 transition">
        <span>{item.icon}</span>
        <span class="text-slate-200">{item.text}</span>
        <span class="text-purple-500/50 mx-2">•</span>
      </div>
    ))}
  </div>
</div>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  .animate-marquee {
    display: inline-flex;
    width: max-content;
    animation: marquee 35s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>
