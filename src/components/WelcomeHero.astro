---
---

<section class="relative min-h-[90vh] pt-28 pb-16 flex items-center justify-center overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    
    <!-- University Portal Context Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.03] border border-white/10 backdrop-blur-md mb-6 hover:border-white/30 transition hero-context-badge">
      <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse hero-badge-dot"></span>
      <span class="text-[11px] font-space-mono text-slate-300 uppercase tracking-widest hero-badge-text">
        Constructor University • Student Club Portal
      </span>
    </div>

    <!-- Main Title (Orbitron Font in Monochromatic Starlight) -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black font-orbitron tracking-tight text-white leading-[1.06] mb-6 gravitational-warp-target">
      EXPLORE THE COSMOS <br class="hidden sm:inline" />
      <span class="text-white drop-shadow-[0_0_35px_rgba(255,255,255,0.6)] starwars-pop">
        ASTRONOMICAL SOCIETY
      </span>
    </h1>

    <!-- University Customized Welcome Message (Translucent Gradient Box) -->
    <div class="max-w-2xl mx-auto mb-10">
      <div class="p-6 sm:p-7 rounded-2xl bg-gradient-to-b from-white/[0.08] via-white/[0.03] to-white/[0.01] border border-white/15 backdrop-blur-md shadow-[0_12px_40px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.2)]">
        <p class="text-base sm:text-lg md:text-xl font-bold font-inter text-white leading-relaxed drop-shadow-[0_0_20px_rgba(255,255,255,0.35)]">
          We are thrilled to welcome you to our official homepage! Here at the club, we are dedicated to exploring observational astronomy, astrophotography, and deep space science together.
        </p>
      </div>
    </div>

    <!-- Action Buttons (Monochromatic High Contrast) -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mb-14">
      <a
        href="#events"
        class="w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold font-orbitron uppercase tracking-wider text-black bg-white hover:bg-slate-200 rounded-xl shadow-[0_0_25px_rgba(255,255,255,0.3)] hover:scale-105 active:scale-95 transition-all duration-200 flex items-center justify-center gap-2 group"
      >
        <span>Next Stargazing Session</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>



      <a
        href="https://www.instagram.com/astronomy.cub/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-space-mono text-slate-300 hover:text-white bg-white/[0.02] hover:bg-white/[0.06] border border-white/10 rounded-xl transition flex items-center justify-center gap-2"
      >
        <span>@astronomy.cub</span>
      </a>

      <!-- Cosmic Star Alignment (WhatsApp) Trigger Button -->
      <button
        type="button"
        id="btn-trigger-star-align"
        class="w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-bold font-orbitron uppercase tracking-wider text-white bg-gradient-to-r from-emerald-500/25 to-cyan-500/25 hover:from-emerald-500/40 hover:to-cyan-500/40 border border-emerald-400/50 hover:border-emerald-400 rounded-xl shadow-[0_0_25px_rgba(37,211,102,0.35)] hover:shadow-[0_0_35px_rgba(37,211,102,0.6)] hover:scale-105 active:scale-95 transition-all duration-200 flex items-center justify-center gap-2 group cursor-pointer"
      >
        <span class="text-emerald-400 group-hover:rotate-180 transition-transform duration-500">✦</span>
        <span>Align Stars (WhatsApp)</span>
      </button>
    </div>

<script>
  document.getElementById("btn-trigger-star-align")?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("cub:trigger-align"));
  });
</script>

    <!-- Monochromatic Telemetry Bar with Kyber Hooks -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto">
      <div class="space-card p-4 text-left" data-kyber="blue">
        <span class="text-[10px] font-space-mono text-slate-500 uppercase tracking-wider block mb-1 card-sub">Campus Coordinates</span>
        <div class="text-sm font-bold font-orbitron text-white card-main">53.1672° N 8.6534° E Bremen</div>
      </div>

      <div class="space-card p-4 text-left" data-kyber="green">
        <span class="text-[10px] font-space-mono text-slate-500 uppercase tracking-wider block mb-1 card-sub">Location</span>
        <div class="text-sm font-bold font-orbitron text-white card-main">Campus Green :)</div>
      </div>

      <div class="space-card p-4 text-left" data-kyber="red">
        <span class="text-[10px] font-space-mono text-slate-500 uppercase tracking-wider block mb-1 card-sub">Primary Telescope</span>
        <div class="text-sm font-bold font-orbitron text-white card-main">idk really, borrowed from SMP lol</div>
      </div>

      <div class="space-card p-4 text-left" data-kyber="purple">
        <span class="text-[10px] font-space-mono text-slate-500 uppercase tracking-wider block mb-1 card-sub flex items-center justify-between">
          <span>Student Access</span>
          <span class="hidden supreme-tag px-1.5 py-0.2 rounded bg-purple-500/25 text-purple-200 border border-purple-400/40 text-[8px] font-bold">KEY ACCESS</span>
        </span>
        <div class="text-sm font-bold font-orbitron text-white card-main">100% Free</div>
        <div class="text-[10px] font-space-mono text-slate-300">All Majors Welcome</div>
      </div>
    </div>
  </div>
</section>
