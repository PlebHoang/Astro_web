---
---

<section class="relative min-h-[92vh] pt-28 pb-16 flex items-center justify-center overflow-hidden">
  <!-- Subtle cosmic background glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[650px] bg-purple-900/15 rounded-full blur-[140px] pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <!-- University Portal Context Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/10 backdrop-blur-md mb-6 hover:border-purple-500/40 transition">
      <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
      <span class="text-[11px] font-space-mono text-slate-300 uppercase tracking-widest">
        Constructor University • Student Club Portal
      </span>
    </div>

    <!-- Main Title (Orbitron Font) -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black font-orbitron tracking-tight text-white leading-[1.06] mb-6 gravitational-warp-target">
      MY CLUB'S <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-200 to-purple-400 drop-shadow-[0_0_40px_rgba(255,255,255,0.4)]">
        HOMEPAGE
      </span>
    </h1>

    <!-- University Customized Welcome Message -->
    <div class="max-w-2xl mx-auto mb-10 space-y-3">
      <p class="text-base sm:text-lg text-slate-200 font-medium font-inter leading-relaxed">
        Welcome to the <strong class="text-white font-semibold">Constructor University Astronomical Society</strong>!
      </p>
      <p class="text-xs sm:text-sm text-slate-400 font-inter leading-relaxed">
        We are thrilled to welcome you to our official homepage. Here at CUB Astro Soc, we are dedicated to exploring observational astronomy, astrophotography, and deep-space science together. Whether you are a first-year student or a senior stargazer, join us on our journey to make our student community stronger and more fun!
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mb-14">
      <a
        href="#events"
        class="w-full sm:w-auto px-7 py-3 text-xs sm:text-sm font-bold font-orbitron uppercase tracking-wider text-black bg-white hover:bg-slate-200 rounded-xl shadow-[0_0_30px_rgba(255,255,255,0.3)] hover:scale-105 active:scale-95 transition-all duration-200 flex items-center justify-center gap-2 group"
      >
        <span>Next Stargazing Session</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>

      <button
        type="button"
        id="nebula-blast-btn"
        class="w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-space-mono text-slate-300 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/15 rounded-xl transition flex items-center justify-center gap-2 hover:border-purple-400/50"
      >
        <span>💥 Spawn Nebula Burst</span>
      </button>

      <a
        href="https://www.instagram.com/astronomy.cub/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-space-mono text-pink-300 hover:text-pink-200 bg-pink-500/10 hover:bg-pink-500/20 border border-pink-500/25 rounded-xl transition flex items-center justify-center gap-2"
      >
        <span>@astronomy.cub</span>
      </a>
    </div>

    <!-- Monochromatic Telemetry Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto">
      <div class="space-card p-4 text-left">
        <span class="text-[10px] font-space-mono text-slate-500 uppercase tracking-wider block mb-1">Campus Coordinates</span>
        <div class="text-sm font-bold font-orbitron text-white">53.1672° N</div>
        <div class="text-[10px] font-space-mono text-slate-400">8.6534° E Bremen</div>
      </div>

      <div class="space-card p-4 text-left">
        <span class="text-[10px] font-space-mono text-slate-500 uppercase tracking-wider block mb-1">Observatory Base</span>
        <div class="text-sm font-bold font-orbitron text-white">Campus Green</div>
        <div class="text-[10px] font-space-mono text-cyan-400">Bortle Class 5 Dark Sky</div>
      </div>

      <div class="space-card p-4 text-left">
        <span class="text-[10px] font-space-mono text-slate-500 uppercase tracking-wider block mb-1">Optics Arsenal</span>
        <div class="text-sm font-bold font-orbitron text-white">8" Dobsonian</div>
        <div class="text-[10px] font-space-mono text-slate-400">1200mm Focal Length</div>
      </div>

      <div class="space-card p-4 text-left">
        <span class="text-[10px] font-space-mono text-slate-500 uppercase tracking-wider block mb-1">Student Access</span>
        <div class="text-sm font-bold font-orbitron text-white">100% Free</div>
        <div class="text-[10px] font-space-mono text-purple-400">All Majors Welcome</div>
      </div>
    </div>
  </div>
</section>

<script>
  const blastBtn = document.getElementById("nebula-blast-btn");
  blastBtn?.addEventListener("click", (e) => {
    const rect = blastBtn.getBoundingClientRect();
    if ((window as any).triggerNebulaBurst) {
      (window as any).triggerNebulaBurst(rect.left + rect.width / 2, rect.top + rect.height / 2);
    }
  });
</script>
