---
interface EventPost {
  id: string;
  title: string;
  tag: string;
  author: string;
  location: string;
  date: string;
  recap: string;
  equipment: string;
  image: string;
  instagramUrl: string;
  embedUrl?: string;
}

const base = (typeof import.meta !== "undefined" && import.meta.env?.BASE_URL ? import.meta.env.BASE_URL : "/").replace(/\/$/, "");

const eventPosts: EventPost[] = [
  {
    id: "andromeda-m31",
    title: "The Andromeda Galaxy (M31) Deep-Sky Capture",
    tag: "ASTROPHOTOGRAPHY",
    author: "@egementash",
    location: "Campus Observatory Lawn",
    date: "Aug 15, 2026",
    recap: "Tracked Andromeda spiral arm dust lanes and M51 Whirlpool galaxy with Star Adventurer 2i pro. Stacked 40 sub-exposures in Siril to bring out core details and satellite galaxies.",
    equipment: "✨ Star Adventurer 2i pro • Siril Stacking • M51 & M31",
    image: `${base}/images/events/andromeda_egemen.jpg`,
    instagramUrl: "https://www.instagram.com/p/DcEniK8jHE8/?img_index=1",
    embedUrl: "https://www.instagram.com/p/DcEniK8jHE8/embed/",
  },
  {
    id: "perseids-meteor",
    title: "The Perseid Meteor Shower Dark-Sky Camp",
    tag: "EXPEDITION",
    author: "@egementash",
    location: "Teufelsmoor Bog",
    date: "Aug 13, 2026",
    recap: "Over 20 students camped under Bortle Class 3 skies. Logged 55+ meteors/hour with widefield tracking and captured radiant fireballs.",
    equipment: "☄️ Canon EOS R • Widefield Star Tracker",
    image: `${base}/images/events/perseid_egemen.jpg`,
    instagramUrl: "https://www.instagram.com/p/Db-6_xOspQu/",
    embedUrl: "https://www.instagram.com/p/Db-6_xOspQu/embed/",
  },
  {
    id: "saturn-cassini",
    title: "Saturn Cassini Rings & Jupiter Galilean Moons",
    tag: "OBSERVATION",
    author: "@astronomy.cub",
    location: "Campus Green",
    date: "Sep 2, 2026",
    recap: "Sublime atmospheric seeing near South Hall lawn. Resolved Cassini Division rings and tracked Io, Europa, Ganymede, and Callisto in 150x zoom.",
    equipment: "🪐 8\" Dobsonian 150x Zoom",
    image: `${base}/images/events/saturn.jpg`,
    instagramUrl: "https://www.instagram.com/astronomy.cub/",
  },
  {
    id: "sunspots-solar",
    title: "Daytime Solar Sunspot Tracking Lab",
    tag: "SOLAR LAB",
    author: "@astronomy.cub",
    location: "SAC Terrace",
    date: "Aug 26, 2026",
    recap: "Equipped scopes with Baader Solar Safety filters. Tracked active sunspot region AR3780 and observed photospheric granulation during lunch break.",
    equipment: "☀️ Baader Solar Filter Film",
    image: `${base}/images/events/sunspots.jpg`,
    instagramUrl: "https://www.instagram.com/astronomy.cub/",
  },
  {
    id: "cosmic-cinema",
    title: "Cosmic Cinema: Gravitational Lensing & Thorne Physics",
    tag: "CINEMA",
    author: "@astronomy.cub",
    location: "SAC Lounge",
    date: "Aug 8, 2026",
    recap: "Full screening followed by an active whiteboard discussion dissecting event horizon optics, black hole ergospheres, and accretion disk physics.",
    equipment: "🎬 4K Projection + Tea & Snacks",
    image: `${base}/images/events/cinema.jpg`,
    instagramUrl: "https://www.instagram.com/astronomy.cub/",
  },
];
---

<section id="events-gallery" class="py-20 relative overflow-hidden">
  <!-- Anchor Alias for Backward Compatibility -->
  <div id="news-highlights" class="absolute -top-24"></div>
  <div id="viewfinder" class="absolute -top-24"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header with Section Title & Carousel Navigation Arrows -->
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-8 pb-4 border-b border-white/10 gap-4 reveal">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-white/[0.04] border border-white/10 text-[10px] font-space-mono text-slate-300 uppercase tracking-widest mb-2">
          Observation Archives
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold font-orbitron text-white tracking-tight gravitational-warp-target">
          Highlights from our last events
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1 font-inter max-w-xl">
          Recent deep-sky stargazing sessions, meteor watches, and solar observations with real photo captures linked to Instagram.
        </p>
      </div>

      <!-- Carousel Directional Arrows -->
      <div class="flex items-center gap-2 self-end sm:self-auto shrink-0">
        <button
          type="button"
          id="btn-gallery-prev"
          class="w-10 h-10 rounded-xl bg-white/5 hover:bg-white/15 border border-white/15 text-white flex items-center justify-center font-bold transition hover:scale-105 active:scale-95 cursor-pointer shadow-sm"
          aria-label="Previous event slide"
        >
          ←
        </button>
        <button
          type="button"
          id="btn-gallery-next"
          class="w-10 h-10 rounded-xl bg-white/10 hover:bg-white text-white hover:text-black border border-white/20 flex items-center justify-center font-bold transition hover:scale-105 active:scale-95 cursor-pointer shadow-sm"
          aria-label="Next event slide"
        >
          →
        </button>
      </div>
    </div>

    <!-- Scroll-Snap Horizontal Carousel Track -->
    <div
      id="gallery-track"
      class="flex gap-5 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory scroll-smooth no-scrollbar"
      style="scrollbar-width: none; -ms-overflow-style: none;"
    >
      {eventPosts.map((post, idx) => (
        <article
          class={`snap-start shrink-0 w-[88vw] sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-0.85rem)] space-card p-5 sm:p-6 flex flex-col justify-between reveal reveal-delay-${(idx % 3) + 1} border-white/10 hover:border-white/30 bg-black/60 backdrop-blur-xl transition-all duration-300 group`}
        >
          <div>
            <!-- Linked Post Photo Banner with Instant Preview on Click -->
            <div
              class="relative w-full aspect-[16/10] rounded-xl overflow-hidden mb-4 border border-white/10 group-hover:border-white/30 transition shadow-lg cursor-pointer"
              title={`Click to preview ${post.title}`}
              data-preview-trigger
              data-post={JSON.stringify(post)}
            >
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
              <div class="absolute top-2.5 left-2.5 flex items-center gap-2">
                <span class="text-[9px] font-space-mono px-2 py-0.5 rounded-md bg-black/80 backdrop-blur-md text-white border border-white/20 font-bold">
                  {post.tag}
                </span>
                <span class="text-[9px] font-space-mono px-2 py-0.5 rounded-md bg-white/10 backdrop-blur-md text-slate-200 border border-white/20 font-semibold">
                  {post.author}
                </span>
              </div>
              <div class="absolute top-2.5 right-2.5 opacity-0 group-hover:opacity-100 transition-opacity">
                <span class="text-[10px] font-space-mono px-2 py-0.5 rounded-md bg-white text-black font-bold shadow-md">
                  Preview ↗
                </span>
              </div>
              <div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-center justify-between text-[10px] font-space-mono text-slate-300">
                <span class="flex items-center gap-1">
                  <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>{post.location}</span>
                </span>
                <span>{post.date}</span>
              </div>
            </div>

            <h3 class="font-orbitron font-bold text-base text-white mb-2 leading-snug group-hover:text-slate-100 transition">
              {post.title}
            </h3>

            <p class="text-xs text-slate-300 leading-relaxed font-inter mb-4">
              {post.recap}
            </p>

            <div class="text-[10px] font-space-mono text-slate-400 bg-white/[0.02] p-2.5 rounded-lg border border-white/5 mb-6">
              {post.equipment}
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              data-preview-trigger
              data-post={JSON.stringify(post)}
              class="px-3.5 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 text-xs font-orbitron font-bold transition flex items-center justify-center gap-1.5 cursor-pointer hover:scale-105 active:scale-95"
              title="Preview Post Details"
            >
              <span>Preview</span>
            </button>
            <a
              href={post.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 py-2.5 px-3 rounded-xl bg-white/10 hover:bg-white text-white hover:text-black border border-white/20 hover:border-white font-orbitron text-xs font-bold transition flex items-center justify-center gap-2 group-hover:shadow-[0_0_20px_rgba(255,255,255,0.2)]"
            >
              <span>View Post on Instagram</span>
              <span class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>


    <!-- Social Media Community Connect Strip -->
    <div class="mt-8 p-5 rounded-2xl bg-white/[0.02] border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 backdrop-blur-md">
      <div class="flex items-center gap-3 text-center sm:text-left">
        <svg class="w-6 h-6 text-slate-200 shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <div>
          <div class="text-xs font-bold font-orbitron text-white">Follow our official Instagram feeds</div>
          <div class="text-[11px] text-slate-400 font-inter">Live stories, clear-sky alerts, astrophotography reels, and behind-the-scenes telescope setups.</div>
        </div>
      </div>
      <div class="flex items-center gap-2.5 shrink-0">
        <a
          href="https://www.instagram.com/astronomy.cub/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3.5 py-1.5 rounded-xl bg-white text-black font-orbitron text-xs font-bold hover:bg-slate-200 transition shadow-sm"
        >
          @astronomy.cub ↗
        </a>
        <a
          href="https://www.instagram.com/cubastrosoc/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/15 font-space-mono text-xs transition"
        >
          @cubastrosoc ↗
        </a>
      </div>
    </div>
  </div>

  <!-- Native Apple-like Post Preview Dialog -->
  <dialog
    id="ig-preview-dialog"
    class="backdrop:bg-black/80 backdrop:backdrop-blur-2xl rounded-2xl bg-black/95 border border-white/20 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.95)] p-6 sm:p-7 max-w-xl w-full text-white m-auto"
  >
    <button
      type="button"
      id="ig-preview-close"
      class="absolute top-4 right-4 z-20 w-8 h-8 rounded-full bg-white/10 hover:bg-white text-white hover:text-black border border-white/20 flex items-center justify-center text-sm font-bold transition cursor-pointer"
      aria-label="Close Preview"
    >
      ✕
    </button>

    <!-- Image Preview Area -->
    <div class="relative w-full aspect-[16/10] rounded-xl overflow-hidden mb-4 border border-white/15 bg-black">
      <img
        id="ig-modal-img"
        src=""
        alt="Post Preview"
        class="w-full h-full object-cover"
      />
      <div class="absolute top-3 left-3 flex items-center gap-2">
        <span id="ig-modal-tag" class="text-[9px] font-space-mono px-2 py-0.5 rounded-md bg-black/85 text-white border border-white/20 font-bold"></span>
        <span id="ig-modal-author" class="text-[9px] font-space-mono px-2 py-0.5 rounded-md bg-white/10 text-slate-200 border border-white/20 font-semibold"></span>
      </div>
    </div>

    <!-- Content Meta -->
    <div class="flex items-center justify-between text-[11px] font-space-mono text-slate-400 mb-2">
      <span id="ig-modal-date"></span>
    </div>

    <h3 id="ig-modal-title" class="text-base sm:text-lg font-bold font-orbitron text-white mb-2 leading-snug"></h3>
    <p id="ig-modal-recap" class="text-xs text-slate-300 font-inter leading-relaxed mb-4"></p>
    <div id="ig-modal-equipment" class="text-[10px] font-space-mono text-slate-400 bg-white/[0.04] p-2.5 rounded-lg border border-white/10 mb-6"></div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center gap-2.5">
      <a
        id="ig-modal-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:flex-1 py-3 px-4 rounded-xl bg-white hover:bg-slate-200 text-black font-orbitron text-xs font-bold transition flex items-center justify-center gap-2 shadow-lg hover:scale-[1.02] active:scale-[0.98]"
      >
        <span>Open Post on Instagram ↗</span>
      </a>
      <button
        type="button"
        id="ig-modal-embed-btn"
        class="w-full sm:w-auto py-3 px-4 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 font-orbitron text-xs font-bold transition flex items-center justify-center gap-2 cursor-pointer hover:scale-105 active:scale-95"
      >
        <span>Load Live Embed</span>
      </button>
    </div>

    <div id="ig-modal-embed-container" class="hidden mt-4 pt-4 border-t border-white/10"></div>
  </dialog>
</section>

<script>
  const track = document.getElementById("gallery-track");
  const prevBtn = document.getElementById("btn-gallery-prev");
  const nextBtn = document.getElementById("btn-gallery-next");

  prevBtn?.addEventListener("click", () => {
    track?.scrollBy({ left: -track.clientWidth * 0.75, behavior: "smooth" });
  });

  nextBtn?.addEventListener("click", () => {
    track?.scrollBy({ left: track.clientWidth * 0.75, behavior: "smooth" });
  });

  // Native Dialog Preview Logic
  const dialog = document.getElementById("ig-preview-dialog") as HTMLDialogElement | null;
  const closeBtn = document.getElementById("ig-preview-close");
  const modalImg = document.getElementById("ig-modal-img") as HTMLImageElement | null;
  const modalTag = document.getElementById("ig-modal-tag");
  const modalAuthor = document.getElementById("ig-modal-author");
  const modalDate = document.getElementById("ig-modal-date");
  const modalTitle = document.getElementById("ig-modal-title");
  const modalRecap = document.getElementById("ig-modal-recap");
  const modalEquip = document.getElementById("ig-modal-equipment");
  const modalLink = document.getElementById("ig-modal-link") as HTMLAnchorElement | null;
  const embedBtn = document.getElementById("ig-modal-embed-btn");
  const embedContainer = document.getElementById("ig-modal-embed-container");

  let currentEmbedUrl = "";

  closeBtn?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });

  embedBtn?.addEventListener("click", () => {
    if (!embedContainer || !currentEmbedUrl) return;
    embedContainer.classList.remove("hidden");
    embedContainer.innerHTML = `
      <iframe
        src="${currentEmbedUrl}"
        class="w-full h-80 rounded-xl border border-white/20 bg-black"
        frameborder="0"
        scrolling="no"
        allow="encrypted-media"
      ></iframe>
    `;
    embedBtn.style.display = "none";
  });

  document.querySelectorAll("[data-preview-trigger]").forEach((el) => {
    el.addEventListener("click", () => {
      const dataStr = el.getAttribute("data-post");
      if (!dataStr || !dialog) return;
      try {
        const data = JSON.parse(dataStr);
        if (modalImg) modalImg.src = data.image;
        if (modalTag) modalTag.textContent = data.tag || "POST";
        if (modalAuthor) modalAuthor.textContent = data.author || "@astronomy.cub";
        if (modalDate) modalDate.textContent = `📍 ${data.location} • ${data.date}`;
        if (modalTitle) modalTitle.textContent = data.title;
        if (modalRecap) modalRecap.textContent = data.recap;
        if (modalEquip) modalEquip.textContent = data.equipment;
        if (modalLink) modalLink.href = data.instagramUrl;

        currentEmbedUrl = data.embedUrl || (data.instagramUrl?.includes("/p/") ? data.instagramUrl.replace(/\/?$/, "/embed/") : "");
        if (embedContainer) {
          embedContainer.innerHTML = "";
          embedContainer.classList.add("hidden");
        }
        if (embedBtn) {
          embedBtn.style.display = currentEmbedUrl ? "flex" : "none";
        }
        dialog.showModal();
      } catch {
        // ignore
      }
    });
  });
</script>
