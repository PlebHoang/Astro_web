---
const newsPosts = [
  {
    title: "Semester Kickoff: Campus Green Telescope Night Announced",
    date: "Sep 2, 2026",
    tag: "Observation Alert",
    summary: "Clear weather predicted this weekend! We will bring out the 8\" Dobsonian to observe Saturn's rings and the Orion constellation starting at 20:45 CET.",
  },
  {
    title: "New Baader Solar Filters Delivered to Club Arsenal",
    date: "Aug 26, 2026",
    tag: "Equipment",
    summary: "We now have certified safe solar observation filters ready for daytime sunspot tracking and solar photography sessions during campus lunch breaks.",
  },
  {
    title: "Teufelsmoor Dark Sky Stargazing Expedition Recap",
    date: "Aug 14, 2026",
    tag: "Expedition",
    summary: "Over 20 students joined our Perseids meteor shower watch trip. Captured 40+ long exposure Milky Way frames under Bortle Class 3 skies.",
  }
];

const targets = [
  {
    id: "moon",
    name: "Lunar Terminator (Clavius Crater)",
    optics: "8\" Dobsonian @ 150x",
    description: "High-contrast shadow detail along the lunar day/night boundary.",
    color: "from-slate-800 to-slate-950",
    symbol: "🌔"
  },
  {
    id: "jupiter",
    name: "Jupiter & 4 Galilean Moons",
    optics: "Motorized Tracking Scope",
    description: "Cloud belts, the Great Red Spot, and Io, Europa, Ganymede, Callisto.",
    color: "from-amber-900 to-slate-950",
    symbol: "🪐"
  },
  {
    id: "orion",
    name: "Orion Nebula (M42)",
    optics: "Deep Sky Long Exposure",
    description: "Diffuse emission nebula 1,344 light years from Earth.",
    color: "from-purple-900 to-slate-950",
    symbol: "🌌"
  },
  {
    id: "campus",
    name: "Campus Green Stargazing Circle",
    optics: "Widefield Observation",
    description: "Students gathered with warm tea and scopes under the Bremen night sky.",
    color: "from-indigo-950 to-slate-950",
    symbol: "✨"
  }
];
---

<section id="news-highlights" class="py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">

      <!-- Left Column: My Club News & Social Media (Matching University Layout Section 2 Left) -->
      <div class="lg:col-span-5 space-card p-8 sm:p-10 flex flex-col justify-between reveal">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-white/[0.04] border border-white/10 text-[10px] font-space-mono text-purple-300 uppercase tracking-widest">
              Announcements
            </div>
            <span class="text-[10px] font-space-mono text-slate-400">Semester Feed</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-bold font-orbitron text-white tracking-tight mb-6 gravitational-warp-target">
            My Club News
          </h2>

          <!-- News Items -->
          <div class="space-y-4 mb-8">
            {newsPosts.map((post) => (
              <article class="p-4 rounded-xl bg-white/[0.02] border border-white/5 hover:border-purple-500/30 transition group">
                <div class="flex items-center justify-between gap-2 mb-1.5">
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-300 font-space-mono border border-purple-500/20">
                    {post.tag}
                  </span>
                  <span class="text-[10px] font-space-mono text-slate-400">{post.date}</span>
                </div>
                <h3 class="text-sm font-bold font-orbitron text-white group-hover:text-purple-300 transition mb-1">
                  {post.title}
                </h3>
                <p class="text-xs text-slate-400 leading-relaxed">
                  {post.summary}
                </p>
              </article>
            ))}
          </div>
        </div>

        <!-- Social Media Connection Card (From University Screenshot) -->
        <div class="p-5 rounded-2xl bg-gradient-to-r from-purple-950/40 via-pink-950/30 to-black border border-purple-500/25">
          <h3 class="text-sm font-bold font-orbitron text-white mb-1.5 flex items-center gap-1.5">
            Connect with Us on Social Media! ☀️
          </h3>
          <p class="text-xs text-slate-300 mb-4">
            Live observation alerts, meteor warnings, and photos posted on our Instagram channels.
          </p>

          <div class="flex flex-wrap items-center gap-2">
            <a
              href="https://www.instagram.com/astronomy.cub/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 rounded-lg bg-white text-black font-orbitron text-xs font-bold hover:bg-slate-200 transition shadow-md"
            >
              Join us! 🎏
            </a>
            <a
              href="https://www.instagram.com/astronomy.cub/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-pink-300 text-xs font-space-mono border border-pink-500/20 transition"
            >
              @astronomy.cub
            </a>
            <a
              href="https://www.instagram.com/cubastrosoc/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-purple-300 text-xs font-space-mono border border-purple-500/20 transition"
            >
              @cubastrosoc
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Highlights from our last events / Interactive Viewfinder (Matching University Layout Section 2 Right) -->
      <div id="viewfinder" class="lg:col-span-7 space-card p-8 sm:p-10 flex flex-col justify-between reveal reveal-delay-1">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-white/[0.04] border border-white/10 text-[10px] font-space-mono text-cyan-300 uppercase tracking-widest">
              Interactive Telescope Viewfinder
            </div>
            <span class="text-[10px] font-space-mono text-emerald-400">Optics Live</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-bold font-orbitron text-white tracking-tight mb-2 gravitational-warp-target">
            Highlights from our last events
          </h2>
          <p class="text-xs sm:text-sm text-slate-400 font-inter mb-6">
            Use the target selector below to switch telescope focal targets observed on Campus Green.
          </p>

          <!-- Interactive Telescope Eyepiece Viewfinder Simulator -->
          <div class="relative w-full aspect-video rounded-2xl bg-black border border-white/20 overflow-hidden flex items-center justify-center p-6 shadow-inner">
            <!-- Simulated Circular Eyepiece Border -->
            <div class="relative w-64 sm:w-80 h-64 sm:h-80 rounded-full border-4 border-slate-700/80 shadow-[0_0_50px_rgba(0,0,0,0.9),inset_0_0_40px_rgba(0,0,0,0.8)] overflow-hidden flex items-center justify-center">
              
              <!-- Background target canvas display -->
              <div id="viewfinder-bg" class="absolute inset-0 bg-gradient-to-br from-slate-800 to-slate-950 flex items-center justify-center transition-all duration-700">
                <span id="viewfinder-symbol" class="text-7xl drop-shadow-[0_0_35px_rgba(255,255,255,0.7)] transition-all duration-500">
                  🌔
                </span>
              </div>

              <!-- Optical Crosshairs & Reticle Overlay -->
              <div class="absolute inset-0 pointer-events-none flex items-center justify-center opacity-60">
                <!-- Center Crosshair Lines -->
                <div class="w-full h-[1px] bg-red-500/40"></div>
                <div class="h-full w-[1px] bg-red-500/40 absolute"></div>
                <div class="w-20 h-20 rounded-full border border-red-500/30 absolute"></div>
                <div class="w-40 h-40 rounded-full border border-red-500/20 absolute"></div>
              </div>

              <!-- Eyepiece Specs Stamp -->
              <div class="absolute bottom-4 inset-x-0 text-center pointer-events-none">
                <span id="viewfinder-optics-stamp" class="text-[9px] font-space-mono text-red-400/90 bg-black/60 px-2 py-0.5 rounded">
                  8" Dobsonian @ 150x
                </span>
              </div>
            </div>
          </div>

          <!-- Target Selector Buttons -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-4">
            {targets.map((tgt, i) => (
              <button
                type="button"
                class={`viewfinder-btn text-left p-2.5 rounded-xl border transition text-xs font-space-mono ${i === 0 ? 'bg-white/10 border-purple-400 text-white' : 'bg-white/[0.02] border-white/10 text-slate-400 hover:text-white hover:border-white/20'}`}
                data-id={tgt.id}
                data-name={tgt.name}
                data-optics={tgt.optics}
                data-desc={tgt.description}
                data-symbol={tgt.symbol}
                data-color={tgt.color}
              >
                <div class="text-base mb-1">{tgt.symbol}</div>
                <div class="font-bold text-[11px] truncate text-slate-200">{tgt.name}</div>
              </button>
            ))}
          </div>
        </div>

        <!-- Target Details Output -->
        <div class="mt-6 pt-4 border-t border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <div id="viewfinder-title" class="text-sm font-bold font-orbitron text-white">
              Lunar Terminator (Clavius Crater)
            </div>
            <div id="viewfinder-desc" class="text-xs text-slate-400 font-inter mt-0.5">
              High-contrast shadow detail along the lunar day/night boundary.
            </div>
          </div>
          <a
            href="https://www.instagram.com/astronomy.cub/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-purple-300 hover:text-white font-space-mono shrink-0 transition"
          >
            Instagram Gallery →
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Viewfinder Script -->
<script>
  const btns = document.querySelectorAll(".viewfinder-btn");
  const bg = document.getElementById("viewfinder-bg");
  const symbol = document.getElementById("viewfinder-symbol");
  const stamp = document.getElementById("viewfinder-optics-stamp");
  const title = document.getElementById("viewfinder-title");
  const desc = document.getElementById("viewfinder-desc");

  btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      btns.forEach((b) => {
        b.classList.remove("bg-white/10", "border-purple-400", "text-white");
        b.classList.add("bg-white/[0.02]", "border-white/10", "text-slate-400");
      });
      btn.classList.add("bg-white/10", "border-purple-400", "text-white");
      btn.classList.remove("bg-white/[0.02]", "border-white/10", "text-slate-400");

      const s = btn.getAttribute("data-symbol");
      const name = btn.getAttribute("data-name");
      const optics = btn.getAttribute("data-optics");
      const d = btn.getAttribute("data-desc");

      if (symbol) symbol.textContent = s || "✨";
      if (stamp) stamp.textContent = optics || "";
      if (title) title.textContent = name || "";
      if (desc) desc.textContent = d || "";

      // Trigger slight sound & pulse
      window.dispatchEvent(new CustomEvent("cosmic-click"));
    });
  });
</script>
