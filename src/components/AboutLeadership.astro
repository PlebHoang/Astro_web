---
// =========================================================================
// LEADERSHIP TEAM PLACEHOLDERS
// Edit the information below with your club leaders' real details:
// =========================================================================
const leaders = [
  {
    role: "President",
    name: "Cansu Uçar",
    major: "[Physics and Data Science]",
    duty: "[Club strategy, university liaison, and social affairs]",
    initials: "L1",
  },
  {
    role: "Co-President / Vice President",
    name: "[Khoi Nguyen Hoang]",
    major: "[Industrial Engineering and Management]",
    duty: "[Campus Green stargazing alerts, weather tracking, telescope expedition logistics, and event coordination]",
    initials: "L2",
  },
  {
    role: "Chief Observation Officer",
    name: "This could be you :)",
    major: "[Study Program / Major]",
    duty: "[Telescope maintenance, optical collimation, and astrophotography gear]",
    initials: "L3",
  },
  {
    role: "Treasurer & Outreach",
    name: "[Free spot y'all]",
    major: "[Study Program / Major]",
    duty: "[Society budget, optics procurement, and community coordination]",
    initials: "L4",
  }
];
---

<section id="about-leadership" class="py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left Column: About Us (Matching University Layout Section 1 Left) -->
      <div class="lg:col-span-6 space-card p-8 sm:p-10 flex flex-col justify-between reveal">
        <div>
          <!-- Sub-header -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-white/[0.04] border border-white/10 text-[10px] font-space-mono text-slate-300 uppercase tracking-widest mb-4">
            Mission & Purpose
          </div>

          <h2 class="text-2xl sm:text-3xl font-bold font-orbitron text-white tracking-tight mb-4 gravitational-warp-target">
            About Us
          </h2>

          <div class="space-y-3.5 text-xs sm:text-sm text-slate-300 font-inter leading-relaxed mb-6">
            <p>
              The <strong class="text-white">Constructor University Astronomical Society</strong> was founded with the vision of uniting space enthusiasts, stargazers, and curious minds from across our campus in Bremen-Nord.
            </p>
            <p>
              Our club is committed to organizing regular outdoor telescope sessions on <strong class="text-white">Campus Green</strong>, screening astrophysics documentaries, hosting astrophotography workshops, and fostering open scientific curiosity.
            </p>
            <p class="text-slate-400">
              <strong class="text-slate-200">Key Benefits:</strong> By joining CUB Astro Soc, students gain hands-on experience with high-magnification optical telescopes, learn celestial navigation, capture deep-space astrophotography, and connect with fellow students across all study programs.
            </p>
          </div>
        </div>

        <!-- Visual / Graphic Card -->
        <div class="relative rounded-xl overflow-hidden border border-white/10 bg-black/80 p-4 mt-2">
          <div class="flex items-center justify-between text-[11px] font-space-mono text-slate-400 mb-2">
            <span>🔭 Campus Green Observation Deck</span>
            <span class="text-slate-200">Active Society</span>
          </div>
          <p class="text-xs text-slate-300 italic">
            "We watch documentaries related to Astronomy and stargaze at Campus Green whenever the sky is clear!"
          </p>
        </div>
      </div>

      <!-- Right Column: Meet Our Club Leaders! (Matching University Layout Section 1 Right) -->
      <div id="leaders" class="lg:col-span-6 space-card p-8 sm:p-10 flex flex-col justify-between reveal reveal-delay-1">
        <div>
          <!-- Sub-header -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-white/[0.04] border border-white/10 text-[10px] font-space-mono text-slate-300 uppercase tracking-widest mb-4">
           Star Team 
          </div>

          <h2 class="text-2xl sm:text-3xl font-bold font-orbitron text-white tracking-tight mb-6 gravitational-warp-target">
            Meet our club leaders!
          </h2>

          <!-- Leaders List -->
          <div class="space-y-3">
            {leaders.map((leader) => (
              <div class="p-3.5 rounded-xl bg-white/[0.02] border border-white/5 hover:border-white/20 transition flex items-start gap-3.5 group">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center font-orbitron font-bold text-xs bg-white/5 border border-white/20 text-white shrink-0 group-hover:scale-105 transition">
                  {leader.initials}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-2">
                    <h3 class="text-sm font-bold text-white font-orbitron truncate group-hover:text-slate-200 transition">
                      {leader.name}
                    </h3>
                    <span class="text-[10px] px-2 py-0.5 rounded-md bg-white/5 border border-white/10 text-slate-300 font-space-mono shrink-0">
                      {leader.role}
                    </span>
                  </div>
                  <div class="text-[11px] font-space-mono text-slate-400 mt-0.5">{leader.major}</div>
                  <div class="text-xs text-slate-400 mt-1 leading-snug">{leader.duty}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Official University Community Coordinator Box (From Screenshot) -->
        <div class="mt-6 pt-4 border-t border-white/10 flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <div class="text-[11px] font-space-mono">
            <span class="text-slate-300 block font-semibold">Community Coordinators:</span>
            <a href="mailto:community@constructor.university" class="text-slate-400 hover:text-white hover:underline transition">
              community@constructor.university
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
