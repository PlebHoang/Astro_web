---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-black text-slate-400 py-14 relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
      
      <!-- Brand & University Location -->
      <div class="space-y-3">
        <a href="#" class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-white/5 border border-white/20 flex items-center justify-center text-white">
            <svg class="w-3.5 h-3.5 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M12 2v3m0 14v3M2 12h3m14 0h3"></path>
            </svg>
          </div>
          <div>
            <span class="block text-xs font-bold tracking-wider text-white font-orbitron uppercase">CUB ASTRO SOC</span>
            <span class="block text-[9px] text-slate-500 font-space-mono">Constructor University</span>
          </div>
        </a>

        <p class="text-xs text-slate-400 font-inter leading-relaxed">
          Official Student Astronomy Society of Constructor University Bremen.
        </p>

        <div class="text-[10px] font-space-mono text-slate-400 flex items-center gap-1.5">
          <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Campus Green • 53.1672° N, 8.6534° E</span>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-[11px] font-space-mono uppercase text-white font-semibold mb-3">Navigation</h4>
        <ul class="space-y-2 text-xs font-inter">
          <li><a href="#about-leadership" class="hover:text-white transition">About Us</a></li>
          <li><a href="#leaders" class="hover:text-white transition">Club Leaders</a></li>
          <li><a href="#events-gallery" class="hover:text-white transition">Event Highlights</a></li>
          <li><a href={`${import.meta.env.BASE_URL}telescope-lab`.replace(/\/+/g, '/')} class="hover:text-white transition text-white font-medium">Telescope Lab ↗</a></li>
          <li><a href="#events" class="hover:text-white transition">Events & Calendar</a></li>
          <li><a href="#register" class="hover:text-white transition">Membership Registration</a></li>
        </ul>
      </div>

      <!-- University Portal Links -->
      <div>
        <h4 class="text-[11px] font-space-mono uppercase text-white font-semibold mb-3">University Hub</h4>
        <ul class="space-y-2 text-xs font-inter text-slate-400">
          <li>
            <a href="https://constructor.university" target="_blank" rel="noopener noreferrer" class="hover:text-white transition">
              Constructor University Bremen ↗
            </a>
          </li>
          <li>Campus Ring 1, 28759 Bremen, Germany</li>
          <li class="pt-1">
            <span class="text-slate-300 block">Community Coordinators:</span>
            <a href="mailto:community@constructor.university" class="text-slate-300 hover:text-white hover:underline">
              community@constructor.university
            </a>
          </li>
        </ul>
      </div>

      <!-- Social Dispatch -->
      <div>
        <h4 class="text-[11px] font-space-mono uppercase text-white font-semibold mb-3">Instagram Dispatches</h4>
        <div class="space-y-2.5 text-xs font-space-mono">
          <a
            href="https://www.instagram.com/astronomy.cub/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-slate-300 hover:text-white transition"
          >
            <svg class="w-3.5 h-3.5 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>@astronomy.cub</span>
          </a>

          <a
            href="https://www.instagram.com/cubastrosoc/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-slate-300 hover:text-white transition"
          >
            <svg class="w-3.5 h-3.5 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>@cubastrosoc</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-[10px] font-space-mono text-slate-500">
      <p>© {year} Constructor University Astronomical Society. All student rights reserved.</p>
      <div class="flex items-center gap-3">
        <a href="https://constructor.university" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300">University Main Site</a>
        <span>•</span>
        <a href="#main-nav" class="text-slate-400 hover:text-white transition">Back to Top ↑</a>
      </div>
    </div>
  </div>
</footer>
