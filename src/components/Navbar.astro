---
const navLinks = [
  { name: "About Us", href: "#about-leadership" },
  { name: "Leaders", href: "#leaders" },
  { name: "Event Highlights", href: "#events-gallery" },
  { name: "Events Calendar", href: "#events" },
  { name: "Join Us", href: "#register" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 px-3 sm:px-6 py-3" id="main-nav">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 py-2.5 rounded-xl bg-black/85 border border-white/10 backdrop-blur-xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.9)]">
    <!-- Left: Brand + University Return Badge -->
    <div class="flex items-center gap-3">
      <a href="#" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/20 flex items-center justify-center text-white group-hover:border-white transition">
          <svg class="w-4 h-4 text-slate-200 transition-transform group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M12 2v3m0 14v3M2 12h3m14 0h3"></path>
          </svg>
        </div>
        <div>
          <span class="block text-xs font-bold tracking-wider text-white font-orbitron uppercase">CUB ASTRO</span>
          <span class="block text-[9px] text-slate-400 font-space-mono tracking-wider">Constructor Univ.</span>
        </div>
      </a>

      <!-- University Return Link (Matches University Template Requirement) -->
      <a
        href="https://constructor.university"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-[10px] font-space-mono text-slate-300 transition hover:text-white"
        title="Return to main university site"
      >
        <span>← University Hub</span>
      </a>
    </div>

    <!-- Center: Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1 bg-white/[0.02] border border-white/[0.06] px-3 py-1 rounded-full">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3 py-1 text-xs font-medium text-slate-300 hover:text-white hover:bg-white/10 rounded-full transition duration-200"
        >
          {link.name}
        </a>
      ))}
    </nav>

    <!-- Right: Stargaze Action + Instagram Link -->
    <div class="flex items-center gap-2.5">
      <!-- Stargaze Mode Toggle Button (Apple-like Frosted Glass Navpill, Non-Colliding) -->
      <button
        type="button"
        id="nav-stargaze-btn"
        class="inline-flex items-center gap-1.5 sm:gap-2.5 px-3 sm:px-4 py-1.5 text-xs font-bold text-white bg-white/[0.08] hover:bg-white/[0.18] active:bg-white/[0.25] border border-white/20 hover:border-white/40 rounded-xl shadow-[inset_0_1px_0_rgba(255,255,255,0.2),0_8px_20px_-4px_rgba(0,0,0,0.5)] backdrop-blur-xl transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-[1.03] active:scale-[0.96] font-orbitron cursor-pointer group"
        title="Toggle Stargaze Simulation Mode (Hotkey: TAB)"
      >
        <svg class="w-3.5 h-3.5 text-slate-200 transition-transform duration-300 group-hover:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v4m0 12v4M2 12h4m12 0h4"></path>
        </svg>
        <span class="tracking-wide">
          <span class="sm:hidden">Stargaze</span>
          <span class="hidden sm:inline">Stargaze Mode</span>
        </span>
        <kbd class="hidden sm:inline-block text-[9px] font-space-mono bg-white/10 group-hover:bg-white/20 px-1.5 py-0.5 rounded-md text-slate-200 border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.25),0_1px_2px_rgba(0,0,0,0.5)]">TAB</kbd>
      </button>

      <!-- Theme Toggle: Monochrome (Default) / Star Wars Mode (Hotkey: T) -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 text-xs font-semibold text-slate-200 hover:text-white bg-white/5 hover:bg-white/10 border border-white/15 rounded-xl transition cursor-pointer font-space-mono text-[11px] active:scale-95"
        title="Toggle Theme: Monochrome / Star Wars Mode (Hotkey: T)"
      >
        <span id="theme-toggle-dot" class="w-2 h-2 rounded-full bg-white transition-colors"></span>
        <span id="theme-toggle-label" class="inline text-[10px] sm:text-xs">Monochrome</span>
        <kbd class="hidden sm:inline-block text-[9px] font-space-mono bg-white/10 px-1.5 py-0.5 rounded text-slate-300 border border-white/15">T</kbd>
      </button>

      <!-- Instagram Join (Monochrome) -->
      <a
        href="https://www.instagram.com/astronomy.cub/"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-black bg-white hover:bg-slate-200 rounded-lg shadow-sm transition hover:scale-105 font-orbitron"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <span>@astronomy.cub</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="nav-mobile-btn"
        class="lg:hidden p-1.5 rounded-lg text-slate-300 hover:text-white bg-white/5 border border-white/10"
        aria-label="Toggle Navigation"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="nav-mobile-menu" class="hidden lg:hidden mt-2 p-4 rounded-xl bg-black/95 border border-white/10 backdrop-blur-2xl flex flex-col gap-2">
    <a
      href={`${import.meta.env.BASE_URL}telescope-lab`.replace(/\/+/g, '/')}
      class="mobile-link px-3 py-2 text-sm font-bold text-white bg-white/10 hover:bg-white/20 rounded-lg transition font-orbitron flex items-center gap-2"
    >
      <svg class="w-4 h-4 text-slate-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v4m0 12v4M2 12h4m12 0h4"></path>
      </svg>
      <span>Telescope Lab</span>
    </a>
    <!-- Mobile Theme Toggle -->
    <button
      type="button"
      id="mobile-theme-toggle-btn"
      class="px-3 py-2 text-sm font-space-mono text-slate-200 hover:text-white hover:bg-white/5 rounded-lg transition flex items-center justify-between text-left cursor-pointer"
    >
      <span class="flex items-center gap-2">
        <span id="mobile-theme-dot" class="w-2 h-2 rounded-full bg-white transition-colors"></span>
        <span>Theme: <strong id="mobile-theme-label">Monochrome</strong></span>
      </span>
      <span class="text-[10px] text-slate-400 font-mono">[T]</span>
    </button>
    <a href="https://constructor.university" target="_blank" rel="noopener noreferrer" class="px-3 py-2 text-xs font-space-mono text-slate-300 hover:bg-white/5 rounded-lg">
      ← Return to Main University Site
    </a>
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-link px-3 py-2 text-sm text-slate-200 hover:text-white hover:bg-white/5 rounded-lg transition"
      >
        {link.name}
      </a>
    ))}
  </div>
</header>

<script>
  // Ponytail Clean Audio Engine (Zero clipping, de-clicked attack envelope, pre-baked noise buffer)
  class AudioEngine {
    private ctx: AudioContext | null = null;
    private noiseBuffer: AudioBuffer | null = null;

    init() {
      if (!this.ctx) {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        this.ctx = new AC();
      }
      if (this.ctx.state === "suspended") {
        this.ctx.resume();
      }
      if (!this.noiseBuffer && this.ctx) {
        const bufLen = Math.floor(this.ctx.sampleRate * 1.2);
        this.noiseBuffer = this.ctx.createBuffer(1, bufLen, this.ctx.sampleRate);
        const data = this.noiseBuffer.getChannelData(0);
        for (let i = 0; i < bufLen; i++) {
          data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (this.ctx.sampleRate * 0.4));
        }
      }
    }

    playWarpSound() {
      try {
        this.init();
        if (!this.ctx) return;
        const t = this.ctx.currentTime + 0.02;

        const master = this.ctx.createGain();
        master.gain.setValueAtTime(0.0001, t);
        master.gain.exponentialRampToValueAtTime(0.32, t + 0.025);
        master.gain.exponentialRampToValueAtTime(0.0001, t + 1.25);
        master.connect(this.ctx.destination);

        const sub = this.ctx.createOscillator();
        const subGain = this.ctx.createGain();
        sub.type = "sine";
        sub.frequency.setValueAtTime(85, t);
        sub.frequency.exponentialRampToValueAtTime(48, t + 1.1);

        subGain.gain.setValueAtTime(0.0001, t);
        subGain.gain.exponentialRampToValueAtTime(0.55, t + 0.03);
        subGain.gain.exponentialRampToValueAtTime(0.0001, t + 1.15);

        sub.connect(subGain);
        subGain.connect(master);
        sub.start(t);
        sub.stop(t + 1.2);

        if (this.noiseBuffer) {
          const noise = this.ctx.createBufferSource();
          noise.buffer = this.noiseBuffer;

          const filter = this.ctx.createBiquadFilter();
          filter.type = "lowpass";
          filter.frequency.setValueAtTime(320, t);
          filter.frequency.exponentialRampToValueAtTime(70, t + 1.1);

          const noiseGain = this.ctx.createGain();
          noiseGain.gain.setValueAtTime(0.0001, t);
          noiseGain.gain.exponentialRampToValueAtTime(0.35, t + 0.03);
          noiseGain.gain.exponentialRampToValueAtTime(0.0001, t + 1.15);

          noise.connect(filter);
          filter.connect(noiseGain);
          noiseGain.connect(master);
          noise.start(t);
          noise.stop(t + 1.2);
        }
      } catch {}
    }
  }

  const audio = new AudioEngine();

  const mobileBtn = document.getElementById("nav-mobile-btn");
  const mobileMenu = document.getElementById("nav-mobile-menu");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  mobileBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
  });

  mobileLinks.forEach(l => {
    l.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
    });
  });

  const navStargazeBtn = document.getElementById("nav-stargaze-btn");

  navStargazeBtn?.addEventListener("click", (e) => {
    if (document.getElementById("web-overlay")) {
      e.preventDefault();
      e.stopPropagation();
      window.dispatchEvent(new CustomEvent("toggle-stargaze"));
    } else {
      window.location.href = "/telescope-lab";
    }
  });

  const themeBtn = document.getElementById("theme-toggle-btn");
  const themeDot = document.getElementById("theme-toggle-dot");
  const themeLabel = document.getElementById("theme-toggle-label");
  const mobileThemeBtn = document.getElementById("mobile-theme-toggle-btn");
  const mobileThemeDot = document.getElementById("mobile-theme-dot");
  const mobileThemeLabel = document.getElementById("mobile-theme-label");

  function applyTheme(isStarWars: boolean, playAudio = false) {
    document.documentElement.classList.toggle("theme-starwars", isStarWars);
    const dotClass = isStarWars ? "w-2 h-2 rounded-full transition-colors bg-[#C084FC] shadow-[0_0_10px_#C084FC]" : "w-2 h-2 rounded-full transition-colors bg-white";
    const labelText = isStarWars ? "Star Wars" : "Monochrome";

    if (themeDot) themeDot.className = dotClass;
    if (themeLabel) themeLabel.textContent = labelText;
    if (mobileThemeDot) mobileThemeDot.className = dotClass;
    if (mobileThemeLabel) mobileThemeLabel.textContent = labelText;

    try { localStorage.setItem("cub_theme", isStarWars ? "starwars" : "monochrome"); } catch {}

    if (playAudio) {
      audio.playWarpSound();
      window.dispatchEvent(new CustomEvent("cub:hyperspace-warp", { detail: { isStarWars } }));
    }
  }

  try {
    applyTheme(localStorage.getItem("cub_theme") === "starwars", false);
  } catch {
    applyTheme(false, false);
  }

  function toggleTheme() {
    const next = !document.documentElement.classList.contains("theme-starwars");
    applyTheme(next, true);
  }

  themeBtn?.addEventListener("click", toggleTheme);
  mobileThemeBtn?.addEventListener("click", toggleTheme);
</script>
