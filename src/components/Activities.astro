---
const activities = [
  {
    id: "stargazing",
    title: "Campus Green Stargazing Sessions",
    tag: "Flagship Event",
    time: "Every Clear Night • Usually 21:00 - Late",
    badgeColor: "bg-purple-500/20 text-purple-300 border-purple-500/30",
    gradient: "from-purple-900/40 via-purple-950/20 to-transparent",
    description: "Whenever the Bremen skies clear, our alerts ring. We set up our high-powered Dobsonian reflector on the grass, aim at planetary wonders like Jupiter's Great Red Spot or Saturn's ring planes, and invite everyone passing by to take a look.",
    highlights: ["Moon craters at 150x magnification", "Planetary alignment tracking", "Free warm beverages & blankets"]
  },
  {
    id: "movie",
    title: "Cosmic Cinema & Documentary Nights",
    tag: "Bi-Weekly",
    time: "Thursday Evenings • Campus Hall / Common Room",
    badgeColor: "bg-blue-500/20 text-blue-300 border-blue-500/30",
    gradient: "from-blue-900/40 via-blue-950/20 to-transparent",
    description: "Cloudy outside? We gather indoors for curated screenings of astrophysics masterpieces, James Webb Space Telescope deep-dives, and sci-fi epics, followed by lively debates about spacetime, exoplanets, and Fermi's paradox.",
    highlights: ["Popcorn, tea & relaxed atmosphere", "Post-film physics discussion", "Voting on the next movie title"]
  },
  {
    id: "astrophoto",
    title: "Astrophotography & Solar Imaging",
    tag: "Hands-on Workshop",
    time: "Monthly Sessions + Daytime Solar Spotting",
    badgeColor: "bg-pink-500/20 text-pink-300 border-pink-500/30",
    gradient: "from-pink-900/40 via-pink-950/20 to-transparent",
    description: "Learn how to capture stunning star trails and nebula color bands with the gear in your pocket or club cameras. We teach stacking software (Siril, DeepSkyStacker) and daytime safe solar telescope photography.",
    highlights: ["Smartphone telescope eyepiece mounts", "Deep-sky stacking tutorials", "Direct sunspot observation filters"]
  },
  {
    id: "expeditions",
    title: "Meteor Shower Watch & Dark Sky Trips",
    tag: "Special Trips",
    time: "Peak Meteor Showers (Perseids, Geminids, Lyrids)",
    badgeColor: "bg-emerald-500/20 text-emerald-300 border-emerald-500/30",
    gradient: "from-emerald-900/40 via-emerald-950/20 to-transparent",
    description: "To escape even Bremen-Nord's suburban glow, we organize group excursions to ultra-dark nature reserves like Teufelsmoor and Lower Saxony countryside during meteor shower peaks and comet flybys.",
    highlights: ["100+ shooting stars per hour", "Camping & campfire stargazing", "All-night cosmic photography"]
  }
];
---

<section id="activities" class="py-24 relative overflow-hidden bg-gradient-to-b from-transparent via-purple-950/10 to-transparent">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 reveal">
      <div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-300 text-xs font-semibold uppercase tracking-wider mb-4">
          What We Do Together
        </div>
        <h2 class="text-3xl sm:text-5xl font-bold font-display text-white tracking-tight">
          Club Activities & Experiences
        </h2>
      </div>
      <p class="mt-4 md:mt-0 text-slate-400 text-sm sm:text-base max-w-md">
        Designed to inspire curiosity, forge lifelong friendships, and make the vast mysteries of space feel right at home.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {activities.map((act, idx) => (
        <div class={`card-glow p-8 flex flex-col justify-between reveal reveal-delay-${(idx % 2) + 1} group relative overflow-hidden`}>
          <div class={`absolute inset-0 bg-gradient-to-br ${act.gradient} opacity-40 group-hover:opacity-70 transition duration-500 pointer-events-none`}></div>

          <div class="relative z-10">
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class={`px-3 py-1 rounded-full text-xs font-medium border ${act.badgeColor}`}>
                {act.tag}
              </span>
              <span class="text-xs font-mono text-slate-400">
                {act.time}
              </span>
            </div>

            <h3 class="text-2xl font-bold text-white font-display mb-3 group-hover:text-purple-300 transition">
              {act.title}
            </h3>

            <p class="text-slate-300 text-sm leading-relaxed mb-6">
              {act.description}
            </p>

            <!-- Highlights Checklist -->
            <div class="space-y-2 mb-8 pt-4 border-t border-white/5">
              {act.highlights.map(h => (
                <div class="flex items-center gap-2.5 text-xs text-slate-300">
                  <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>{h}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="relative z-10 pt-4 border-t border-white/10 flex items-center justify-between">
            <a
              href="https://www.instagram.com/astronomy.cub/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-semibold text-purple-300 group-hover:text-white flex items-center gap-1.5 transition"
            >
              <span>See past session reels</span>
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>

            <a
              href="#events"
              class="text-xs px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 transition"
            >
              Check Dates
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
